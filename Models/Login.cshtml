@page
@model Kirkenta.Pages.Auth.LoginModel
@{
    Layout = "_Layout";
}

<h2>Login</h2>

<form method="post">
    <div>
        <label>Usuario</label>
        <input asp-for="Username" />
    </div>
    <div>
        <label>Contraseña</label>
        <input asp-for="Password" type="password" />
    </div>
    <button type="submit">Ingresar</button>
</form>

<span asp-validation-summary="All"></span>
