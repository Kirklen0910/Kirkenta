<Project Sdk="Microsoft.NET.Sdk">

  <!-- Herramienta del EMISOR de licencias. NO se entrega a los clientes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Licenciador</AssemblyName>
    <RootNamespace>Licenciador</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Comparte el formato de la licencia con el sistema (mismo archivo, no una copia) -->
    <Compile Include="..\..\Services\Licencia\LicenciaFormato.cs" Link="LicenciaFormato.cs" />
  </ItemGroup>

</Project>
