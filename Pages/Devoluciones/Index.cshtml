@page
@model Kirkenta.Pages.Devoluciones.IndexModel
@{
    ViewData["Title"] = "Devoluciones";
}

<div class="module-header">
    <div class="module-header-left">
        <h2>Devoluciones</h2>
        <p>Notas de crédito y devoluciones de clientes</p>
    </div>
    <div class="module-header-right">
        @if (Model.PuedeCrear)
        {
            <a asp-page="/Devoluciones/Create" class="btn-primary">Nueva devolución</a>
        }
    </div>
</div>

<div class="module-card">
    @if (TempData["Error"] != null)
    {
        <div class="module-alert module-alert-error">@TempData["Error"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="module-alert module-alert-success">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            @TempData["Success"]
        </div>
    }

    <form method="get" style="display:flex;gap:8px;margin-bottom:12px">
        <input type="text" name="Q" value="@Model.Q" placeholder="Buscar por devolución, venta, factura o cliente..." style="flex:1" />
        <button type="submit" class="btn-primary">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(Model.Q)) { <a asp-page="/Devoluciones/Index" class="btn-secondary">Limpiar</a> }
    </form>

    @if (Model.Pager.Total == 0)
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="1 4 1 10 7 10"/>
                <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
            </svg>
            <h3>No hay devoluciones</h3>
            <p>Las devoluciones se registran desde el detalle de una venta o con el botón "Nueva devolución"</p>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="erp-table">
                <thead>
                    <tr>
                        <th>Número</th>
                        <th>Cliente</th>
                        <th>Venta</th>
                        <th>Factura</th>
                        <th>Fecha</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Devoluciones)
                    {
                        var cliente = Model.Clientes.FirstOrDefault(c => c.Id == d.ClienteId);
                        var ventaDev = d.VentaId.HasValue ? Model.Ventas.FirstOrDefault(v => v.Id == d.VentaId.Value) : null;
                        var factura = d.FacturaId.HasValue ? Model.Facturas.FirstOrDefault(f => f.Id == d.FacturaId.Value) : null;
                        <tr>
                            <td><strong>@d.Numero</strong></td>
                            <td>@(cliente?.Nombre ?? "—")</td>
                            <td>@(ventaDev?.Numero ?? "—")</td>
                            <td>@(factura?.Numero ?? "—")</td>
                            <td>@d.Fecha.ToString("dd/MM/yyyy")</td>
                            <td><strong>L. @d.Total.ToString("N2")</strong></td>
                            <td><span class="badge badge-success">@d.Estado</span></td>
                            <td><a asp-page="/Devoluciones/Details" asp-route-id="@d.Id" class="btn-secondary">Ver</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="Model.Pager" />
    }
</div>