@page
@model Kirkenta.Pages.Logistica.Tracking.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Tracking de envío";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kirkenta ERP</title>
    <link rel="icon" type="image/png" href="~/favicon.png?v=@DateTime.Now.Ticks" />
    <link rel="apple-touch-icon" href="~/favicon.png" />
    <link rel="shortcut icon" type="image/png" href="~/favicon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css?v=@DateTime.Now.Ticks" />
    <style>
        body.tracking-body {
            background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 50%, #f5f3ff 100%);
            min-height: 100vh;
            padding: 40px 20px;
            font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        }
        .tracking-wrapper {
            max-width: 900px;
            margin: 0 auto;
        }
        .tracking-header {
            text-align: center;
            margin-bottom: 40px;
        }
        .tracking-logo {
            width: 80px;
            height: 80px;
            object-fit: contain;
            margin-bottom: 16px;
            filter: drop-shadow(0 4px 12px rgba(79, 70, 229, 0.15));
        }
        .tracking-title {
            font-size: 32px;
            font-weight: 800;
            color: #1f2937;
            margin-bottom: 8px;
            letter-spacing: -0.02em;
        }
        .tracking-subtitle {
            font-size: 15px;
            color: #6b7280;
            margin: 0;
        }
        .tracking-search-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 32px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
            margin-bottom: 24px;
        }
        .tracking-search-form {
            display: flex;
            gap: 12px;
            align-items: stretch;
        }
        @@media (max-width: 600px) {
            .tracking-search-form {
                flex-direction: column;
            }
        }
        .tracking-input {
            flex: 1;
            font-size: 16px;
            padding: 14px 18px;
            border: 2px solid #e5e7eb;
            border-radius: 10px;
            transition: all 0.2s;
            font-family: monospace;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }
        .tracking-input:focus {
            outline: none;
            border-color: #4f46e5;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }
        .tracking-btn {
            padding: 14px 32px;
            background: #4f46e5;
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
            white-space: nowrap;
        }
        .tracking-btn:hover {
            background: #4338ca;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(79, 70, 229, 0.3);
        }
        .tracking-hint {
            font-size: 13px;
            color: #9ca3af;
            margin-top: 12px;
            text-align: center;
        }
        .tracking-result-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 32px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
            margin-bottom: 24px;
        }
        .tracking-result-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 16px;
            padding-bottom: 20px;
            border-bottom: 1px solid #e5e7eb;
            margin-bottom: 24px;
        }
        .tracking-code {
            font-family: monospace;
            font-size: 24px;
            font-weight: 800;
            color: #4f46e5;
            letter-spacing: 0.05em;
        }
        .tracking-estado-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }
        .estado-borrador { background: #fef3c7; color: #92400e; }
        .estado-enreparto { background: #dbeafe; color: #1e40af; }
        .estado-completada { background: #d1fae5; color: #065f46; }
        .estado-cancelada { background: #fee2e2; color: #991b1b; }

        .tracking-kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }
        .tracking-kpi {
            background: #f9fafb;
            border-radius: 10px;
            padding: 16px;
            text-align: center;
        }
        .tracking-kpi-label {
            display: block;
            font-size: 11.5px;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 600;
            margin-bottom: 6px;
        }
        .tracking-kpi-value {
            display: block;
            font-size: 18px;
            font-weight: 800;
            color: #1f2937;
        }

        .tracking-info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }
        @@media (max-width: 700px) {
            .tracking-info-grid {
                grid-template-columns: 1fr;
            }
        }
        .tracking-info-item {
            padding: 12px 0;
        }
        .tracking-info-label {
            display: block;
            font-size: 12px;
            font-weight: 700;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 4px;
        }
        .tracking-info-value {
            font-size: 14.5px;
            color: #1f2937;
        }

        .tracking-progress-wrapper {
            margin-bottom: 24px;
        }
        .tracking-progress-label {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            font-weight: 700;
            color: #4f46e5;
            margin-bottom: 8px;
        }
        .tracking-progress-track {
            height: 12px;
            background: #e5e7eb;
            border-radius: 6px;
            overflow: hidden;
        }
        .tracking-progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #4f46e5 0%, #6366f1 100%);
            border-radius: 6px;
            transition: width 0.4s ease;
        }

        .tracking-paradas-list {
            margin-top: 24px;
        }
        .tracking-parada-item {
            display: flex;
            gap: 16px;
            padding: 16px;
            background: #f9fafb;
            border-radius: 10px;
            margin-bottom: 10px;
            border-left: 4px solid #e5e7eb;
            transition: all 0.2s;
        }
        .tracking-parada-item.parada-entregado { border-left-color: #10b981; background: #ecfdf5; }
        .tracking-parada-item.parada-fallido { border-left-color: #ef4444; background: #fef2f2; }
        .tracking-parada-item.parada-enruta { border-left-color: #3b82f6; background: #eff6ff; }
        .tracking-parada-item.parada-pendiente { border-left-color: #f59e0b; background: #fffbeb; }

        .tracking-parada-orden {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #fff;
            border: 2px solid #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 15px;
            color: #6b7280;
            flex-shrink: 0;
        }
        .tracking-parada-info {
            flex: 1;
        }
        .tracking-parada-cliente {
            font-weight: 700;
            font-size: 14.5px;
            color: #1f2937;
            margin-bottom: 4px;
        }
        .tracking-parada-dir {
            font-size: 13px;
            color: #6b7280;
            margin-bottom: 6px;
        }
        .tracking-parada-estado {
            display: inline-block;
            font-size: 11.5px;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 12px;
            text-transform: uppercase;
        }

        .tracking-empty {
            background: #ffffff;
            border-radius: 16px;
            padding: 60px 32px;
            text-align: center;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        }
        .tracking-empty-icon {
            font-size: 64px;
            margin-bottom: 16px;
            opacity: 0.4;
        }
        .tracking-empty h3 {
            font-size: 18px;
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 8px;
        }
        .tracking-empty p {
            font-size: 14px;
            color: #6b7280;
            margin: 0;
        }

        .tracking-footer {
            text-align: center;
            margin-top: 40px;
            font-size: 13px;
            color: #9ca3af;
        }

        .tracking-historial {
            margin-top: 32px;
            padding-top: 24px;
            border-top: 1px solid #e5e7eb;
        }
        .tracking-timeline-item {
            display: flex;
            gap: 16px;
            padding: 10px 0;
        }
        .tracking-timeline-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #4f46e5;
            flex-shrink: 0;
            margin-top: 5px;
        }
        .tracking-timeline-content {
            flex: 1;
            font-size: 13.5px;
        }
        .tracking-timeline-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 2px;
        }
        .tracking-timeline-header strong {
            color: #1f2937;
        }
        .tracking-timeline-header span {
            color: #9ca3af;
            font-size: 12px;
        }
        .tracking-timeline-detail {
            color: #6b7280;
            margin: 0;
            font-size: 13px;
        }
    </style>
</head>
<body class="tracking-body">
    <div class="tracking-wrapper">

        <!-- HEADER -->
        <div class="tracking-header">
            <img src="~/images/logo.png" alt="Kirkenta ERP" class="tracking-logo" />
            <h1 class="tracking-title">Rastrear mi envío</h1>
            <p class="tracking-subtitle">Ingresa tu código de tracking para ver el estado de tu entrega</p>
        </div>

        <!-- BUSCADOR -->
        <div class="tracking-search-card">
            <form method="get" class="tracking-search-form">
                <input type="text"
                       name="codigo"
                       value="@Model.CodigoBuscado"
                       class="tracking-input"
                       placeholder="KRT-2026-AB12X9"
                       autocomplete="off"
                       autofocus />
                <button type="submit" class="tracking-btn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 18px; height: 18px;">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    Rastrear
                </button>
            </form>
            <p class="tracking-hint">
                💡 El código aparece en tu factura o confirmación de compra (formato: KRT-YYYY-XXXXXX)
            </p>
        </div>

        <!-- ERROR -->
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="tracking-empty">
                <div class="tracking-empty-icon">🔍</div>
                <h3>No encontramos tu envío</h3>
                <p>@Model.Error</p>
            </div>
        }

        <!-- RESULTADO -->
        @if (Model.Ruta != null)
        {
            var ruta = Model.Ruta;
            var badgeClass = ruta.Estado switch
            {
                "Borrador" => "estado-borrador",
                "EnReparto" => "estado-enreparto",
                "Completada" => "estado-completada",
                "Cancelada" => "estado-cancelada",
                _ => "estado-borrador"
            };
            var iconoEstado = ruta.Estado switch
            {
                "Borrador" => "📝",
                "EnReparto" => "🚚",
                "Completada" => "✅",
                "Cancelada" => "❌",
                _ => "📦"
            };

            <div class="tracking-result-card">

                <!-- Encabezado con código y estado -->
                <div class="tracking-result-header">
                    <div>
                        <div style="font-size: 12px; color: #6b7280; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px;">
                            Código de tracking
                        </div>
                        <div class="tracking-code">@ruta.TrackingCode</div>
                        <div style="font-size: 12px; color: #9ca3af; margin-top: 4px;">
                            Ruta @ruta.Numero • Creada el @ruta.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                    <div class="tracking-estado-badge @badgeClass">
                        <span>@iconoEstado</span>
                        <span>@ruta.Estado</span>
                    </div>
                </div>

                <!-- KPIs -->
                <div class="tracking-kpi-grid">
                    <div class="tracking-kpi">
                        <span class="tracking-kpi-label">Total paradas</span>
                        <span class="tracking-kpi-value">@Model.TotalParadas</span>
                    </div>
                    <div class="tracking-kpi">
                        <span class="tracking-kpi-label">Entregadas</span>
                        <span class="tracking-kpi-value" style="color: #10b981;">@Model.ParadasEntregadas</span>
                    </div>
                    <div class="tracking-kpi">
                        <span class="tracking-kpi-label">Pendientes</span>
                        <span class="tracking-kpi-value" style="color: #f59e0b;">@Model.ParadasPendientes</span>
                    </div>
                    <div class="tracking-kpi">
                        <span class="tracking-kpi-label">Fecha estimada</span>
                        <span class="tracking-kpi-value" style="font-size: 14px;">
                            @(ruta.FechaSalida.HasValue
                                ? ruta.FechaSalida.Value.ToString("dd/MM/yyyy")
                                : (Model.FechaEstimada?.ToString("dd/MM/yyyy") ?? "Por confirmar"))
                        </span>
                    </div>
                </div>

                <!-- Progreso -->
                <div class="tracking-progress-wrapper">
                    <div class="tracking-progress-label">
                        <span>Progreso de la ruta</span>
                        <span>@Model.Progreso%</span>
                    </div>
                    <div class="tracking-progress-track">
                        <div class="tracking-progress-fill" style="width: @Model.Progreso%;"></div>
                    </div>
                </div>

                <!-- Info del repartidor -->
                @if (!string.IsNullOrEmpty(ruta.RepartidorNombre))
                {
                    <div class="tracking-info-grid">
                        <div class="tracking-info-item">
                            <span class="tracking-info-label">Repartidor</span>
                            <span class="tracking-info-value">👤 @ruta.RepartidorNombre</span>
                        </div>
                        @if (!string.IsNullOrEmpty(ruta.Vehiculo))
                        {
                            <div class="tracking-info-item">
                                <span class="tracking-info-label">Vehículo</span>
                                <span class="tracking-info-value">🚗 @ruta.Vehiculo @(string.IsNullOrEmpty(ruta.Placa) ? "" : $"({ruta.Placa})")</span>
                            </div>
                        }
                    </div>
                }

                <!-- Descripción / notas -->
                @if (!string.IsNullOrEmpty(ruta.Descripcion))
                {
                    <div class="tracking-info-item">
                        <span class="tracking-info-label">Descripción</span>
                        <span class="tracking-info-value">@ruta.Descripcion</span>
                    </div>
                }

                <!-- Listado de paradas -->
                <div class="tracking-paradas-list">
                    <h3 style="font-size: 15px; font-weight: 800; color: #1f2937; margin-bottom: 16px; text-transform: uppercase; letter-spacing: 0.03em;">
                        📍 Paradas de la ruta
                    </h3>

                    @foreach (var p in Model.Paradas)
                    {
                        var claseEstado = p.Estado switch
                        {
                            "Entregado" => "parada-entregado",
                            "Fallido" => "parada-fallido",
                            "EnRuta" => "parada-enruta",
                            _ => "parada-pendiente"
                        };
                        var iconoParada = p.Estado switch
                        {
                            "Entregado" => "✓ Entregado",
                            "Fallido" => "✗ Fallido",
                            "EnRuta" => "🚚 En ruta",
                            _ => "⏳ Pendiente"
                        };
                        var colorEstado = p.Estado switch
                        {
                            "Entregado" => "#065f46",
                            "Fallido" => "#991b1b",
                            "EnRuta" => "#1e40af",
                            _ => "#92400e"
                        };
                        var bgEstado = p.Estado switch
                        {
                            "Entregado" => "#d1fae5",
                            "Fallido" => "#fee2e2",
                            "EnRuta" => "#dbeafe",
                            _ => "#fef3c7"
                        };

                        <div class="tracking-parada-item @claseEstado">
                            <div class="tracking-parada-orden">@p.OrdenParada</div>
                            <div class="tracking-parada-info">
                                <div class="tracking-parada-cliente">@p.ClienteNombre</div>
                                <div class="tracking-parada-dir">📍 @p.DireccionEntrega</div>
                                @if (!string.IsNullOrEmpty(p.Ciudad))
                                {
                                    <div class="tracking-parada-dir" style="font-size: 12px;">@p.Ciudad</div>
                                }
                                @if (!string.IsNullOrEmpty(p.Referencia))
                                {
                                    <div class="tracking-parada-dir" style="font-size: 12px;">📌 @p.Referencia</div>
                                }
                                <div style="margin-top: 8px; display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                                    <span class="tracking-parada-estado" style="background: @bgEstado; color: @colorEstado;">
                                        @iconoParada
                                    </span>
                                    @if (p.Estado == "Entregado" && !string.IsNullOrEmpty(p.NombreRecibio))
                                    {
                                        <span style="font-size: 12px; color: #6b7280;">Recibió: <strong>@p.NombreRecibio</strong></span>
                                    }
                                    @if (p.Estado == "Fallido" && !string.IsNullOrEmpty(p.MotivoFallo))
                                    {
                                        <span style="font-size: 12px; color: #991b1b;">@p.MotivoFallo</span>
                                    }
                                    @if (p.FechaEntregaEstimada.HasValue && p.Estado != "Entregado")
                                    {
                                        <span style="font-size: 12px; color: #6b7280;">Est: @p.FechaEntregaEstimada.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Historial de eventos -->
                @if (Model.Historial.Count > 0)
                {
                    <div class="tracking-historial">
                        <h3 style="font-size: 15px; font-weight: 800; color: #1f2937; margin-bottom: 16px; text-transform: uppercase; letter-spacing: 0.03em;">
                            🕐 Historial de eventos
                        </h3>
                        @foreach (var h in Model.Historial)
                        {
                            var colorDot = h.Evento switch
                            {
                                "RutaCreada" => "#4f46e5",
                                "Despachada" => "#3b82f6",
                                "Entregado" => "#10b981",
                                "Fallido" => "#ef4444",
                                "Completada" => "#10b981",
                                "Cancelada" => "#ef4444",
                                _ => "#6b7280"
                            };
                            <div class="tracking-timeline-item">
                                <div class="tracking-timeline-dot" style="background: @colorDot;"></div>
                                <div class="tracking-timeline-content">
                                    <div class="tracking-timeline-header">
                                        <strong>@h.Evento</strong>
                                        <span>@h.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(h.Detalle))
                                    {
                                        <p class="tracking-timeline-detail">@h.Detalle</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <!-- FOOTER -->
        <div class="tracking-footer">
            <p>&copy; 2026 Kirkenta ERP — Todos los derechos reservados</p>
        </div>

    </div>
</body>
</html>