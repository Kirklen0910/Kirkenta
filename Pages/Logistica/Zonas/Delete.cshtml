@page "{id:int}"
@model Kirkenta.Pages.Logistica.Zonas.DeleteModel
@{
    ViewData["Title"] = "Eliminar zona de envío";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/Logistica/Zonas/Index" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Volver a zonas
        </a>
        <h2>Eliminar zona</h2>
        <p>Esta acción no se puede deshacer</p>
    </div>
</div>

@if (!Model.PuedeEliminar)
{
    <div class="module-card danger-card">
        <div class="danger-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
        </div>

        <h3>No se puede eliminar</h3>
        <p>La zona <strong>@Model.Zona.Nombre</strong> tiene <strong>@Model.EnviosAsociados envío(s)</strong> asociado(s).</p>

        <p style="color: var(--color-muted); font-size: 13px; margin-top: 12px;">
            <strong>Recomendación:</strong> en lugar de eliminar, <strong>desactívala</strong> desde la opción Editar. Seguirá visible para los envíos antiguos pero no aparecerá al crear nuevos.
        </p>

        <div class="form-actions" style="justify-content: center;">
            <a asp-page="/Logistica/Zonas/Index" class="btn-secondary">Volver al listado</a>
            <a asp-page="/Logistica/Zonas/Edit" asp-route-id="@Model.Zona.Id" class="btn-primary">Ir a Editar</a>
        </div>
    </div>
}
else
{
    <div class="module-card danger-card">
        <div class="danger-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
        </div>

        <h3>¿Eliminar la zona "@Model.Zona.Nombre"?</h3>
        <p>Los envíos nuevos ya no podrán clasificarse en esta zona.</p>

        <div class="user-preview">
            <div style="width: 40px; height: 40px; border-radius: 10px; background: @Model.Zona.Color;"></div>
            <div>
                <strong>@Model.Zona.Nombre</strong>
                <span>
                    @if (Model.Zona.PrecioSugerido == 0)
                    {
                        <text>Envío gratis</text>
                    }
                    else
                    {
                        <text>L. @Model.Zona.PrecioSugerido.ToString("N2")</text>
                    }
                </span>
            </div>
        </div>

        <form method="post" class="form-actions" style="justify-content: center;">
            <a asp-page="/Logistica/Zonas/Index" class="btn-secondary">Cancelar</a>
            <button type="submit" class="btn-danger">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <polyline points="3 6 5 6 21 6"/>
                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                </svg>
                Sí, eliminar zona
            </button>
        </form>
    </div>
}