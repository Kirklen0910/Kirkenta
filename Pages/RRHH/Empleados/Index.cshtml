@page
@model Kirkenta.Pages.RRHH.Empleados.IndexModel
@{
    ViewData["Title"] = "Empleados";
}

<div class="module-header">
    <div class="module-header-left">
        <h2>Empleados</h2>
        <p>Listado y gestión de empleados de la empresa</p>
    </div>
    <div class="module-header-right">
        @if (Model.PuedeCrear)
        {
            <a asp-page="/RRHH/Empleados/Create" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Nuevo empleado
            </a>
        }
        <a asp-page="/RRHH/Index" class="btn-secondary">Volver a RRHH</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="module-alert module-alert-success">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="module-alert module-alert-error">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        @TempData["Error"]
    </div>
}

<!-- KPIs -->
<div class="kpi-grid" style="margin-bottom: 20px;">
    <div class="kpi-card">
        <span class="kpi-label">Activos</span>
        <span class="kpi-value" style="color: var(--color-success);">@Model.TotalActivos</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Inactivos / Suspendidos</span>
        <span class="kpi-value" style="color: var(--color-muted);">@Model.TotalInactivos</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">En vacaciones</span>
        <span class="kpi-value" style="color: var(--color-primary);">@Model.TotalVacaciones</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Bajas</span>
        <span class="kpi-value" style="color: var(--color-danger);">@Model.TotalBajas</span>
    </div>
</div>

<div class="module-card">
    <div class="module-toolbar">
        <div class="search-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" id="searchInput" placeholder="Buscar por nombre, código, cédula..." />
        </div>
        <div class="filter-group">
            <select id="filterEstado" class="filter-select">
                <option value="">Todos los estados</option>
                <option value="Activo">Activos</option>
                <option value="Inactivo">Inactivos</option>
                <option value="Suspendido">Suspendidos</option>
                <option value="Vacaciones">En vacaciones</option>
                <option value="Licencia">Licencia</option>
                <option value="Baja">Bajas</option>
            </select>
            <select id="filterDepartamento" class="filter-select">
                <option value="">Todos los departamentos</option>
                @foreach (var dep in Model.Empleados.Where(x => !string.IsNullOrEmpty(x.Departamento)).Select(x => x.Departamento).Distinct().OrderBy(x => x))
                {
                    <option value="@dep">@dep</option>
                }
            </select>
        </div>
    </div>

    @if (Model.Empleados.Count == 0)
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
            </svg>
            <h3>No hay empleados registrados</h3>
            <p>Registra tu primer empleado</p>
            <a asp-page="/RRHH/Empleados/Create" class="btn-primary">Nuevo empleado</a>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="erp-table" id="empleadosTable">
                <thead>
                    <tr>
                        <th style="width: 50px;"></th>
                        <th>Código</th>
                        <th>Empleado</th>
                        <th>Puesto</th>
                        <th>Departamento</th>
                        <th>Ingreso</th>
                        <th style="text-align: right;">Salario</th>
                        <th style="text-align: right;">Vacaciones</th>
                        <th>Estado</th>
                        <th style="width: 180px; text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Empleados)
                    {
                        <tr data-nombre="@e.NombreCompleto.ToLower()"
                            data-codigo="@e.Codigo.ToLower()"
                            data-cedula="@e.Cedula.ToLower()"
                            data-estado="@e.Estado"
                            data-departamento="@(e.Departamento?.ToLower() ?? "")">
                            <td>
                                @if (!string.IsNullOrEmpty(e.FotoPath))
                                {
                                    <img src="@e.FotoPath" alt="@e.NombreCompleto" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="user-avatar-sm">@e.NombreCompleto.Substring(0, 1).ToUpper()</div>
                                }
                            </td>
                            <td><span style="font-family: monospace;">@e.Codigo</span></td>
                            <td>
                                <div class="table-user-cell">
                                    <span class="table-user-name">@e.NombreCompleto</span>
                                    <span class="table-user-sub">@e.Cedula</span>
                                </div>
                            </td>
                            <td>@(e.PuestoNombre ?? "—")</td>
                            <td>@(e.Departamento ?? "—")</td>
                            <td>
                                @e.FechaIngreso.ToString("dd/MM/yyyy")
                                <br /><span class="table-user-sub">@e.AniosAntiguedad @(e.AniosAntiguedad == 1 ? "año" : "años")</span>
                            </td>
                            <td style="text-align: right;"><strong>L. @e.SalarioBase.ToString("N2")</strong></td>
                            <td style="text-align: right;">
                                @if (e.DiasVacacionesDisponibles > 0)
                                {
                                    <span class="badge badge-info">@e.DiasVacacionesDisponibles días</span>
                                }
                                else
                                {
                                    <span class="table-user-sub">0 días</span>
                                }
                            </td>
                            <td>
                                @if (e.Estado == "Activo")
                                {
                                    <span class="badge badge-success">Activo</span>
                                }
                                else if (e.Estado == "Vacaciones")
                                {
                                    <span class="badge badge-info">Vacaciones</span>
                                }
                                else if (e.Estado == "Suspendido")
                                {
                                    <span class="badge badge-warning">Suspendido</span>
                                }
                                else if (e.Estado == "Licencia")
                                {
                                    <span class="badge badge-info">Licencia</span>
                                }
                                else if (e.Estado == "Baja")
                                {
                                    <span class="badge badge-danger">Baja</span>
                                }
                                else
                                {
                                    <span class="badge" style="background:#e5e7eb; color:#6b7280;">@e.Estado</span>
                                }
                            </td>
                            <td>
                                <div class="table-actions">
                                    <a asp-page="/RRHH/Empleados/Details" asp-route-id="@e.Id" class="btn-icon-action" title="Ver hoja de vida">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                            <circle cx="12" cy="12" r="3"/>
                                        </svg>
                                    </a>
                                    @if (Model.PuedeEditar)
                                    {
                                        <a asp-page="/RRHH/Empleados/Edit" asp-route-id="@e.Id" class="btn-icon-action" title="Editar">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                            </svg>
                                        </a>
                                    }
                                    @if (Model.PuedeEliminar)
                                    {
                                        <a asp-page="/RRHH/Empleados/Delete" asp-route-id="@e.Id" class="btn-icon-action btn-icon-action-danger" title="Eliminar">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"/>
                                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                            </svg>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var searchInput = document.getElementById('searchInput');
            var filterEstado = document.getElementById('filterEstado');
            var filterDepartamento = document.getElementById('filterDepartamento');
            var table = document.getElementById('empleadosTable');
            if (!table) return;
            var rows = table.querySelectorAll('tbody tr');

            function filterRows() {
                var search = (searchInput?.value || '').toLowerCase().trim();
                var estado = filterEstado?.value || '';
                var departamento = (filterDepartamento?.value || '').toLowerCase();

                rows.forEach(function (row) {
                    var nombre = row.dataset.nombre || '';
                    var codigo = row.dataset.codigo || '';
                    var cedula = row.dataset.cedula || '';
                    var rowEstado = row.dataset.estado || '';
                    var rowDep = row.dataset.departamento || '';

                    var matchSearch = !search || nombre.includes(search) || codigo.includes(search) || cedula.includes(search);
                    var matchEstado = !estado || rowEstado === estado;
                    var matchDep = !departamento || rowDep === departamento;

                    row.style.display = (matchSearch && matchEstado && matchDep) ? '' : 'none';
                });
            }

            searchInput?.addEventListener('input', filterRows);
            filterEstado?.addEventListener('change', filterRows);
            filterDepartamento?.addEventListener('change', filterRows);
        })();
    </script>
}