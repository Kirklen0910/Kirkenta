@page "{id:int}"
@model Kirkenta.Pages.RRHH.Empleados.DetailsModel
@{
    ViewData["Title"] = $"Empleado {Model.Empleado.Codigo}";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/RRHH/Empleados/Index" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Volver a empleados
        </a>
        <h2>@Model.Empleado.Nombres @Model.Empleado.Apellidos</h2>
        <p>
            <span style="font-family: monospace;">@Model.Empleado.Codigo</span>
            • @(Model.Empleado.PuestoNombre ?? "Sin puesto")
            • @Model.AniosAntiguedad @(Model.AniosAntiguedad == 1 ? "año" : "años") de antigüedad
        </p>
    </div>
    <div class="module-header-right">
        @if (Model.PuedeEditar)
        {
            <a asp-page="/RRHH/Empleados/Edit" asp-route-id="@Model.Empleado.Id" class="btn-secondary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                </svg>
                Editar
            </a>
        }
        <button type="button" class="btn-secondary" onclick="window.print()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                <polyline points="6 9 6 2 18 2 18 9"/>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                <rect x="6" y="14" width="12" height="8"/>
            </svg>
            Imprimir
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="module-alert module-alert-success">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="module-alert module-alert-error">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        @TempData["Error"]
    </div>
}

<!-- Layout: Sidebar izquierdo + Contenido con tabs -->
<div class="profile-layout">

    <!-- SIDEBAR IZQUIERDO -->
    <div class="module-card profile-sidebar">
        @if (!string.IsNullOrEmpty(Model.Empleado.FotoPath))
        {
            <img src="@Model.Empleado.FotoPath" alt="@Model.Empleado.Nombres" style="width: 120px; height: 120px; border-radius: 50%; object-fit: cover; border: 4px solid var(--color-primary-soft);" />
        }
        else
        {
            <div class="profile-avatar-big" style="width: 120px; height: 120px; font-size: 42px;">
                @Model.Empleado.Nombres.Substring(0, 1).ToUpper()
            </div>
        }

        <h3>@Model.Empleado.Nombres @Model.Empleado.Apellidos</h3>
        <p class="profile-email">@(Model.Empleado.Email ?? "Sin email")</p>

        <!-- Estado -->
        <div>
            @if (Model.Empleado.Estado == "Activo")
            {
                <span class="badge badge-success">Activo</span>
            }
            else if (Model.Empleado.Estado == "Vacaciones")
            {
                <span class="badge badge-info">En vacaciones</span>
            }
            else if (Model.Empleado.Estado == "Suspendido")
            {
                <span class="badge badge-warning">Suspendido</span>
            }
            else if (Model.Empleado.Estado == "Licencia")
            {
                <span class="badge badge-info">Licencia</span>
            }
            else if (Model.Empleado.Estado == "Baja")
            {
                <span class="badge badge-danger">Baja</span>
            }
            else
            {
                <span class="badge">@Model.Empleado.Estado</span>
            }
        </div>

        <!-- Info stats -->
        <div class="profile-stats">
            <div class="profile-stat">
                <span class="profile-stat-label">Código</span>
                <span class="profile-stat-value">@Model.Empleado.Codigo</span>
            </div>
            <div class="profile-stat">
                <span class="profile-stat-label">Cédula</span>
                <span class="profile-stat-value">@Model.Empleado.Cedula</span>
            </div>
            <div class="profile-stat">
                <span class="profile-stat-label">Teléfono</span>
                <span class="profile-stat-value">@(Model.Empleado.Telefono ?? "—")</span>
            </div>
            <div class="profile-stat">
                <span class="profile-stat-label">Ingreso</span>
                <span class="profile-stat-value">@Model.Empleado.FechaIngreso.ToString("dd/MM/yyyy")</span>
            </div>
            <div class="profile-stat">
                <span class="profile-stat-label">Antigüedad</span>
                <span class="profile-stat-value">@Model.MesesAntiguedad meses</span>
            </div>
            <div class="profile-stat">
                <span class="profile-stat-label">Salario</span>
                <span class="profile-stat-value">L. @Model.Empleado.SalarioBase.ToString("N2")</span>
            </div>
            <div class="profile-stat">
                <span class="profile-stat-label">Vacaciones</span>
                <span class="profile-stat-value" style="color: var(--color-primary);">@Model.Empleado.DiasVacacionesDisponibles días</span>
            </div>
        </div>
    </div>

    <!-- CONTENIDO CON TABS -->
    <div>
        <div class="nomenclatura-tabs">
            <a href="#tab-personal" class="nomenclatura-tab is-active" data-tab="tab-personal">👤 Personal</a>
            <a href="#tab-laboral" class="nomenclatura-tab" data-tab="tab-laboral">💼 Laboral</a>
            <a href="#tab-documentos" class="nomenclatura-tab" data-tab="tab-documentos">📎 Documentos (@Model.AdjuntosView.Count)</a>
            <a href="#tab-expedientes" class="nomenclatura-tab" data-tab="tab-expedientes">⚠️ Expedientes (@Model.Expedientes.Count)</a>
            <a href="#tab-vacaciones" class="nomenclatura-tab" data-tab="tab-vacaciones">🏖️ Vacaciones (@Model.Vacaciones.Count)</a>
            <a href="#tab-permisos" class="nomenclatura-tab" data-tab="tab-permisos">📝 Permisos (@Model.Permisos.Count)</a>
            <a href="#tab-vales" class="nomenclatura-tab" data-tab="tab-vales">🎫 Vales (@Model.Vales.Count)</a>
            <a href="#tab-nomina" class="nomenclatura-tab" data-tab="tab-nomina">💵 Nómina</a>
        </div>

        <!-- ============================================ -->
        <!-- TAB: PERSONAL -->
        <!-- ============================================ -->
        <div id="tab-personal" class="tab-content module-card" style="padding: 28px;">
            <h3 class="panel-title" style="margin-bottom: 20px;">Datos personales</h3>

            <div class="empresa-info-grid">
                <div class="empresa-info-item">
                    <span class="empresa-info-label">Nombres completos</span>
                    <span class="empresa-info-value">@Model.Empleado.Nombres @Model.Empleado.Apellidos</span>
                </div>
                <div class="empresa-info-item">
                    <span class="empresa-info-label">Cédula / DNI</span>
                    <span class="empresa-info-value">@Model.Empleado.Cedula</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.Empleado.RTN))
                {
                    <div class="empresa-info-item">
                        <span class="empresa-info-label">RTN</span>
                        <span class="empresa-info-value">@Model.Empleado.RTN</span>
                    </div>
                }
                @if (Model.Empleado.FechaNacimiento.HasValue)
                {
                    <div class="empresa-info-item">
                        <span class="empresa-info-label">Fecha de nacimiento</span>
                        <span class="empresa-info-value">@Model.Empleado.FechaNacimiento.Value.ToString("dd/MM/yyyy")</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Empleado.Genero))
                {
                    <div class="empresa-info-item">
                        <span class="empresa-info-label">Género</span>
                        <span class="empresa-info-value">@Model.Empleado.Genero</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Empleado.EstadoCivil))
                {
                    <div class="empresa-info-item">
                        <span class="empresa-info-label">Estado civil</span>
                        <span class="empresa-info-value">@Model.Empleado.EstadoCivil</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Empleado.Nacionalidad))
                {
                    <div class="empresa-info-item">
                        <span class="empresa-info-label">Nacionalidad</span>
                        <span class="empresa-info-value">@Model.Empleado.Nacionalidad</span>
                    </div>
                }
            </div>

            <div class="form-divider"></div>
            <h3 class="panel-title" style="margin-bottom: 20px;">Contacto</h3>

            <div class="empresa-info-grid">
                @if (!string.IsNullOrEmpty(Model.Empleado.Telefono))
                {
                    <div class="empresa-info-item">
                        <span class="empresa-info-label">Teléfono</span>
                        <span class="empresa-info-value">@Model.Empleado.Telefono</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Empleado.TelefonoSecundario))
                {
                    <div class="empresa-info-item">
                        <span class="empresa-info-label">Teléfono secundario</span>
                        <span class="empresa-info-value">@Model.Empleado.TelefonoSecundario</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Empleado.Email))
                {
                    <div class="empresa-info-item">
                        <span class="empresa-info-label">Email</span>
                        <span class="empresa-info-value">@Model.Empleado.Email</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Empleado.Direccion))
                {
                    <div class="empresa-info-item empresa-info-full">
                        <span class="empresa-info-label">Dirección</span>
                        <span class="empresa-info-value">@Model.Empleado.Direccion</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Empleado.Ciudad))
                {
                    <div class="empresa-info-item">
                        <span class="empresa-info-label">Ciudad</span>
                        <span class="empresa-info-value">@Model.Empleado.Ciudad</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Empleado.Pais))
                {
                    <div class="empresa-info-item">
                        <span class="empresa-info-label">País</span>
                        <span class="empresa-info-value">@Model.Empleado.Pais</span>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.Empleado.ContactoEmergenciaNombre))
            {
                <div class="form-divider"></div>
                <h3 class="panel-title" style="margin-bottom: 20px;">Contacto de emergencia</h3>

                <div class="empresa-info-grid">
                    <div class="empresa-info-item">
                        <span class="empresa-info-label">Nombre</span>
                        <span class="empresa-info-value">@Model.Empleado.ContactoEmergenciaNombre</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Empleado.ContactoEmergenciaTelefono))
                    {
                        <div class="empresa-info-item">
                            <span class="empresa-info-label">Teléfono</span>
                            <span class="empresa-info-value">@Model.Empleado.ContactoEmergenciaTelefono</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Empleado.ContactoEmergenciaParentesco))
                    {
                        <div class="empresa-info-item">
                            <span class="empresa-info-label">Parentesco</span>
                            <span class="empresa-info-value">@Model.Empleado.ContactoEmergenciaParentesco</span>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ============================================ -->
        <!-- TAB: LABORAL -->
        <!-- ============================================ -->
        <div id="tab-laboral" class="tab-content module-card" style="padding: 28px; display: none;">
            <h3 class="panel-title" style="margin-bottom: 20px;">Datos laborales</h3>

            <div class="empresa-info-grid">
                <div class="empresa-info-item">
                    <span class="empresa-info-label">Código</span>
                    <span class="empresa-info-value">@Model.Empleado.Codigo</span>
                </div>
                <div class="empresa-info-item">
                    <span class="empresa-info-label">Puesto</span>
                    <span class="empresa-info-value">@(Model.Empleado.PuestoNombre ?? "—")</span>
                </div>
                <div class="empresa-info-item">
                    <span class="empresa-info-label">Departamento</span>
                    <span class="empresa-info-value">@(Model.Empleado.Departamento ?? "—")</span>
                </div>
                <div class="empresa-info-item">
                    <span class="empresa-info-label">Jefe inmediato</span>
                    <span class="empresa-info-value">@(Model.Empleado.JefeInmediato ?? "—")</span>
                </div>
                <div class="empresa-info-item">
                    <span class="empresa-info-label">Tipo de contrato</span>
                    <span class="empresa-info-value">@Model.Empleado.TipoContrato</span>
                </div>
                <div class="empresa-info-item">
                    <span class="empresa-info-label">Tipo de jornada</span>
                    <span class="empresa-info-value">@Model.Empleado.TipoJornada</span>
                </div>
                <div class="empresa-info-item">
                    <span class="empresa-info-label">Fecha de ingreso</span>
                    <span class="empresa-info-value">@Model.Empleado.FechaIngreso.ToString("dd/MM/yyyy")</span>
                </div>
                @if (Model.Empleado.FechaFinContrato.HasValue)
                {
                    <div class="empresa-info-item">
                        <span class="empresa-info-label">Fecha fin de contrato</span>
                        <span class="empresa-info-value">@Model.Empleado.FechaFinContrato.Value.ToString("dd/MM/yyyy")</span>
                    </div>
                }
                @if (Model.Empleado.FechaBaja.HasValue)
                {
                    <div class="empresa-info-item">
                        <span class="empresa-info-label">Fecha de baja</span>
                        <span class="empresa-info-value" style="color: var(--color-danger);">@Model.Empleado.FechaBaja.Value.ToString("dd/MM/yyyy")</span>
                    </div>
                }
                <div class="empresa-info-item">
                    <span class="empresa-info-label">Antigüedad</span>
                    <span class="empresa-info-value">@Model.AniosAntiguedad @(Model.AniosAntiguedad == 1 ? "año" : "años")</span>
                </div>
            </div>

            <div class="form-divider"></div>
            <h3 class="panel-title" style="margin-bottom: 20px;">Salario</h3>

            <div class="empresa-info-grid">
                <div class="empresa-info-item">
                    <span class="empresa-info-label">Salario base</span>
                    <span class="empresa-info-value"><strong>L. @Model.Empleado.SalarioBase.ToString("N2")</strong></span>
                </div>
                <div class="empresa-info-item">
                    <span class="empresa-info-label">Frecuencia de pago</span>
                    <span class="empresa-info-value">@Model.Empleado.FrecuenciaPago</span>
                </div>
                @if (Model.Empleado.BonoTransporte.HasValue && Model.Empleado.BonoTransporte > 0)
                {
                    <div class="empresa-info-item">
                        <span class="empresa-info-label">Bono de transporte</span>
                        <span class="empresa-info-value">L. @Model.Empleado.BonoTransporte.Value.ToString("N2")</span>
                    </div>
                }
                @if (Model.Empleado.BonoAlimentacion.HasValue && Model.Empleado.BonoAlimentacion > 0)
                {
                    <div class="empresa-info-item">
                        <span class="empresa-info-label">Bono de alimentación</span>
                        <span class="empresa-info-value">L. @Model.Empleado.BonoAlimentacion.Value.ToString("N2")</span>
                    </div>
                }
                @if (Model.Empleado.OtrosBonos.HasValue && Model.Empleado.OtrosBonos > 0)
                {
                    <div class="empresa-info-item">
                        <span class="empresa-info-label">Otros bonos</span>
                        <span class="empresa-info-value">L. @Model.Empleado.OtrosBonos.Value.ToString("N2")</span>
                    </div>
                }
            </div>

            <div class="form-divider"></div>
            <h3 class="panel-title" style="margin-bottom: 20px;">Deducciones</h3>

            <div style="display: flex; gap: 16px; flex-wrap: wrap;">
                <span class="badge @(Model.Empleado.CotizaIHSS ? "badge-success" : "badge-danger")">
                    IHSS: @(Model.Empleado.CotizaIHSS ? "Sí" : "No")
                </span>
                <span class="badge @(Model.Empleado.CotizaRAP ? "badge-success" : "badge-danger")">
                    RAP: @(Model.Empleado.CotizaRAP ? "Sí" : "No")
                </span>
                <span class="badge @(Model.Empleado.AplicaISR ? "badge-success" : "badge-danger")">
                    ISR: @(Model.Empleado.AplicaISR ? "Sí" : "No")
                </span>
            </div>

            @if (!string.IsNullOrEmpty(Model.Empleado.Banco))
            {
                <div class="form-divider"></div>
                <h3 class="panel-title" style="margin-bottom: 20px;">Datos bancarios</h3>

                <div class="empresa-info-grid">
                    <div class="empresa-info-item">
                        <span class="empresa-info-label">Banco</span>
                        <span class="empresa-info-value">@Model.Empleado.Banco</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Empleado.CuentaBancaria))
                    {
                        <div class="empresa-info-item">
                            <span class="empresa-info-label">Cuenta</span>
                            <span class="empresa-info-value" style="font-family: monospace;">@Model.Empleado.CuentaBancaria</span>
                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Empleado.Notas))
            {
                <div class="form-divider"></div>
                <h3 class="panel-title" style="margin-bottom: 12px;">Notas</h3>
                <p style="color: var(--color-muted); font-size: 13px;">@Model.Empleado.Notas</p>
            }
        </div>

        <!-- ============================================ -->
        <!-- TAB: DOCUMENTOS -->
        <!-- ============================================ -->
        <div id="tab-documentos" class="tab-content module-card" style="padding: 28px; display: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h3 class="panel-title">Documentos adjuntos</h3>
                @if (Model.PuedeSubirDocumento)
                {
                    <button type="button" class="btn-primary btn-sm" onclick="document.getElementById('modalSubirDoc').style.display='flex'">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="17 8 12 3 7 8"/>
                            <line x1="12" y1="3" x2="12" y2="15"/>
                        </svg>
                        Subir documento
                    </button>
                }
            </div>

            @if (Model.AdjuntosView.Count == 0)
            {
                <p style="text-align: center; padding: 40px; color: var(--color-muted); font-size: 13px;">
                    No hay documentos adjuntos
                </p>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="erp-table">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Archivo</th>
                                <th>Descripción</th>
                                <th>Tamaño</th>
                                <th>Vence</th>
                                <th>Estado</th>
                                <th style="width: 100px; text-align: right;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.AdjuntosView)
                            {
                                <tr>
                                    <td><span class="badge badge-info">@a.TipoDocumentoNombre</span></td>
                                    <td>
                                        <strong>@a.NombreArchivo</strong>
                                        <br /><span class="table-user-sub">Subido: @a.FechaSubida.ToString("dd/MM/yyyy")</span>
                                    </td>
                                    <td>@(a.Descripcion ?? "—")</td>
                                    <td>@a.TamanoKB KB</td>
                                    <td>
                                        @if (a.FechaVencimiento.HasValue)
                                        {
                                            @a.FechaVencimiento.Value.ToString("dd/MM/yyyy")
                                        }
                                        else
                                        {
                                            <span class="table-user-sub">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (a.Vigente)
                                        {
                                            <span class="badge badge-success">Vigente</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger">Vencido</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="table-actions">
                                            <a href="@a.RutaArchivo" target="_blank" class="btn-icon-action" title="Ver">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                                    <circle cx="12" cy="12" r="3"/>
                                                </svg>
                                            </a>
                                            <a href="@a.RutaArchivo" download class="btn-icon-action" title="Descargar">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                                    <polyline points="7 10 12 15 17 10"/>
                                                    <line x1="12" y1="15" x2="12" y2="3"/>
                                                </svg>
                                            </a>
                                            @if (Model.PuedeSubirDocumento)
                                            {
                                                <form method="post" asp-page-handler="EliminarDocumento" asp-route-id="@Model.Empleado.Id" asp-route-adjuntoId="@a.Id" style="display:inline;" onsubmit="return confirm('¿Eliminar este documento?');">
                                                    <button type="submit" class="btn-icon-action btn-icon-action-danger" title="Eliminar">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <polyline points="3 6 5 6 21 6"/>
                                                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                                        </svg>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- Modal: Subir documento -->
            @if (Model.PuedeSubirDocumento)
            {
                <div id="modalSubirDoc" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center; padding: 20px;">
                    <div style="background: var(--color-surface); border-radius: var(--radius-lg); max-width: 500px; width: 100%; overflow: hidden;">
                        <form method="post" asp-page-handler="SubirDocumento" asp-route-id="@Model.Empleado.Id" enctype="multipart/form-data">
                            <div style="padding: 20px 24px; border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center;">
                                <h3 style="font-size: 16px; font-weight: 700;">Subir documento</h3>
                                <button type="button" onclick="document.getElementById('modalSubirDoc').style.display='none'" style="background: none; border: none; cursor: pointer; font-size: 20px; color: var(--color-muted);">&times;</button>
                            </div>

                            <div style="padding: 24px; display: flex; flex-direction: column; gap: 14px;">
                                <div class="form-field">
                                    <label>Tipo de documento *</label>
                                    <select name="tipoDocumentoId" class="form-input" required>
                                        <option value="">— Selecciona —</option>
                                        @foreach (var t in Model.TiposDocumento)
                                        {
                                            <option value="@t.Id">@t.Categoria — @t.Nombre</option>
                                        }
                                    </select>
                                </div>

                                <div class="form-field">
                                    <label>Archivo *</label>
                                    <input type="file" name="archivo" accept=".pdf,.jpg,.jpeg,.png,.docx,.doc" required style="font-size: 13px;" />
                                    <small class="form-help">PDF, JPG, PNG, DOCX. Máx 15 MB.</small>
                                </div>

                                <div class="form-field">
                                    <label>Descripción</label>
                                    <input type="text" name="descripcion" class="form-input" placeholder="Ej: Copia firmada" />
                                </div>

                                <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                                    <div class="form-field">
                                        <label>Fecha del documento</label>
                                        <input type="date" name="fechaDocumento" class="form-input" />
                                    </div>
                                    <div class="form-field">
                                        <label>Fecha de vencimiento</label>
                                        <input type="date" name="fechaVencimiento" class="form-input" />
                                    </div>
                                </div>
                            </div>

                            <div style="padding: 16px 24px; background: #f9fafb; border-top: 1px solid var(--color-border); display: flex; gap: 12px; justify-content: flex-end;">
                                <button type="button" class="btn-secondary" onclick="document.getElementById('modalSubirDoc').style.display='none'">Cancelar</button>
                                <button type="submit" class="btn-primary">Subir</button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>

        <!-- ============================================ -->
        <!-- TAB: EXPEDIENTES -->
        <!-- ============================================ -->
        <div id="tab-expedientes" class="tab-content module-card" style="padding: 28px; display: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h3 class="panel-title">Expedientes disciplinarios y méritos</h3>
                @if (Model.PuedeCrearExpediente)
                {
                    <a asp-page="/RRHH/Expedientes/Create" asp-route-empleadoId="@Model.Empleado.Id" class="btn-primary btn-sm">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                            <line x1="12" y1="5" x2="12" y2="19"/>
                            <line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                        Nuevo expediente
                    </a>
                }
            </div>

            @if (Model.Expedientes.Count == 0)
            {
                <p style="text-align: center; padding: 40px; color: var(--color-muted); font-size: 13px;">
                    Sin expedientes registrados
                </p>
            }
            else
            {
                <div class="timeline">
                    @foreach (var e in Model.Expedientes)
                    {
                        var color = e.Tipo switch
                        {
                            "LlamadoAtencion" => "#f59e0b",
                            "AmonestacionVerbal" => "#f97316",
                            "AmonestacionEscrita" => "#ef4444",
                            "Suspension" => "#dc2626",
                            "NotaMerito" => "#10b981",
                            "Reconocimiento" => "#06b6d4",
                            _ => "#6b7280"
                        };

                        <div class="timeline-item">
                            <div class="timeline-dot" style="background: @color;"></div>
                            <div class="timeline-content">
                                <div class="timeline-header">
                                    <strong>@e.Titulo</strong>
                                    <span class="timeline-date">@e.Fecha.ToString("dd/MM/yyyy")</span>
                                </div>
                                <p class="timeline-detail">@e.Descripcion</p>
                                <div style="display: flex; gap: 8px; margin-top: 6px; flex-wrap: wrap;">
                                    <span class="badge" style="background: @(color)20; color: @color;">@e.Tipo</span>
                                    @if (!string.IsNullOrEmpty(e.Gravedad))
                                    {
                                        <span class="badge badge-warning">Gravedad: @e.Gravedad</span>
                                    }
                                    @if (e.DiasSuspension.HasValue)
                                    {
                                        <span class="badge badge-danger">@e.DiasSuspension días de suspensión</span>
                                    }
                                    @if (e.EmpleadoFirmo)
                                    {
                                        <span class="badge badge-success">Firmado</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ============================================ -->
        <!-- TAB: VACACIONES -->
        <!-- ============================================ -->
        <div id="tab-vacaciones" class="tab-content module-card" style="padding: 28px; display: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h3 class="panel-title">Historial de vacaciones</h3>
                <a asp-page="/RRHH/Vacaciones/Create" asp-route-empleadoId="@Model.Empleado.Id" class="btn-primary btn-sm">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    Nueva solicitud
                </a>
            </div>

            <!-- KPIs de vacaciones -->
            <div class="kpi-grid" style="margin-bottom: 20px;">
                <div class="kpi-card">
                    <span class="kpi-label">Días disponibles</span>
                    <span class="kpi-value" style="color: var(--color-primary);">@Model.Empleado.DiasVacacionesDisponibles</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Días ganados</span>
                    <span class="kpi-value">@Model.Empleado.DiasVacacionesGanados</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Días tomados</span>
                    <span class="kpi-value">@Model.Empleado.DiasVacacionesTomados</span>
                </div>
            </div>

            @if (Model.Vacaciones.Count == 0)
            {
                <p style="text-align: center; padding: 40px; color: var(--color-muted); font-size: 13px;">
                    Sin vacaciones registradas
                </p>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="erp-table">
                        <thead>
                            <tr>
                                <th>Número</th>
                                <th>Período</th>
                                <th style="text-align: right;">Días</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.Vacaciones)
                            {
                                <tr>
                                    <td><span style="font-family: monospace;">@v.Numero</span></td>
                                    <td>@v.FechaInicio.ToString("dd/MM/yyyy") al @v.FechaFin.ToString("dd/MM/yyyy")</td>
                                    <td style="text-align: right;"><strong>@v.DiasADescontar</strong></td>
                                    <td>
                                        @if (v.Estado == "Aprobado" || v.Estado == "Tomado")
                                        {
                                            <span class="badge badge-success">@v.Estado</span>
                                        }
                                        else if (v.Estado == "Solicitado")
                                        {
                                            <span class="badge badge-info">@v.Estado</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger">@v.Estado</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- ============================================ -->
        <!-- TAB: PERMISOS -->
        <!-- ============================================ -->
        <div id="tab-permisos" class="tab-content module-card" style="padding: 28px; display: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h3 class="panel-title">Permisos y licencias</h3>
                <a asp-page="/RRHH/Permisos/Create" asp-route-empleadoId="@Model.Empleado.Id" class="btn-primary btn-sm">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    Nuevo permiso
                </a>
            </div>

            @if (Model.Permisos.Count == 0)
            {
                <p style="text-align: center; padding: 40px; color: var(--color-muted); font-size: 13px;">
                    Sin permisos registrados
                </p>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="erp-table">
                        <thead>
                            <tr>
                                <th>Número</th>
                                <th>Tipo</th>
                                <th>Período</th>
                                <th style="text-align: right;">Días</th>
                                <th>Goce sueldo</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Permisos)
                            {
                                <tr>
                                    <td><span style="font-family: monospace;">@p.Numero</span></td>
                                    <td>@p.Tipo</td>
                                    <td>@p.FechaInicio.ToString("dd/MM/yyyy") al @p.FechaFin.ToString("dd/MM/yyyy")</td>
                                    <td style="text-align: right;"><strong>@p.DiasSolicitados</strong></td>
                                    <td>
                                        @if (p.ConGoceSueldo)
                                        {
                                            <span class="badge badge-success">Sí</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning">No</span>
                                        }
                                    </td>
                                    <td>
                                        @if (p.Estado == "Aprobado" || p.Estado == "Tomado")
                                        {
                                            <span class="badge badge-success">@p.Estado</span>
                                        }
                                        else if (p.Estado == "Solicitado")
                                        {
                                            <span class="badge badge-info">@p.Estado</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger">@p.Estado</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- ============================================ -->
        <!-- TAB: VALES -->
        <!-- ============================================ -->
        <div id="tab-vales" class="tab-content module-card" style="padding: 28px; display: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h3 class="panel-title">Vales y adelantos</h3>
                <a asp-page="/RRHH/Vales/Create" asp-route-empleadoId="@Model.Empleado.Id" class="btn-primary btn-sm">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    Nuevo vale
                </a>
            </div>

            @if (Model.Vales.Count == 0)
            {
                <p style="text-align: center; padding: 40px; color: var(--color-muted); font-size: 13px;">
                    Sin vales registrados
                </p>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="erp-table">
                        <thead>
                            <tr>
                                <th>Número</th>
                                <th>Fecha</th>
                                <th style="text-align: right;">Monto</th>
                                <th>Cuotas</th>
                                <th style="text-align: right;">Saldo</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.Vales)
                            {
                                <tr>
                                    <td><span style="font-family: monospace;">@v.Numero</span></td>
                                    <td>@v.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                                    <td style="text-align: right;"><strong>L. @v.Monto.ToString("N2")</strong></td>
                                    <td>@v.Cuotas cuota@(v.Cuotas > 1 ? "s" : "")</td>
                                    <td style="text-align: right;">
                                        @if (v.SaldoPendiente > 0)
                                        {
                                            <strong style="color: var(--color-danger);">L. @v.SaldoPendiente.ToString("N2")</strong>
                                        }
                                        else
                                        {
                                            <span class="badge badge-success">Pagado</span>
                                        }
                                    </td>
                                    <td>
                                        @if (v.Estado == "Entregado" || v.Estado == "Descontado")
                                        {
                                            <span class="badge badge-success">@v.Estado</span>
                                        }
                                        else if (v.Estado == "Solicitado" || v.Estado == "AprobadoGerente" || v.Estado == "AprobadoRRHH")
                                        {
                                            <span class="badge badge-info">@v.Estado</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger">@v.Estado</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- ============================================ -->
        <!-- TAB: NÓMINA -->
        <!-- ============================================ -->
        <div id="tab-nomina" class="tab-content module-card" style="padding: 28px; display: none;">
            <h3 class="panel-title" style="margin-bottom: 20px;">Historial de nómina</h3>

            @if (Model.Nominas.Count == 0)
            {
                <p style="text-align: center; padding: 40px; color: var(--color-muted); font-size: 13px;">
                    Sin registros de nómina
                </p>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="erp-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th style="text-align: right;">Bruto</th>
                                <th style="text-align: right;">Deducciones</th>
                                <th style="text-align: right;">Neto</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var n in Model.Nominas)
                            {
                                <tr>
                                    <td>#@n.Id</td>
                                    <td style="text-align: right;">L. @n.TotalBruto.ToString("N2")</td>
                                    <td style="text-align: right; color: var(--color-danger);">- L. @n.TotalDeducciones.ToString("N2")</td>
                                    <td style="text-align: right;"><strong>L. @n.SalarioNeto.ToString("N2")</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // ===== Tabs =====
            var tabs = document.querySelectorAll('.nomenclatura-tab[data-tab]');
            var contents = document.querySelectorAll('.tab-content');

            tabs.forEach(function (tab) {
                tab.addEventListener('click', function (e) {
                    e.preventDefault();

                    tabs.forEach(function (t) { t.classList.remove('is-active'); });
                    this.classList.add('is-active');

                    contents.forEach(function (c) { c.style.display = 'none'; });

                    var targetId = this.dataset.tab;
                    var target = document.getElementById(targetId);
                    if (target) target.style.display = 'block';
                });
            });
        })();
    </script>
}