@page "{id:int}"
@model Kirkenta.Pages.RRHH.Empleados.DeleteModel
@{
    ViewData["Title"] = "Eliminar empleado";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/RRHH/Empleados/Index" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Volver a empleados
        </a>
        <h2>Eliminar empleado</h2>
    </div>
</div>

@if (Model.TieneDependencias)
{
    <div class="module-card danger-card">
        <div class="danger-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
        </div>

        <h3>No se puede eliminar</h3>
        <p>El empleado <strong>@Model.Empleado.Nombres @Model.Empleado.Apellidos</strong> tiene registros asociados:</p>

        <div style="text-align: left; display: inline-block; margin: 20px 0;">
            @if (Model.TieneDocumentos > 0)
            {
                <p>📎 @Model.TieneDocumentos documento(s)</p>
            }
            @if (Model.TieneExpedientes > 0)
            {
                <p>⚠️ @Model.TieneExpedientes expediente(s)</p>
            }
            @if (Model.TieneVacaciones > 0)
            {
                <p>🏖️ @Model.TieneVacaciones vacación(es)</p>
            }
            @if (Model.TienePermisos > 0)
            {
                <p>📝 @Model.TienePermisos permiso(s)</p>
            }
            @if (Model.TieneVales > 0)
            {
                <p>🎫 @Model.TieneVales vale(s)</p>
            }
            @if (Model.TieneNominas > 0)
            {
                <p>💵 @Model.TieneNominas nómina(s)</p>
            }
        </div>

        <p><strong>Recomendación:</strong> en lugar de eliminar, cambia el estado a <span class="badge badge-danger">Baja</span> desde la opción Editar.</p>

        <div class="form-actions" style="justify-content: center;">
            <a asp-page="/RRHH/Empleados/Details" asp-route-id="@Model.Empleado.Id" class="btn-secondary">Volver al empleado</a>
            <a asp-page="/RRHH/Empleados/Edit" asp-route-id="@Model.Empleado.Id" class="btn-primary">Ir a Editar</a>
        </div>
    </div>
}
else
{
    <div class="module-card danger-card">
        <div class="danger-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
        </div>

        <h3>¿Eliminar a @Model.Empleado.Nombres @Model.Empleado.Apellidos?</h3>
        <p>Esta acción no se puede deshacer.</p>

        <div class="user-preview">
            <div class="user-avatar-sm">
                @Model.Empleado.Nombres.Substring(0, 1).ToUpper()
            </div>
            <div>
                <strong>@Model.Empleado.Nombres @Model.Empleado.Apellidos</strong>
                <span>@Model.Empleado.Codigo — @(Model.Empleado.PuestoNombre ?? "Sin puesto")</span>
            </div>
        </div>

        <form method="post" class="form-actions" style="justify-content: center;">
            <a asp-page="/RRHH/Empleados/Index" class="btn-secondary">Cancelar</a>
            <button type="submit" class="btn-danger">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <polyline points="3 6 5 6 21 6"/>
                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                </svg>
                Sí, eliminar
            </button>
        </form>
    </div>
}