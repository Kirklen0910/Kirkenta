@page
@model Kirkenta.Pages.RRHH.Vales.CreateModel
@{
    ViewData["Title"] = "Nuevo vale";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/RRHH/Vales/Index" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Volver a vales
        </a>
        <h2>Nuevo vale</h2>
        <p>Número: <strong>@Model.NumeroPreview</strong></p>
    </div>
</div>

<div class="module-card form-card">
    <form method="post" class="erp-form">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="module-alert module-alert-error">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <div asp-validation-summary="All"></div>
            </div>
        }

        <div class="module-alert" style="background: #eef2ff; border: 1px solid #c7d2fe; color: var(--color-primary);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="16" x2="12" y2="12"/>
                <line x1="12" y1="8" x2="12.01" y2="8"/>
            </svg>
            <div>
                <strong>Doble aprobación requerida</strong>
                <p style="margin: 4px 0 0 0; font-size: 12.5px;">Este vale debe ser aprobado por el Gerente y luego por RRHH antes de poder entregarse.</p>
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.EmpleadoId">Empleado *</label>
            <select asp-for="Input.EmpleadoId" class="form-input" required>
                <option value="">— Selecciona un empleado —</option>
                @foreach (var e in Model.Empleados)
                {
                    <option value="@e.Id">@e.Codigo — @e.Nombres @e.Apellidos (@(e.PuestoNombre ?? "Sin puesto"))</option>
                }
            </select>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.Monto">Monto *</label>
                <input asp-for="Input.Monto" type="number" step="0.01" min="0.01" class="form-input" required />
                <small class="form-help">Máximo 50% del salario mensual del empleado</small>
            </div>
            <div class="form-field">
                <label asp-for="Input.Cuotas">Número de cuotas *</label>
                <select asp-for="Input.Cuotas" class="form-input" required id="cuotasSelect">
                    <option value="1">1 cuota (se descuenta completo)</option>
                    <option value="2">2 cuotas</option>
                    <option value="3">3 cuotas</option>
                    <option value="4">4 cuotas</option>
                    <option value="6">6 cuotas</option>
                    <option value="12">12 cuotas</option>
                </select>
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.FechaPrimerDescuento">Fecha del primer descuento</label>
            <input asp-for="Input.FechaPrimerDescuento" type="date" class="form-input" />
            <small class="form-help">Cuándo se empezará a descontar en la nómina</small>
        </div>

        <div class="form-field">
            <label asp-for="Input.Motivo">Motivo *</label>
            <textarea asp-for="Input.Motivo" class="form-input" rows="2" placeholder="Ej: Emergencia médica, gastos personales..." required></textarea>
        </div>

        <div class="form-field">
            <label asp-for="Input.Notas">Notas adicionales</label>
            <textarea asp-for="Input.Notas" class="form-input" rows="2"></textarea>
        </div>

        <div class="form-actions">
            <a asp-page="/RRHH/Vales/Index" class="btn-secondary">Cancelar</a>
            <button type="submit" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                Solicitar vale
            </button>
        </div>
    </form>
</div>