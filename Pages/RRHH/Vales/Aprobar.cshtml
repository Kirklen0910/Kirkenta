@page "{id:int}"
@model Kirkenta.Pages.RRHH.Vales.AprobarModel
@{
    ViewData["Title"] = $"Aprobar vale {Model.Vale.Numero}";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/RRHH/Vales/Index" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Volver a vales
        </a>
        <h2>Aprobar / Rechazar vale</h2>
        <p>Revisa la solicitud antes de tomar una decisión</p>
    </div>
</div>

<div class="module-card form-card">
    <form method="post">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="module-alert module-alert-error">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <div asp-validation-summary="All"></div>
            </div>
        }

        <div class="user-preview">
            <div class="user-avatar-sm">@Model.Empleado.Nombres.Substring(0, 1).ToUpper()</div>
            <div>
                <strong>@Model.Empleado.Nombres @Model.Empleado.Apellidos</strong>
                <span>@Model.Empleado.Codigo — @(Model.Empleado.PuestoNombre ?? "Sin puesto")</span>
            </div>
        </div>

        <div class="totales-panel" style="max-width: 100%; margin: 16px 0;">
            <div class="totales-row">
                <span>Número de vale:</span>
                <strong>@Model.Vale.Numero</strong>
            </div>
            <div class="totales-row">
                <span>Fecha de solicitud:</span>
                <strong>@Model.Vale.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</strong>
            </div>
            <div class="totales-row">
                <span>Motivo:</span>
                <strong>@Model.Vale.Motivo</strong>
            </div>
            <div class="totales-row">
                <span>Cuotas:</span>
                <strong>@Model.Vale.Cuotas (@Model.Vale.MontoCuota.ToString("N2") c/u)</strong>
            </div>
            <div class="totales-row totales-row-final">
                <span>MONTO:</span>
                <strong>L. @Model.Vale.Monto.ToString("N2")</strong>
            </div>
        </div>

        <div class="module-alert" style="background: #eef2ff; border: 1px solid #c7d2fe; color: var(--color-primary);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="16" x2="12" y2="12"/>
                <line x1="12" y1="8" x2="12.01" y2="8"/>
            </svg>
            <div>
                <strong>Estado actual: @Model.Vale.Estado</strong>
                @if (Model.Vale.Estado == "Solicitado")
                {
                    <p style="margin: 4px 0 0 0; font-size: 12.5px;">Al aprobar, pasará a "Aprobado Gerente" y necesitará aprobación de RRHH.</p>
                }
                else if (Model.Vale.Estado == "AprobadoGerente")
                {
                    <p style="margin: 4px 0 0 0; font-size: 12.5px;">Al aprobar, quedará "Aprobado RRHH" y listo para entregar.</p>
                }
            </div>
        </div>

        <div class="form-field">
            <label>Acción *</label>
            <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 8px;">
                <label style="display:flex; align-items:center; gap:10px; padding: 12px; border: 2px solid var(--color-border); border-radius: 6px; cursor: pointer;">
                    <input type="radio" asp-for="Accion" value="aprobar" />
                    <span><strong style="color: var(--color-success);">✓ Aprobar</strong> — Avanzar al siguiente paso</span>
                </label>
                <label style="display:flex; align-items:center; gap:10px; padding: 12px; border: 2px solid var(--color-border); border-radius: 6px; cursor: pointer;">
                    <input type="radio" asp-for="Accion" value="rechazar" />
                    <span><strong style="color: var(--color-danger);">✗ Rechazar</strong> — Cancelar la solicitud</span>
                </label>
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Motivo">Motivo del rechazo (obligatorio si rechaza)</label>
            <textarea asp-for="Motivo" class="form-input" rows="3" placeholder="Explica por qué se rechaza..."></textarea>
        </div>

        <div class="form-actions">
            <a asp-page="/RRHH/Vales/Index" class="btn-secondary">Cancelar</a>
            <button type="submit" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                Confirmar decisión
            </button>
        </div>
    </form>
</div>