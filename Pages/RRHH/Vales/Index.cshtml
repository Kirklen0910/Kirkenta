@page
@model Kirkenta.Pages.RRHH.Vales.IndexModel
@{
    ViewData["Title"] = "Vales a empleados";
}

<div class="module-header">
    <div class="module-header-left">
        <h2>Vales a empleados</h2>
        <p>Adelantos de salario y su control</p>
    </div>
    <div class="module-header-right">
        @if (Model.PuedeCrear)
        {
            <a asp-page="/RRHH/Vales/Create" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Nuevo vale
            </a>
        }
        <a asp-page="/RRHH/Index" class="btn-secondary">Volver a RRHH</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="module-alert module-alert-success">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="module-alert module-alert-error">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        @TempData["Error"]
    </div>
}

<!-- KPIs -->
<div class="kpi-grid" style="margin-bottom: 20px;">
    <div class="kpi-card">
        <span class="kpi-label">Solicitados</span>
        <span class="kpi-value" style="color: var(--color-warning);">@Model.TotalPendientes</span>
        <span class="kpi-trend">Esperando aprobación</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Aprobados (Gerente)</span>
        <span class="kpi-value" style="color: var(--color-info);">@Model.TotalAprobadosGerente</span>
        <span class="kpi-trend">Esperando RRHH</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Listos para entregar</span>
        <span class="kpi-value" style="color: var(--color-success);">@Model.TotalAprobadosRRHH</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Monto pendiente</span>
        <span class="kpi-value" style="color: var(--color-danger); font-size: 20px;">L. @Model.MontoPendiente.ToString("N2")</span>
    </div>
</div>

<div class="module-card">
    <div class="module-toolbar">
        <div class="search-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" id="searchInput" placeholder="Buscar por número, empleado o código..." />
        </div>
        <div class="filter-group">
            <select id="filterEstado" class="filter-select">
                <option value="">Todos los estados</option>
                <option value="Solicitado">Solicitados</option>
                <option value="AprobadoGerente">Aprobados (Gerente)</option>
                <option value="AprobadoRRHH">Aprobados (RRHH)</option>
                <option value="Entregado">Entregados</option>
                <option value="Descontado">Descontados</option>
                <option value="Rechazado">Rechazados</option>
                <option value="Cancelado">Cancelados</option>
            </select>
        </div>
    </div>

    @if (Model.Vales.Count == 0)
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="5" width="20" height="14" rx="2"/>
                <line x1="2" y1="10" x2="22" y2="10"/>
            </svg>
            <h3>No hay vales registrados</h3>
            <p>Registra el primer vale a un empleado</p>
            <a asp-page="/RRHH/Vales/Create" class="btn-primary">Nuevo vale</a>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="erp-table" id="valesTable">
                <thead>
                    <tr>
                        <th style="width: 50px;"></th>
                        <th>Número</th>
                        <th>Empleado</th>
                        <th>Fecha</th>
                        <th style="text-align: right;">Monto</th>
                        <th>Cuotas</th>
                        <th style="text-align: right;">Saldo</th>
                        <th>Estado</th>
                        <th style="width: 180px; text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model.Vales)
                    {
                        <tr data-numero="@v.Numero.ToLower()"
                            data-empleado="@v.EmpleadoNombre.ToLower()"
                            data-codigo="@v.EmpleadoCodigo.ToLower()"
                            data-estado="@v.Estado">
                            <td>
                                @if (!string.IsNullOrEmpty(v.FotoPath))
                                {
                                    <img src="@v.FotoPath" alt="@v.EmpleadoNombre" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="user-avatar-sm">@v.EmpleadoNombre.Substring(0, 1).ToUpper()</div>
                                }
                            </td>
                            <td><span style="font-family: monospace;">@v.Numero</span></td>
                            <td>
                                <div class="table-user-cell">
                                    <span class="table-user-name">@v.EmpleadoNombre</span>
                                    <span class="table-user-sub">@v.EmpleadoCodigo</span>
                                </div>
                            </td>
                            <td>@v.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                            <td style="text-align: right;"><strong>L. @v.Monto.ToString("N2")</strong></td>
                            <td>@v.Cuotas cuota@(v.Cuotas > 1 ? "s" : "")</td>
                            <td style="text-align: right;">
                                @if (v.SaldoPendiente > 0)
                                {
                                    <strong style="color: var(--color-danger);">L. @v.SaldoPendiente.ToString("N2")</strong>
                                }
                                else
                                {
                                    <span class="badge badge-success">Pagado</span>
                                }
                            </td>
                            <td>
                                @if (v.Estado == "Solicitado")
                                {
                                    <span class="badge badge-warning">Solicitado</span>
                                }
                                else if (v.Estado == "AprobadoGerente")
                                {
                                    <span class="badge badge-info">Aprobado (Gerente)</span>
                                }
                                else if (v.Estado == "AprobadoRRHH")
                                {
                                    <span class="badge" style="background: #c7d2fe; color: #3730a3;">Listo para entregar</span>
                                }
                                else if (v.Estado == "Entregado")
                                {
                                    <span class="badge badge-success">Entregado</span>
                                }
                                else if (v.Estado == "Descontado")
                                {
                                    <span class="badge badge-success">Descontado</span>
                                }
                                else if (v.Estado == "Rechazado")
                                {
                                    <span class="badge badge-danger">Rechazado</span>
                                }
                                else if (v.Estado == "Cancelado")
                                {
                                    <span class="badge badge-danger">Cancelado</span>
                                }
                            </td>
                            <td>
                                <div class="table-actions">
                                    @if (Model.PuedeAprobar && (v.Estado == "Solicitado" || v.Estado == "AprobadoGerente"))
                                    {
                                        <a asp-page="/RRHH/Vales/Aprobar" asp-route-id="@v.Id" class="btn-icon-action" title="Aprobar/Rechazar">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"/>
                                            </svg>
                                        </a>
                                    }
                                    @if (Model.PuedeEntregar && v.Estado == "AprobadoRRHH")
                                    {
                                        <a asp-page="/RRHH/Vales/Entregar" asp-route-id="@v.Id" class="btn-icon-action" title="Entregar" style="color: var(--color-success);">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <line x1="12" y1="1" x2="12" y2="23"/>
                                                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                                            </svg>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var searchInput = document.getElementById('searchInput');
            var filterEstado = document.getElementById('filterEstado');
            var table = document.getElementById('valesTable');
            if (!table) return;
            var rows = table.querySelectorAll('tbody tr');

            function filterRows() {
                var search = (searchInput?.value || '').toLowerCase().trim();
                var estado = filterEstado?.value || '';

                rows.forEach(function (row) {
                    var numero = row.dataset.numero || '';
                    var empleado = row.dataset.empleado || '';
                    var codigo = row.dataset.codigo || '';
                    var rowEstado = row.dataset.estado || '';

                    var matchSearch = !search || numero.includes(search) || empleado.includes(search) || codigo.includes(search);
                    var matchEstado = !estado || rowEstado === estado;

                    row.style.display = (matchSearch && matchEstado) ? '' : 'none';
                });
            }

            searchInput?.addEventListener('input', filterRows);
            filterEstado?.addEventListener('change', filterRows);
        })();
    </script>
}