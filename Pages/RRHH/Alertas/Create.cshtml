@page
@model Kirkenta.Pages.RRHH.Alertas.CreateModel
@{
    ViewData["Title"] = "Nueva alerta";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/RRHH/Alertas/Index" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Volver a alertas
        </a>
        <h2>Nueva alerta</h2>
        <p>Crea un recordatorio o aviso</p>
    </div>
</div>

<div class="module-card form-card">
    <form method="post" class="erp-form">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="module-alert module-alert-error">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <div asp-validation-summary="All"></div>
            </div>
        }

        <div class="form-field">
            <label asp-for="Input.Titulo">Título *</label>
            <input asp-for="Input.Titulo" class="form-input" placeholder="Ej: Revisar contrato de Juan Pérez" required />
        </div>

        <div class="form-field">
            <label asp-for="Input.Descripcion">Descripción</label>
            <textarea asp-for="Input.Descripcion" class="form-input" rows="3" placeholder="Detalle adicional del recordatorio..."></textarea>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.Prioridad">Prioridad *</label>
                <select asp-for="Input.Prioridad" class="form-input" required>
                    <option value="Info">ℹ️ Info</option>
                    <option value="Advertencia">⚠️ Advertencia</option>
                    <option value="Urgente">🚨 Urgente</option>
                    <option value="Exito">✅ Éxito</option>
                </select>
            </div>
            <div class="form-field">
                <label asp-for="Input.EmpleadoId">Empleado relacionado</label>
                <select asp-for="Input.EmpleadoId" class="form-input">
                    <option value="">— Ninguno —</option>
                    @foreach (var e in Model.Empleados)
                    {
                        <option value="@e.Id">@e.Codigo — @e.Nombres @e.Apellidos</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.FechaAlerta">Fecha de la alerta *</label>
                <input asp-for="Input.FechaAlerta" type="date" class="form-input" required />
            </div>
            <div class="form-field">
                <label asp-for="Input.FechaVigenciaHasta">Vigente hasta</label>
                <input asp-for="Input.FechaVigenciaHasta" type="date" class="form-input" />
                <small class="form-help">Dejar vacío = vigencia indefinida</small>
            </div>
        </div>

        <div class="form-field">
            <label class="form-checkbox">
                <input asp-for="Input.MostrarEnDashboard" type="checkbox" />
                <span>Mostrar en el dashboard de RRHH</span>
            </label>
        </div>

        <div class="form-actions">
            <a asp-page="/RRHH/Alertas/Index" class="btn-secondary">Cancelar</a>
            <button type="submit" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                Crear alerta
            </button>
        </div>
    </form>
</div>