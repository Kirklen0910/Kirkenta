@page
@model Kirkenta.Pages.RRHH.Alertas.IndexModel
@{
    ViewData["Title"] = "Alertas personalizadas";
}

<div class="module-header">
    <div class="module-header-left">
        <h2>Alertas personalizadas</h2>
        <p>Recordatorios y avisos manuales</p>
    </div>
    <div class="module-header-right">
        @if (Model.PuedeCrear)
        {
            <a asp-page="/RRHH/Alertas/Create" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Nueva alerta
            </a>
        }
        <a asp-page="/RRHH/Index" class="btn-secondary">Volver a RRHH</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="module-alert module-alert-success">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="module-alert module-alert-error">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        @TempData["Error"]
    </div>
}

<!-- KPIs -->
<div class="kpi-grid" style="margin-bottom: 20px;">
    <div class="kpi-card">
        <span class="kpi-label">Alertas activas</span>
        <span class="kpi-value" style="color: var(--color-primary);">@Model.TotalActivas</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Urgentes</span>
        <span class="kpi-value" style="color: var(--color-danger);">@Model.TotalUrgentes</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Completadas</span>
        <span class="kpi-value" style="color: var(--color-success);">@Model.TotalCompletadas</span>
    </div>
</div>

<div class="module-card">
    @if (Model.Alertas.Count == 0)
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
            <h3>No hay alertas registradas</h3>
            <p>Crea recordatorios y avisos para el equipo</p>
            @if (Model.PuedeCrear)
            {
                <a asp-page="/RRHH/Alertas/Create" class="btn-primary">Nueva alerta</a>
            }
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="erp-table">
                <thead>
                    <tr>
                        <th>Prioridad</th>
                        <th>Título</th>
                        <th>Empleado</th>
                        <th>Fecha</th>
                        <th>Vigencia</th>
                        <th>Estado</th>
                        <th style="width: 140px; text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Alertas)
                    {
                        var color = a.Prioridad switch
                        {
                            "Urgente" => "#ef4444",
                            "Advertencia" => "#f59e0b",
                            "Exito" => "#10b981",
                            _ => "#4f46e5"
                        };
                        var esVencida = a.FechaVigenciaHasta.HasValue && a.FechaVigenciaHasta.Value.Date < DateTime.Today && !a.Completada;

                        <tr style="@(a.Completada ? "opacity: 0.55;" : "")">
                            <td>
                                <span class="badge" style="background: @(color)20; color: @color;">@a.Prioridad</span>
                            </td>
                            <td>
                                <strong>@a.Titulo</strong>
                                @if (!string.IsNullOrEmpty(a.Descripcion))
                                {
                                    <br /><span class="table-user-sub">@a.Descripcion</span>
                                }
                            </td>
                            <td>@(a.EmpleadoNombre ?? "—")</td>
                            <td>@a.FechaAlerta.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (a.FechaVigenciaHasta.HasValue)
                                {
                                    if (esVencida)
                                    {
                                        <span class="badge badge-danger">Vencida</span>
                                    }
                                    else
                                    {
                                        @a.FechaVigenciaHasta.Value.ToString("dd/MM/yyyy")
                                    }
                                }
                                else
                                {
                                    <span class="table-user-sub">Indefinida</span>
                                }
                            </td>
                            <td>
                                @if (a.Completada)
                                {
                                    <span class="badge badge-success">✓ Completada</span>
                                    @if (a.FechaCompletada.HasValue)
                                    {
                                        <br /><span class="table-user-sub">@a.FechaCompletada.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge badge-warning">Pendiente</span>
                                }
                            </td>
                            <td>
                                <div class="table-actions">
                                    @if (!a.Completada)
                                    {
                                        <form method="post" asp-page-handler="Completar" asp-route-id="@a.Id" style="display:inline;">
                                            <button type="submit" class="btn-icon-action" title="Marcar como completada" style="color: var(--color-success);">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="20 6 9 17 4 12"/>
                                                </svg>
                                            </button>
                                        </form>
                                    }
                                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@a.Id" style="display:inline;" onsubmit="return confirm('¿Eliminar esta alerta?');">
                                        <button type="submit" class="btn-icon-action btn-icon-action-danger" title="Eliminar">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"/>
                                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>