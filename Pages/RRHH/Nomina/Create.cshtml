@page
@model Kirkenta.Pages.RRHH.Nomina.CreateModel
@{
    ViewData["Title"] = "Generar nómina";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/RRHH/Nomina/Index" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Volver a nóminas
        </a>
        <h2>Generar nómina</h2>
        <p>Número: <strong>@Model.NumeroPreview</strong></p>
    </div>
</div>

<div class="module-card form-card">
    <form method="post" class="erp-form">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="module-alert module-alert-error">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <div asp-validation-summary="All"></div>
            </div>
        }

        <div class="module-alert" style="background: var(--color-primary-soft); border: 1px solid var(--color-primary-border); color: var(--color-primary);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="16" x2="12" y2="12"/>
                <line x1="12" y1="8" x2="12.01" y2="8"/>
            </svg>
            <div>
                <strong>Cálculo automático de deducciones</strong>
                <p style="margin: 4px 0 0 0; font-size: 12.5px;">El sistema calculará IHSS, RAP, ISR y descuento de vales según las configuraciones del empleado y de la empresa.</p>
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.Clase">Planilla *</label>
            <select asp-for="Input.Clase" class="form-input" id="nmClase">
                <option value="Normal">Planilla normal</option>
                <option value="DecimoTercer">Décimo tercer mes (aguinaldo)</option>
                <option value="DecimoCuarto">Décimo cuarto mes</option>
            </select>
        </div>

        <div class="form-field" id="nmCampoTipo">
            <label asp-for="Input.Tipo">Frecuencia de pago *</label>
            <select asp-for="Input.Tipo" class="form-input" id="nmTipo" required>
                <option value="Mensual">Mensual</option>
                <option value="Quincenal">Quincenal</option>
                <option value="Catorcenal">Catorcenal</option>
                <option value="Semanal">Semanal</option>
            </select>
            <small class="form-help">Solo se incluirán los empleados con esta frecuencia de pago</small>
        </div>

        <div class="form-field" id="nmCampoAnio" hidden>
            <label asp-for="Input.Anio">Año del décimo *</label>
            <input asp-for="Input.Anio" type="number" min="2000" max="2100" class="form-input" id="nmAnio" />
            <small class="form-help">Entran todos los empleados activos. Es lo ganado de salario en el período entre 12, respetando cada aumento, y sin deducciones.</small>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.FechaInicio">Fecha inicio del período *</label>
                <input asp-for="Input.FechaInicio" type="date" class="form-input" id="nmInicio" required />
            </div>
            <div class="form-field">
                <label asp-for="Input.FechaFin">Fecha fin del período *</label>
                <input asp-for="Input.FechaFin" type="date" class="form-input" id="nmFin" required />
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.FechaPago">Fecha de pago *</label>
                <input asp-for="Input.FechaPago" type="date" class="form-input" id="nmPago" required />
            </div>
            <div class="form-field">
                <label asp-for="Input.PeriodoDescripcion">Descripción del período</label>
                <input asp-for="Input.PeriodoDescripcion" class="form-input" id="nmDescripcion" placeholder="Ej: Primera quincena de octubre" />
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.Notas">Notas</label>
            <textarea asp-for="Input.Notas" class="form-input" rows="2"></textarea>
        </div>

        @if (Model.PideAutorizacion)
        {
            <div class="module-alert module-alert-warning">Este período ya tiene una nómina. Generarla otra vez paga dos veces: necesita un administrador.</div>
            <div class="form-row">
                <div class="form-field">
                    <label asp-for="Input.AutorizaUsuario">Usuario administrador</label>
                    <input asp-for="Input.AutorizaUsuario" class="form-input" autocomplete="off" />
                </div>
                <div class="form-field">
                    <label asp-for="Input.AutorizaClave">Contraseña</label>
                    <input asp-for="Input.AutorizaClave" type="password" value="" class="form-input" autocomplete="new-password" />
                </div>
            </div>
        }

        <div class="form-actions">
            <a asp-page="/RRHH/Nomina/Index" class="btn-secondary">Cancelar</a>
            <button type="submit" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                Generar nómina
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var clase = document.getElementById('nmClase'), tipo = document.getElementById('nmTipo'), anio = document.getElementById('nmAnio');
            var campoTipo = document.getElementById('nmCampoTipo'), campoAnio = document.getElementById('nmCampoAnio');
            var inicio = document.getElementById('nmInicio'), fin = document.getElementById('nmFin');

            // Al cambiar la planilla, las fechas son las de ese período (una quincenal no muestra todo el mes)
            function sugerir() {
                var decimo = clase.value !== 'Normal';
                campoTipo.hidden = decimo;
                tipo.required = !decimo;
                campoAnio.hidden = !decimo;
                inicio.readOnly = fin.readOnly = decimo;
                var url = '?handler=Sugerir&clase=' + encodeURIComponent(clase.value) + '&tipo=' + encodeURIComponent(tipo.value)
                    + (decimo && anio.value ? '&anio=' + encodeURIComponent(anio.value) : '');
                fetch(url, { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (d) {
                    inicio.value = d.inicio; fin.value = d.fin;
                    document.getElementById('nmPago').value = d.pago;
                    document.getElementById('nmDescripcion').value = d.descripcion;
                    if (d.anio) anio.value = d.anio;
                });
            }
            clase.addEventListener('change', function () { anio.value = ''; sugerir(); });
            tipo.addEventListener('change', sugerir);
            anio.addEventListener('change', sugerir);
            @if (!Model.PideAutorizacion && ViewData.ModelState.IsValid) { <text>sugerir();</text> }
        })();
    </script>
}
