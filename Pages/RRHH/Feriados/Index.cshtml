@page
@model Kirkenta.Pages.RRHH.Feriados.IndexModel
@{
    ViewData["Title"] = "Feriados";
}

<div class="module-header">
    <div class="module-header-left">
        <h2>Feriados</h2>
        <p>Calendario de días festivos por país</p>
    </div>
    <div class="module-header-right">
        @if (Model.PuedeCrear)
        {
            <a asp-page="/RRHH/Feriados/Create" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Nuevo feriado
            </a>
        }
        <a asp-page="/RRHH/Index" class="btn-secondary">Volver a RRHH</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="module-alert module-alert-success">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        @TempData["Success"]
    </div>
}

<div class="kpi-grid" style="margin-bottom: 20px;">
    <div class="kpi-card">
        <span class="kpi-label">Total este año</span>
        <span class="kpi-value">@Model.TotalEsteAnio</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Próximos</span>
        <span class="kpi-value" style="color: var(--color-primary);">@Model.TotalProximos</span>
    </div>
</div>

<div class="module-card">
    <div class="module-toolbar">
        <form method="get" style="display: flex; gap: 12px; flex: 1; flex-wrap: wrap; align-items: center;">
            <div class="form-field" style="margin: 0;">
                <label style="font-size: 12px; margin-bottom: 4px; display: block;">Año</label>
                <input type="number" name="anio" class="form-input" value="@DateTime.Today.Year" style="width: 120px;" />
            </div>
            <div class="form-field" style="margin: 0;">
                <label style="font-size: 12px; margin-bottom: 4px; display: block;">País</label>
                <select name="pais" class="form-input" style="width: 180px;">
                    @foreach (var p in Model.PaisesDisponibles)
                    {
                        if (p == Model.PaisEmpresa)
                        {
                            <option value="@p" selected>@p</option>
                        }
                        else
                        {
                            <option value="@p">@p</option>
                        }
                    }
                </select>
            </div>
            <div class="form-field" style="margin: 0;">
                <label>&nbsp;</label>
                <button type="submit" class="btn-primary btn-sm">Aplicar</button>
            </div>
        </form>
    </div>

    @if (Model.Feriados.Count == 0)
    {
        <div class="empty-state">
            <h3>No hay feriados registrados</h3>
            <p>Agrega manualmente o ejecuta el seeder al arrancar la app</p>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="erp-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>País</th>
                        <th>Recurrente</th>
                        <th>Móvil</th>
                        <th style="width: 100px; text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model.Feriados)
                    {
                        var esPasado = f.Fecha.Date < DateTime.Today;
                        <tr style="@(esPasado ? "opacity: 0.5;" : "")">
                            <td>
                                <strong>@f.Fecha.ToString("dd/MM/yyyy")</strong>
                                <br /><span class="table-user-sub">@f.Fecha.ToString("dddd", new System.Globalization.CultureInfo("es-HN"))</span>
                            </td>
                            <td>@f.Nombre</td>
                            <td>
                                @if (f.Tipo == "Nacional") { <span class="badge badge-info">Nacional</span> }
                                else if (f.Tipo == "Religioso") { <span class="badge badge-warning">Religioso</span> }
                                else if (f.Tipo == "Civico") { <span class="badge" style="background:#e0e7ff;color:#3730a3;">Cívico</span> }
                                else { <span class="badge">@f.Tipo</span> }
                            </td>
                            <td><span style="font-family: monospace;">@f.PaisCodigo</span></td>
                            <td>@(f.EsRecurrente ? "Sí" : "No")</td>
                            <td>@(f.EsMovil ? "Sí" : "No")</td>
                            <td>
                                <div class="table-actions">
                                    @if (Model.PuedeEditar)
                                    {
                                        <a asp-page="/RRHH/Feriados/Edit" asp-route-id="@f.Id" class="btn-icon-action" title="Editar">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                            </svg>
                                        </a>
                                    }
                                    @if (Model.PuedeEliminar)
                                    {
                                        <form method="post" asp-page-handler="Eliminar" asp-route-id="@f.Id" style="display:inline;" onsubmit="return confirm('¿Eliminar este feriado?');">
                                            <button type="submit" class="btn-icon-action btn-icon-action-danger" title="Eliminar">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="3 6 5 6 21 6"/>
                                                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                                </svg>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>