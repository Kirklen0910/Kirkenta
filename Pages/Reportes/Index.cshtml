@page
@model Kirkenta.Pages.Reportes.IndexModel
@{
    ViewData["Title"] = "Reportes";
}

<div class="module-header">
    <div class="module-header-left">
        <h2>Reportes</h2>
        <p>Centro de reportes y análisis del sistema</p>
    </div>
</div>

<div class="quick-grid">
    @if (Model.VerVentas)
    {
    <a asp-page="/Reportes/Ventas" class="quick-action" style="padding: 32px 20px;">
        <span class="quick-icon" style="font-size: 32px;">📈</span>
        <span class="quick-label" style="font-size: 15px;">Reportes de ventas</span>
        <span class="quick-label" style="font-size: 12px; color: var(--color-muted); font-weight: 400; margin-top: 4px;">
            Análisis de ventas por período, producto y cliente
        </span>
    </a>
    }

    @if (Model.VerVentas)
    {
    <a asp-page="/Reportes/VentasDetalle" class="quick-action" style="padding: 32px 20px;">
        <span class="quick-icon" style="font-size: 32px;">🗓️</span>
        <span class="quick-label" style="font-size: 15px;">Ventas por período</span>
        <span class="quick-label" style="font-size: 12px; color: var(--color-muted); font-weight: 400; margin-top: 4px;">
            Por día, método de pago, cajero y cliente, con descuentos y utilidad
        </span>
    </a>
    }

    @if (Model.VerRentabilidad)
    {
    <a asp-page="/Reportes/ProductosVendidos" class="quick-action" style="padding: 32px 20px;">
        <span class="quick-icon" style="font-size: 32px;">🏆</span>
        <span class="quick-label" style="font-size: 15px;">Productos vendidos</span>
        <span class="quick-label" style="font-size: 12px; color: var(--color-muted); font-weight: 400; margin-top: 4px;">
            Más y menos vendidos, ingresos y utilidad por producto
        </span>
    </a>
    }

    @if (Model.VerCompras)
    {
    <a asp-page="/Reportes/Compras" class="quick-action" style="padding: 32px 20px;">
        <span class="quick-icon" style="font-size: 32px;">🚚</span>
        <span class="quick-label" style="font-size: 15px;">Reportes de compras</span>
        <span class="quick-label" style="font-size: 12px; color: var(--color-muted); font-weight: 400; margin-top: 4px;">
            Compras por proveedor, producto y fecha
        </span>
    </a>
    }

    @if (Model.VerCxC)
    {
    <a asp-page="/Reportes/CuentasPorCobrar" class="quick-action" style="padding: 32px 20px;">
        <span class="quick-icon" style="font-size: 32px;">⏳</span>
        <span class="quick-label" style="font-size: 15px;">Antigüedad de saldos</span>
        <span class="quick-label" style="font-size: 12px; color: var(--color-muted); font-weight: 400; margin-top: 4px;">
            Cuentas por cobrar por cliente y días de vencimiento
        </span>
    </a>
    }

    @if (Model.VerCxP)
    {
    <a asp-page="/Reportes/CuentasPorPagar" class="quick-action" style="padding: 32px 20px;">
        <span class="quick-icon" style="font-size: 32px;">📤</span>
        <span class="quick-label" style="font-size: 15px;">Cuentas por pagar</span>
        <span class="quick-label" style="font-size: 12px; color: var(--color-muted); font-weight: 400; margin-top: 4px;">
            Saldos a proveedores y días de vencimiento
        </span>
    </a>
    }

    @if (Model.VerISV)
    {
    <a asp-page="/Reportes/LibroISV" class="quick-action" style="padding: 32px 20px;">
        <span class="quick-icon" style="font-size: 32px;">🧾</span>
        <span class="quick-label" style="font-size: 15px;">Libro de ISV</span>
        <span class="quick-label" style="font-size: 12px; color: var(--color-muted); font-weight: 400; margin-top: 4px;">
            Ventas gravadas y exentas por período, con ISV
        </span>
    </a>
    }

    @if (Model.VerISV)
    {
    <a asp-page="/Reportes/LibroCompras" class="quick-action" style="padding: 32px 20px;">
        <span class="quick-icon" style="font-size: 32px;">🧾</span>
        <span class="quick-label" style="font-size: 15px;">Libro de compras</span>
        <span class="quick-label" style="font-size: 12px; color: var(--color-muted); font-weight: 400; margin-top: 4px;">
            Compras recibidas con su ISV (crédito fiscal)
        </span>
    </a>
    }

    @if (Model.VerISV)
    {
    <a asp-page="/Reportes/DeclaracionISV" class="quick-action" style="padding: 32px 20px;">
        <span class="quick-icon" style="font-size: 32px;">🏛️</span>
        <span class="quick-label" style="font-size: 15px;">Declaración mensual de ISV</span>
        <span class="quick-label" style="font-size: 12px; color: var(--color-muted); font-weight: 400; margin-top: 4px;">
            ISV a pagar del mes: ventas menos compras, listo para el contador
        </span>
    </a>
    }

    @if (Model.VerInventario)
    {
    <a asp-page="/Reportes/Inventario" class="quick-action" style="padding: 32px 20px;">
        <span class="quick-icon" style="font-size: 32px;">📦</span>
        <span class="quick-label" style="font-size: 15px;">Valorización de inventario</span>
        <span class="quick-label" style="font-size: 12px; color: var(--color-muted); font-weight: 400; margin-top: 4px;">
            Existencias a costo y a precio de venta
        </span>
    </a>
    }

    @if (Model.VerRentabilidad)
    {
    <a asp-page="/Reportes/Rentabilidad" class="quick-action" style="padding: 32px 20px;">
        <span class="quick-icon" style="font-size: 32px;">💹</span>
        <span class="quick-label" style="font-size: 15px;">Rentabilidad de productos</span>
        <span class="quick-label" style="font-size: 12px; color: var(--color-muted); font-weight: 400; margin-top: 4px;">
            Utilidad y margen por producto, productos sin ventas y capital inmovilizado
        </span>
    </a>
    }
</div>
