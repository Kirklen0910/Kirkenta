@page
@model Kirkenta.Pages.Reportes.DeclaracionISVModel
@{
    ViewData["Title"] = "Declaración mensual de ISV";
    var r = Model.Resumen;
    string L(decimal v) => "L. " + v.ToString("N2");
    string N(decimal? v) => v?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ?? "";
    var aPagar = r.Resultado > 0;
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/Reportes/Index" class="back-link">← Volver a reportes</a>
        <h2>Declaración de ISV</h2>
        <p>@(char.ToUpper(Model.NombrePeriodo[0]) + Model.NombrePeriodo[1..]) · se arma sola con tus facturas y compras recibidas</p>
    </div>
    <div class="module-header-right">
        <a asp-page="/Reportes/DeclaracionISV" asp-page-handler="Csv" asp-route-anio="@Model.Anio" asp-route-mes="@Model.Mes" asp-route-saldofavor="@Model.SaldoFavor" asp-route-retenciones="@Model.Retenciones" class="btn-secondary">Exportar CSV</a>
        <button type="button" class="btn-secondary" onclick="window.print()">Imprimir</button>
        <a asp-page="/Finanzas/Impuestos/PagarIsv" asp-route-anio="@Model.Anio" asp-route-mes="@Model.Mes" asp-route-saldofavor="@Model.SaldoFavor" asp-route-retenciones="@Model.Retenciones" class="btn-primary">Registrar pago a la SAR</a>
    </div>
</div>

<form method="get" class="isv-filtros module-card">
    <div class="isv-campo">
        <label for="Mes">Mes</label>
        <select id="Mes" name="Mes" class="form-input" onchange="this.form.submit()">
            @for (int m = 1; m <= 12; m++)
            {
                var nombre = Kirkenta.Pages.Reportes.DeclaracionISVModel.Meses[m - 1];
                <option value="@m" selected="@(Model.Mes == m)">@(char.ToUpper(nombre[0]) + nombre[1..])</option>
            }
        </select>
    </div>
    <div class="isv-campo isv-campo-corto">
        <label for="Anio">Año</label>
        <input id="Anio" type="number" name="Anio" class="form-input" value="@Model.Anio" min="2000" max="2100" onchange="this.form.submit()" />
    </div>
    <div class="isv-campo">
        <label for="SaldoFavor" title="Si el mes pasado te quedó saldo a favor, se resta aquí">Saldo a favor anterior</label>
        <input id="SaldoFavor" type="number" step="0.01" min="0" name="SaldoFavor" class="form-input" placeholder="0.00" value="@N(Model.SaldoFavor)" />
    </div>
    <div class="isv-campo">
        <label for="Retenciones" title="ISV que tus clientes te retuvieron y te dieron constancia">Retenciones recibidas</label>
        <input id="Retenciones" type="number" step="0.01" min="0" name="Retenciones" class="form-input" placeholder="0.00" value="@N(Model.Retenciones)" />
    </div>
    <button type="submit" class="btn-primary">Calcular</button>
</form>

<div class="isv-resultado module-card @(aPagar ? "is-pagar" : "is-favor")">
    <div>
        <div class="isv-resultado-label">@(aPagar ? "ISV a pagar" : "Saldo a favor para el próximo mes")</div>
        <div class="isv-resultado-monto">@L(Math.Abs(r.Resultado))</div>
    </div>
    <dl class="isv-calculo">
        <div><dt>ISV de ventas</dt><dd>@L(r.IsvDebito)</dd></div>
        @if (r.IsvDevoluciones > 0) { <div><dt>− ISV de devoluciones</dt><dd>@L(r.IsvDevoluciones)</dd></div> }
        <div><dt>− ISV de compras</dt><dd>@L(r.IsvCredito)</dd></div>
        @if (r.SaldoFavorAnterior > 0) { <div><dt>− Saldo a favor anterior</dt><dd>@L(r.SaldoFavorAnterior)</dd></div> }
        @if (r.Retenciones > 0) { <div><dt>− Retenciones</dt><dd>@L(r.Retenciones)</dd></div> }
        <div class="isv-calculo-total"><dt>= @(aPagar ? "A pagar" : "A favor")</dt><dd>@L(Math.Abs(r.Resultado))</dd></div>
    </dl>
</div>

<div class="isv-columnas">
    <section class="module-card isv-bloque">
        <header>
            <h3>Ventas</h3>
            <span>ISV que cobraste</span>
        </header>
        <div class="isv-fila isv-fila-titulos"><span></span><span>Base</span><span>ISV</span></div>
        <div class="isv-fila"><span>Gravadas 15%</span><span>@L(r.VentasGravadas15)</span><span>@L(r.Isv15)</span></div>
        @if (r.VentasGravadas18 != 0 || r.Isv18 != 0) { <div class="isv-fila"><span>Gravadas 18%</span><span>@L(r.VentasGravadas18)</span><span>@L(r.Isv18)</span></div> }
        @if (r.VentasOtroGravado != 0 || r.IsvOtro != 0) { <div class="isv-fila"><span>Otras tasas</span><span>@L(r.VentasOtroGravado)</span><span>@L(r.IsvOtro)</span></div> }
        @if (r.VentasExentas != 0) { <div class="isv-fila isv-fila-suave"><span>Exentas</span><span>@L(r.VentasExentas)</span><span>—</span></div> }
        @if (r.VentasExoneradas != 0) { <div class="isv-fila isv-fila-suave"><span>Exoneradas</span><span>@L(r.VentasExoneradas)</span><span>—</span></div> }
        <div class="isv-fila isv-fila-total"><span>Débito fiscal</span><span></span><span>@L(r.IsvDebito)</span></div>
        <footer>
            @r.FacturasEmitidas factura(s)@(r.FacturasAnuladas > 0 ? $" · {r.FacturasAnuladas} anulada(s) no cuentan" : "")
            <a asp-page="/Reportes/LibroISV" asp-route-desde="@r.Desde.ToString("yyyy-MM-dd")" asp-route-hasta="@r.Hasta.ToString("yyyy-MM-dd")">Libro de ventas →</a>
        </footer>
    </section>

    <section class="module-card isv-bloque">
        <header>
            <h3>Compras</h3>
            <span>ISV que pagaste</span>
        </header>
        <div class="isv-fila isv-fila-titulos"><span></span><span>Base</span><span>ISV</span></div>
        <div class="isv-fila"><span>Gravadas</span><span>@L(r.ComprasGravadas)</span><span>@L(r.IsvCredito)</span></div>
        @if (r.ComprasExentas != 0) { <div class="isv-fila isv-fila-suave"><span>Exentas</span><span>@L(r.ComprasExentas)</span><span>—</span></div> }
        <div class="isv-fila isv-fila-total"><span>Crédito fiscal</span><span></span><span>@L(r.IsvCredito)</span></div>
        <footer>
            @r.Compras compra(s) recibida(s)
            <a asp-page="/Reportes/LibroCompras" asp-route-desde="@r.Desde.ToString("yyyy-MM-dd")" asp-route-hasta="@r.Hasta.ToString("yyyy-MM-dd")">Libro de compras →</a>
        </footer>
    </section>
</div>

<details class="isv-notas">
    <summary>Antes de declarar, revisa</summary>
    <ul>
        <li>El crédito fiscal solo cuenta compras <strong>recibidas</strong> en el sistema. Si faltan facturas de proveedores por registrar, el ISV a pagar saldrá más alto de lo real.</li>
        @if (r.Devoluciones > 0)
        {
            <li>Hubo devoluciones/notas de crédito por <strong>@L(r.Devoluciones)</strong> (ISV incluido); ya se restaron <strong>@L(r.IsvDevoluciones)</strong> del débito fiscal.</li>
        }
        <li>Es una ayuda para preparar la declaración: confirma los montos con tu contador antes de presentarla.</li>
    </ul>
</details>
