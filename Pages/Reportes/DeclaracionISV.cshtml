@page
@model Kirkenta.Pages.Reportes.DeclaracionISVModel
@{
    ViewData["Title"] = "Declaración mensual de ISV";
    var r = Model.Resumen;
    string L(decimal v) => "L. " + v.ToString("N2");
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/Reportes/Index" class="back-link">← Volver a reportes</a>
        <h2>Declaración mensual de ISV</h2>
        <p>Resumen de <strong>@Model.NombrePeriodo</strong> listo para tu contador o para declarar. Se arma solo con tus facturas y compras recibidas.</p>
    </div>
    <div class="module-header-right">
        <a asp-page="/Reportes/DeclaracionISV" asp-page-handler="Csv" asp-route-anio="@Model.Anio" asp-route-mes="@Model.Mes" asp-route-saldofavor="@Model.SaldoFavor" asp-route-retenciones="@Model.Retenciones" class="btn-secondary">Exportar CSV</a>
        <a asp-page="/Finanzas/Impuestos/PagarIsv" asp-route-anio="@Model.Anio" asp-route-mes="@Model.Mes" asp-route-saldofavor="@Model.SaldoFavor" asp-route-retenciones="@Model.Retenciones" class="btn-primary">Registrar pago a la SAR</a>
        <button type="button" class="btn-secondary" onclick="window.print()">Imprimir</button>
    </div>
</div>

<div class="module-card">
    <form method="get" class="module-toolbar" style="gap:12px;flex-wrap:wrap;align-items:flex-end;">
        <div class="form-field">
            <label for="Mes">Mes</label>
            <select id="Mes" name="Mes" class="form-input">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(Model.Mes == m)">@(char.ToUpper(Kirkenta.Pages.Reportes.DeclaracionISVModel.Meses[m - 1][0]) + Kirkenta.Pages.Reportes.DeclaracionISVModel.Meses[m - 1][1..])</option>
                }
            </select>
        </div>
        <div class="form-field"><label for="Anio">Año</label><input id="Anio" type="number" name="Anio" class="form-input" value="@Model.Anio" min="2000" max="2100" style="width:100px;" /></div>
        <div class="form-field"><label for="SaldoFavor">Saldo a favor del mes anterior (L.)</label><input id="SaldoFavor" type="number" step="0.01" min="0" name="SaldoFavor" class="form-input" value="@Model.SaldoFavor?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" /></div>
        <div class="form-field"><label for="Retenciones">Retenciones de ISV que te hicieron (L.)</label><input id="Retenciones" type="number" step="0.01" min="0" name="Retenciones" class="form-input" value="@Model.Retenciones?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" /></div>
        <div class="form-field"><button type="submit" class="btn-primary">Calcular</button></div>
    </form>
</div>

<div class="module-card" style="border-left:4px solid @(r.Resultado > 0 ? "var(--color-warning)" : "var(--color-success)");">
    <div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center;">
        <div>
            <div style="color:var(--color-muted);font-size:13px;">@(r.Resultado > 0 ? "ISV a pagar este mes" : "Saldo a favor para el próximo mes")</div>
            <div style="font-size:34px;font-weight:700;">@L(Math.Abs(r.Resultado))</div>
        </div>
        <div style="color:var(--color-muted);font-size:13px;max-width:440px;">
            ISV de ventas @L(r.IsvDebito)
            @if (r.IsvDevoluciones > 0) { <text> − ISV de devoluciones @L(r.IsvDevoluciones)</text> }
            − ISV de compras @L(r.IsvCredito)
            @if (r.SaldoFavorAnterior > 0) { <text> − saldo a favor anterior @L(r.SaldoFavorAnterior)</text> }
            @if (r.Retenciones > 0) { <text> − retenciones @L(r.Retenciones)</text> }
        </div>
    </div>
</div>

<div class="module-card">
    <h3 style="margin-top:0;">Ventas (ISV cobrado a tus clientes)</h3>
    <div class="table-wrapper">
        <table class="erp-table">
            <thead><tr><th>Concepto</th><th style="text-align:right;">Base</th><th style="text-align:right;">ISV</th></tr></thead>
            <tbody>
                <tr><td>Ventas gravadas al 15%</td><td style="text-align:right;">@L(r.VentasGravadas15)</td><td style="text-align:right;">@L(r.Isv15)</td></tr>
                <tr><td>Ventas gravadas al 18%</td><td style="text-align:right;">@L(r.VentasGravadas18)</td><td style="text-align:right;">@L(r.Isv18)</td></tr>
                @if (r.VentasOtroGravado != 0 || r.IsvOtro != 0)
                {
                    <tr><td>Otras tasas</td><td style="text-align:right;">@L(r.VentasOtroGravado)</td><td style="text-align:right;">@L(r.IsvOtro)</td></tr>
                }
                <tr><td>Ventas exentas</td><td style="text-align:right;">@L(r.VentasExentas)</td><td style="text-align:right;">—</td></tr>
                <tr><td>Ventas exoneradas</td><td style="text-align:right;">@L(r.VentasExoneradas)</td><td style="text-align:right;">—</td></tr>
            </tbody>
            <tfoot><tr><td colspan="2"><strong>ISV de ventas (débito fiscal)</strong></td><td style="text-align:right;"><strong>@L(r.IsvDebito)</strong></td></tr></tfoot>
        </table>
    </div>
    <p style="color:var(--color-muted);font-size:13px;margin:8px 0 0;">@r.FacturasEmitidas factura(s) emitida(s)@(r.FacturasAnuladas > 0 ? $" · {r.FacturasAnuladas} anulada(s) no cuentan" : "").
        <a asp-page="/Reportes/LibroISV" asp-route-desde="@r.Desde.ToString("yyyy-MM-dd")" asp-route-hasta="@r.Hasta.ToString("yyyy-MM-dd")">Ver el libro de ventas</a></p>
</div>

<div class="module-card">
    <h3 style="margin-top:0;">Compras (ISV que pagaste a tus proveedores)</h3>
    <div class="table-wrapper">
        <table class="erp-table">
            <thead><tr><th>Concepto</th><th style="text-align:right;">Base</th><th style="text-align:right;">ISV</th></tr></thead>
            <tbody>
                <tr><td>Compras gravadas</td><td style="text-align:right;">@L(r.ComprasGravadas)</td><td style="text-align:right;">@L(r.IsvCredito)</td></tr>
                <tr><td>Compras exentas</td><td style="text-align:right;">@L(r.ComprasExentas)</td><td style="text-align:right;">—</td></tr>
            </tbody>
            <tfoot><tr><td colspan="2"><strong>ISV de compras (crédito fiscal)</strong></td><td style="text-align:right;"><strong>@L(r.IsvCredito)</strong></td></tr></tfoot>
        </table>
    </div>
    <p style="color:var(--color-muted);font-size:13px;margin:8px 0 0;">@r.Compras compra(s) recibida(s) en el mes.
        <a asp-page="/Reportes/LibroCompras" asp-route-desde="@r.Desde.ToString("yyyy-MM-dd")" asp-route-hasta="@r.Hasta.ToString("yyyy-MM-dd")">Ver el libro de compras</a></p>
</div>

<div class="module-card" style="border-left:4px solid var(--color-info, var(--color-primary));">
    <strong>Antes de declarar, revisa:</strong>
    <ul style="margin:6px 0 0 18px;color:var(--color-muted);font-size:13px;">
        <li>El crédito fiscal solo cuenta compras <strong>recibidas</strong> en el sistema. Si tienes facturas de proveedores sin registrar, el ISV a pagar saldrá más alto de lo real.</li>
        @if (r.Devoluciones > 0)
        {
            <li>Hubo devoluciones/notas de crédito por <strong>@L(r.Devoluciones)</strong> este mes (con ISV incluido). Ya se restó <strong>@L(r.IsvDevoluciones)</strong> de ISV del débito fiscal; confírmalo con tu contador.</li>
        }
        <li>Este resumen es una ayuda para preparar la declaración; confirma los montos con tu contador antes de presentarla.</li>
    </ul>
</div>
