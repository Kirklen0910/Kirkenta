@page
@model Kirkenta.Pages.Reportes.ComprasModel
@{
    ViewData["Title"] = "Reportes de compras";
}

<div class="module-header">
    <div class="module-header-left">
        <h2>Reportes de compras</h2>
        <p>Análisis detallado de tus compras por proveedor, producto y período</p>
    </div>
</div>

<!-- Filtros -->
<div class="module-card" style="padding: 20px; margin-bottom: 20px;">
    <form method="get" class="reportes-filtros">
        <div class="filtros-row">
            <div class="form-field" style="margin: 0;">
                <label>Desde</label>
                <input type="date" name="desde" class="form-input" value="@Model.Desde.ToString("yyyy-MM-dd")" />
            </div>
            <div class="form-field" style="margin: 0;">
                <label>Hasta</label>
                <input type="date" name="hasta" class="form-input" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
            </div>
            <div class="form-field" style="margin: 0;">
                <label>Proveedor</label>
                <select name="proveedorId" class="form-input">
                    <option value="">Todos</option>
                    @foreach (var p in Model.Proveedores)
                    {
                        if (Model.FiltroProveedorId == p.Id)
                        {
                            <option value="@p.Id" selected>@p.Nombre</option>
                        }
                        else
                        {
                            <option value="@p.Id">@p.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="form-field" style="margin: 0;">
                <label>Producto</label>
                <input type="text" name="producto" class="form-input" placeholder="Nombre o SKU..." value="@Model.FiltroProducto" />
            </div>
            <div class="form-field" style="margin: 0;">
                <label>&nbsp;</label>
                <button type="submit" class="btn-primary">Aplicar</button>
            </div>
            <div class="form-field" style="margin: 0;">
                <label>&nbsp;</label>
                <a asp-page="/Reportes/Compras" class="btn-secondary">Limpiar</a>
            </div>
        </div>
    </form>
</div>

<!-- KPIs -->
<div class="kpi-grid" style="margin-bottom: 20px;">
    <div class="kpi-card">
        <span class="kpi-label">Total comprado</span>
        <span class="kpi-value">L. @Model.TotalComprado.ToString("N2")</span>
        <span class="kpi-trend">@Model.CantidadOrdenes órdenes</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Productos comprados</span>
        <span class="kpi-value">@Model.ProductosComprados</span>
        <span class="kpi-trend">Unidades totales</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Proveedores activos</span>
        <span class="kpi-value">@Model.ProveedoresActivos</span>
        <span class="kpi-trend">En el período</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Promedio por orden</span>
        <span class="kpi-value">L. @Model.PromedioOrden.ToString("N2")</span>
    </div>
</div>

<!-- Gráfico de compras por día -->
<div class="module-card" style="padding: 20px; margin-bottom: 20px;">
    <h3 class="panel-title" style="margin-bottom: 16px;">Compras por día en el período</h3>
    <div style="height: 320px;">
        <canvas id="chartComprasPorDia"></canvas>
    </div>
</div>

<!-- Gráficos: Top proveedores y Top productos -->
<div class="panel-grid" style="margin-bottom: 20px;">
    <div class="module-card" style="padding: 20px;">
        <h3 class="panel-title" style="margin-bottom: 16px;">🏢 Top 10 proveedores por volumen</h3>
        <div style="height: 320px;">
            <canvas id="chartTopProveedores"></canvas>
        </div>
    </div>
    <div class="module-card" style="padding: 20px;">
        <h3 class="panel-title" style="margin-bottom: 16px;">📦 Top 10 productos más comprados</h3>
        <div style="height: 320px;">
            <canvas id="chartTopProductos"></canvas>
        </div>
    </div>
</div>

<!-- Tabla: Detalle por proveedor -->
<div class="module-card" style="margin-bottom: 20px;">
    <div style="padding: 20px; border-bottom: 1px solid var(--color-border);">
        <h3 class="panel-title">Detalle por proveedor</h3>
        <p class="panel-muted">Compras agrupadas por cada proveedor</p>
    </div>
    <div class="table-wrapper">
        <table class="erp-table">
            <thead>
                <tr>
                    <th>Proveedor</th>
                    <th style="text-align: right;">Órdenes</th>
                    <th style="text-align: right;">Total comprado</th>
                    <th style="text-align: right;">Saldo pendiente</th>
                    <th style="text-align: right;">Última compra</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DetallePorProveedor.Count == 0)
                {
                    <tr><td colspan="5" style="text-align: center; padding: 40px; color: var(--color-muted);">Sin datos en el período</td></tr>
                }
                else
                {
                    @foreach (var d in Model.DetallePorProveedor)
                    {
                        <tr>
                            <td><strong>@d.NombreProveedor</strong></td>
                            <td style="text-align: right;">@d.CantidadOrdenes</td>
                            <td style="text-align: right;"><strong>L. @d.TotalComprado.ToString("N2")</strong></td>
                            <td style="text-align: right;">
                                @if (d.SaldoPendiente > 0)
                                {
                                    <span style="color: var(--color-danger); font-weight: 600;">L. @d.SaldoPendiente.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">Pagado</span>
                                }
                            </td>
                            <td style="text-align: right;">@d.UltimaCompra.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Tabla: Detalle por producto -->
<div class="module-card">
    <div style="padding: 20px; border-bottom: 1px solid var(--color-border);">
        <h3 class="panel-title">Detalle por producto</h3>
        <p class="panel-muted">Historial de compras por producto con precio de compra promedio</p>
    </div>
    <div class="table-wrapper">
        <table class="erp-table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th style="text-align: right;">Cantidad comprada</th>
                    <th style="text-align: right;">Precio mínimo</th>
                    <th style="text-align: right;">Precio máximo</th>
                    <th style="text-align: right;">Precio promedio</th>
                    <th style="text-align: right;">Último precio</th>
                    <th style="text-align: right;">Total invertido</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DetallePorProducto.Count == 0)
                {
                    <tr><td colspan="7" style="text-align: center; padding: 40px; color: var(--color-muted);">Sin datos en el período</td></tr>
                }
                else
                {
                    @foreach (var d in Model.DetallePorProducto)
                    {
                        <tr>
                            <td>
                                <strong>@d.NombreProducto</strong>
                                @if (!string.IsNullOrEmpty(d.SKU))
                                {
                                    <br /><span class="table-user-sub" style="font-family: monospace;">@d.SKU</span>
                                }
                            </td>
                            <td style="text-align: right;">@d.CantidadComprada</td>
                            <td style="text-align: right;">L. @d.PrecioMinimo.ToString("N2")</td>
                            <td style="text-align: right;">L. @d.PrecioMaximo.ToString("N2")</td>
                            <td style="text-align: right;"><strong>L. @d.PrecioPromedio.ToString("N2")</strong></td>
                            <td style="text-align: right;">
                                <span style="color: var(--color-primary); font-weight: 600;">L. @d.UltimoPrecio.ToString("N2")</span>
                            </td>
                            <td style="text-align: right;"><strong>L. @d.TotalInvertido.ToString("N2")</strong></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            var colorPrimario = '#4f46e5';
            var colorSecundario = '#10b981';

            // === Compras por día ===
            var comprasPorDia = JSON.parse('@Html.Raw(Model.ComprasPorDiaJson)');
            var ctxDia = document.getElementById('chartComprasPorDia');
            if (ctxDia && comprasPorDia.labels && comprasPorDia.labels.length > 0) {
                new Chart(ctxDia, {
                    type: 'line',
                    data: {
                        labels: comprasPorDia.labels,
                        datasets: [{
                            label: 'Compras (L.)',
                            data: comprasPorDia.data,
                            borderColor: colorPrimario,
                            backgroundColor: 'rgba(79, 70, 229, 0.1)',
                            borderWidth: 2,
                            tension: 0.3,
                            fill: true,
                            pointBackgroundColor: colorPrimario,
                            pointRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function (value) { return 'L. ' + value.toLocaleString(); }
                                }
                            }
                        }
                    }
                });
            }

            // === Top proveedores ===
            var topProv = JSON.parse('@Html.Raw(Model.TopProveedoresJson)');
            var ctxProv = document.getElementById('chartTopProveedores');
            if (ctxProv && topProv.labels && topProv.labels.length > 0) {
                new Chart(ctxProv, {
                    type: 'bar',
                    data: {
                        labels: topProv.labels,
                        datasets: [{
                            label: 'Total comprado (L.)',
                            data: topProv.data,
                            backgroundColor: colorPrimario,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        indexAxis: 'y',
                        plugins: { legend: { display: false } },
                        scales: { x: { beginAtZero: true } }
                    }
                });
            }

            // === Top productos ===
            var topProd = JSON.parse('@Html.Raw(Model.TopProductosJson)');
            var ctxProd = document.getElementById('chartTopProductos');
            if (ctxProd && topProd.labels && topProd.labels.length > 0) {
                new Chart(ctxProd, {
                    type: 'bar',
                    data: {
                        labels: topProd.labels,
                        datasets: [{
                            label: 'Cantidad comprada',
                            data: topProd.data,
                            backgroundColor: colorSecundario,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        indexAxis: 'y',
                        plugins: { legend: { display: false } },
                        scales: { x: { beginAtZero: true } }
                    }
                });
            }
        })();
    </script>
}