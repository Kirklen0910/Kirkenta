@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard">
    <div class="dashboard-header">
        <h1>Hola, @User.Identity?.Name 👋</h1>
        <p>Este es el resumen de tu operación según los permisos de tu rol</p>
    </div>

    @if (Model.SinAcceso)
    {
        <div class="module-card" style="padding: 28px;">
            <p style="margin:0; color: var(--color-muted);">Tu rol todavía no tiene indicadores asignados. Usa el menú de la izquierda para entrar a los módulos que tienes disponibles.</p>
        </div>
    }
    else
    {
        if (Model.Arranque != null)
        {
            var hechos = Model.Arranque.Count(p => p.Completo);
            var total = Model.Arranque.Count;
            <div class="module-card" style="padding:16px 18px;margin-bottom:14px">
                <div style="display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap">
                    <strong>🚀 Tu arranque en Kirkenta: @hechos de @total</strong>
                    <form method="post" asp-page-handler="OcultarArranque" style="margin:0">
                        <button type="submit" class="btn-secondary btn-sm" title="El asistente sigue en Configuración → Configuración inicial">Ocultar</button>
                    </form>
                </div>
                <div style="height:6px;background:var(--color-surface-2);border-radius:99px;overflow:hidden;margin:10px 0 12px">
                    <div style="height:100%;width:@(total == 0 ? 0 : hechos * 100 / total)%;background:var(--color-primary)"></div>
                </div>
                <ul style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:6px 18px;font-size:13px">
                    @foreach (var p in Model.Arranque)
                    {
                        <li style="@(p.Completo ? "color:var(--color-muted)" : "")">
                            @(p.Completo ? "✅" : "⬜")
                            @if (p.Completo) { <span style="text-decoration:line-through">@p.Titulo</span> }
                            else { <a href="@p.Pagina" style="text-decoration:underline">@p.Titulo</a> }
                            @if (p.Opcional && !p.Completo) { <small style="color:var(--color-muted)">(opcional)</small> }
                        </li>
                    }
                </ul>
            </div>
        }

        if (Model.Alertas.Any())
        {
            <div class="section">
                @foreach (var al in Model.Alertas)
                {
                    <div class="module-alert @(al.Nivel == "danger" ? "module-alert-error" : "module-alert-warning")" style="margin-bottom:8px;">
                        @al.Texto
                        @if (!string.IsNullOrEmpty(al.Pagina))
                        {
                            <a asp-page="@al.Pagina" style="margin-left:8px;text-decoration:underline;">Ver</a>
                        }
                    </div>
                }
            </div>
        }

        if (Model.Kpis.Any())
        {
            <div class="kpi-grid">
                @foreach (var k in Model.Kpis)
                {
                    <div class="kpi-card">
                        <span class="kpi-label">@k.Etiqueta</span>
                        <span class="kpi-value">@k.Valor</span>
                        <span class="kpi-trend @k.Clase">@k.Detalle</span>
                        @if (!string.IsNullOrEmpty(k.Pagina))
                        {
                            <a asp-page="@k.Pagina" style="font-size:12px;margin-top:6px;display:inline-block;">Ver detalle →</a>
                        }
                    </div>
                }
            </div>
        }

        if (Model.Accesos.Any())
        {
            <div class="section">
                <h2 class="section-title">Accesos rápidos</h2>
                <div class="quick-grid">
                    @foreach (var a in Model.Accesos)
                    {
                        <a asp-page="@a.Pagina" class="quick-action">
                            <span class="quick-icon">@a.Icono</span>
                            <span class="quick-label">@a.Etiqueta</span>
                        </a>
                    }
                </div>
            </div>
        }

        if (Model.MostrarVentas)
        {
            <div class="module-card" style="padding: 20px;">
                <h3 class="panel-title" style="margin-bottom: 16px;">Ventas de los últimos 7 días</h3>
                <div style="height: 300px;">
                    <canvas id="chartDashboardVentas"></canvas>
                </div>
            </div>
        }

        if (Model.MostrarVentas || Model.MostrarStockBajo)
        {
            <div class="panel-grid">
                @if (Model.MostrarVentas)
                {
                    <div class="module-card" style="padding: 20px;">
                        <h3 class="panel-title" style="margin-bottom: 16px;">🏆 Top 5 productos del mes</h3>
                        @if (Model.TopProductosMes.Count == 0)
                        {
                            <p style="color: var(--color-muted); text-align: center; padding: 40px;">Sin ventas este mes</p>
                        }
                        else
                        {
                            <div class="table-wrapper">
                                <table class="erp-table">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Producto</th>
                                            <th style="text-align: right;">Cantidad</th>
                                            <th style="text-align: right;">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var i = 1;
                                        }
                                        @foreach (var p in Model.TopProductosMes)
                                        {
                                            <tr>
                                                <td><strong>@i</strong></td>
                                                <td>@p.Nombre</td>
                                                <td style="text-align: right;">@p.Cantidad</td>
                                                <td style="text-align: right;"><strong>L. @p.Total.ToString("N2")</strong></td>
                                            </tr>
                                            i++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    <div class="module-card" style="padding: 20px;">
                        <h3 class="panel-title" style="margin-bottom: 16px;">📋 Últimas ventas</h3>
                        @if (Model.UltimasVentas.Count == 0)
                        {
                            <p style="color: var(--color-muted); text-align: center; padding: 40px;">Aún no hay ventas</p>
                        }
                        else
                        {
                            <div class="timeline">
                                @foreach (var v in Model.UltimasVentas)
                                {
                                    <div class="timeline-item">
                                        <div class="timeline-dot"></div>
                                        <div class="timeline-content">
                                            <div class="timeline-header">
                                                <strong>@v.Numero</strong>
                                                <span class="timeline-date">@v.Fecha.ToString("dd/MM HH:mm")</span>
                                            </div>
                                            <p class="timeline-detail">@v.ClienteNombre — <strong>L. @v.Total.ToString("N2")</strong></p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (Model.MostrarStockBajo)
                {
                    <div class="module-card" style="padding: 20px;">
                        <h3 class="panel-title" style="margin-bottom: 16px;">⚠️ Productos con stock bajo</h3>
                        <div class="table-wrapper">
                            <table class="erp-table">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th style="text-align: right;">Stock</th>
                                        <th style="text-align: right;">Mínimo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pb in Model.ProductosBajos)
                                    {
                                        <tr>
                                            <td>@pb.Nombre</td>
                                            <td style="text-align: right; color:var(--color-danger-text);"><strong>@pb.Stock.ToString("0.##")</strong></td>
                                            <td style="text-align: right;">@pb.Minimo.ToString("0.##")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@section Scripts {
    <script src="/lib/chartjs/chart.umd.min.js"></script>
    <script>
        (function () {
            var ventasData = @Html.Raw(Model.Ventas7DiasJson);
            var ctx = document.getElementById('chartDashboardVentas');
            if (ctx && ventasData.labels && ventasData.labels.length > 0) {
                if (window.Chart) { Chart.defaults.color = kkCss('--color-muted'); Chart.defaults.borderColor = kkCss('--color-border'); }
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ventasData.labels,
                        datasets: [{
                            label: 'Ventas (L.)',
                            data: ventasData.data,
                            backgroundColor: 'rgba(79, 70, 229, 0.85)',
                            borderRadius: 8,
                            borderSkipped: false
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (context) {
                                        return 'L. ' + context.parsed.y.toLocaleString('es-HN', { minimumFractionDigits: 2 });
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function (value) { return 'L. ' + value.toLocaleString(); }
                                }
                            }
                        }
                    }
                });
            }
        })();
    </script>
}