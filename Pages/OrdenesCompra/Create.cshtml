@page
@model Kirkenta.Pages.OrdenesCompra.CreateModel
@{
    ViewData["Title"] = "Nueva orden de compra";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/OrdenesCompra/Index" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Volver a órdenes
        </a>
        <h2>Nueva orden de compra</h2>
        <p>Número: <strong>@Model.NumeroPreview</strong></p>
    </div>
</div>

<form method="post" id="ordenForm">
    <input type="hidden" asp-for="Input.Id" />

    <div class="module-card form-card-wide">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="module-alert module-alert-error">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <partial name="_MensajesValidacion" />
            </div>
        }

        <h3 class="form-section-title">Datos de la orden</h3>

        <div class="form-row">
            <div class="form-field">
                <label>Proveedor *</label>
                <select asp-for="Input.ProveedorId" class="form-input" id="proveedorSelect" required>
                    <option value="">— Selecciona un proveedor —</option>
                    @foreach (var p in Model.Proveedores)
                    {
                        <option value="@p.Id" data-moneda="@p.MonedaId" data-condicion="@p.CondicionPago">@p.Nombre @(string.IsNullOrEmpty(p.RTN) ? "" : " - RTN: " + p.RTN)</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label>Moneda</label>
                <select asp-for="Input.MonedaId" class="form-input" id="monedaSelect">
                    @foreach (var m in Model.Monedas)
                    {
                        <option value="@m.Id" data-tipocambio="@m.TipoCambio" data-simbolo="@m.Simbolo">@m.Codigo - @m.Nombre (@m.Simbolo)</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.FechaEntregaEstimada">Fecha de entrega estimada</label>
                <input asp-for="Input.FechaEntregaEstimada" type="date" class="form-input" value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-dd")" />
            </div>
            <div class="form-field" id="estadoField">
                <label asp-for="Input.Estado">Estado inicial</label>
                <select asp-for="Input.Estado" class="form-input">
                    <option value="Borrador">Borrador</option>
                    <option value="Enviada">Enviada al proveedor</option>
                </select>
            </div>
        </div>

        <div class="form-field" style="margin-top:4px">
            <label style="display:flex;gap:8px;align-items:center;cursor:pointer;font-weight:600">
                <input type="checkbox" asp-for="Input.YaRecibida" id="yaRecibida" />
                Esta compra ya se hizo y la mercadería ya está recibida
            </label>
            <small style="color:var(--color-muted)">Úsalo cuando la compra se hizo por llamada: la orden se guarda como recibida, entra al inventario y se ajusta el costo.</small>
        </div>

        <div id="recibidaBox" style="display:none;border:1px solid var(--color-border);border-radius:10px;padding:14px;margin:8px 0 12px">
            <div class="form-row">
                <div class="form-field">
                    <label>N° de factura del proveedor *</label>
                    <input asp-for="Input.NumeroFacturaProveedor" class="form-input" maxlength="40" placeholder="000-001-01-00000000" />
                </div>
                <div class="form-field">
                    <label>Fecha de la factura</label>
                    <input asp-for="Input.FechaFacturaProveedor" type="date" class="form-input" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-field">
                    <label>Cómo calcular el nuevo costo</label>
                    <select asp-for="Input.MetodoCosto" class="form-input">
                        <option value="Promedio">Costo promedio ponderado (recomendado)</option>
                        <option value="Ultimo">Último costo de esta compra</option>
                    </select>
                </div>
                <div class="form-field">
                    <label style="display:flex;gap:8px;align-items:center;margin-top:26px;cursor:pointer">
                        <input type="checkbox" asp-for="Input.ActualizarPrecioVenta" />
                        Reajustar precio de venta manteniendo el margen
                    </label>
                </div>
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.Notas">Notas</label>
            <textarea asp-for="Input.Notas" class="form-input" rows="2" placeholder="Observaciones para el proveedor..."></textarea>
        </div>

        <div class="form-divider"></div>
        <h3 class="form-section-title">Productos a comprar</h3>

        <div id="habitualesBox" style="display:none;margin-bottom:10px">
            <small style="color:var(--color-muted)">Productos que ya le compraste a este proveedor (clic para agregar):</small>
            <div id="habitualesList" style="display:flex;flex-wrap:wrap;gap:6px;margin-top:6px"></div>
        </div>

        <div class="items-toolbar">
            <div class="search-box" style="max-width: 400px;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text" id="productoSearch" placeholder="Buscar producto por nombre o SKU..." />
            </div>
            <div id="productoResults" class="producto-results"></div>
        </div>

        <div class="table-wrapper" style="margin-top: 16px;">
            <table class="erp-table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th style="width: 100px;">Cantidad</th>
                        <th style="width: 130px;">Precio</th>
                        <th style="width: 100px;">Descuento</th>
                        <th style="width: 80px;">Imp.%</th>
                        <th style="width: 120px;">Total</th>
                        <th style="width: 50px;"></th>
                    </tr>
                </thead>
                <tbody id="itemsBody"></tbody>
            </table>
        </div>

        <div class="totales-panel">
            <div class="totales-row">
                <span>Subtotal:</span>
                <strong id="subtotal">L. 0.00</strong>
            </div>
            <div class="totales-row">
                <span>Descuento:</span>
                <strong id="descuentoTotal">L. 0.00</strong>
            </div>
            <div class="totales-row">
                <span>Impuestos:</span>
                <strong id="impuestosTotal">L. 0.00</strong>
            </div>
            <div class="totales-row totales-row-final">
                <span>TOTAL:</span>
                <strong id="totalFinal">L. 0.00</strong>
            </div>
        </div>

        <div class="form-actions">
            <a asp-page="/OrdenesCompra/Index" class="btn-secondary">Cancelar</a>
            <button type="submit" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span id="btnTexto">Crear orden</span>
            </button>
        </div>
    </div>
</form>

<input type="hidden" id="productosJson" value="@Model.ProductosJson" />
<input type="hidden" id="habitualesJson" value="@Model.HabitualesJson" />

@section Scripts {
    <script>
        (function () {
            var productos = JSON.parse(document.getElementById('productosJson').value || '[]');
            var items = [];
            var searchInput = document.getElementById('productoSearch');
            var resultsBox = document.getElementById('productoResults');
            var itemsBody = document.getElementById('itemsBody');
            var monedaSelect = document.getElementById('monedaSelect');

            function simboloMoneda() {
                var opt = monedaSelect.options[monedaSelect.selectedIndex];
                return opt?.dataset.simbolo || 'L.';
            }

            function formatMoney(n) {
                return simboloMoneda() + ' ' + (n || 0).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
            }

            function mostrarResultados(texto) {
                if (!texto || texto.length < 2) { resultsBox.style.display = 'none'; return; }
                var t = texto.toLowerCase();
                var filtrados = productos.filter(function (p) {
                    return p.nombre.toLowerCase().includes(t) || (p.sku || '').toLowerCase().includes(t);
                }).slice(0, 8);

                if (filtrados.length === 0) { resultsBox.style.display = 'none'; return; }

                resultsBox.innerHTML = filtrados.map(function (p) {
                    return '<div class="producto-result-item" data-id="' + p.id + '">' +
                        '<div><strong>' + escHtml(p.nombre) + '</strong><br><small>SKU: ' + escHtml(p.sku || '—') + ' | Costo: ' + formatMoney(p.precioCompra) + '</small></div>' +
                        '</div>';
                }).join('');
                resultsBox.style.display = 'block';

                resultsBox.querySelectorAll('.producto-result-item').forEach(function (el) {
                    el.addEventListener('click', function () {
                        var id = parseInt(this.dataset.id);
                        var prod = productos.find(function (p) { return p.id === id; });
                        if (prod) agregarItem(prod);
                        searchInput.value = '';
                        resultsBox.style.display = 'none';
                    });
                });
            }

            function agregarItem(prod) {
                var existente = items.find(function (i) { return i.productoId === prod.id; });
                if (existente) {
                    existente.cantidad++;
                } else {
                    items.push({
                        productoId: prod.id,
                        nombre: prod.nombre,
                        cantidad: 1,
                        precio: prod.precioCompra,
                        descuento: 0,
                        impuesto: prod.impuesto
                    });
                }
                renderItems();
            }

            function renderItems() {
                if (items.length === 0) {
                    itemsBody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:30px;color:var(--color-muted);">Agrega productos desde el buscador arriba</td></tr>';
                    actualizarTotales();
                    return;
                }

                itemsBody.innerHTML = items.map(function (item, idx) {
                    var subtotal = item.cantidad * item.precio - item.descuento;
                    var iva = subtotal * (item.impuesto / 100);
                    var total = subtotal + iva;

                    return '<tr>' +
                        '<td><strong>' + escHtml(item.nombre) + '</strong></td>' +
                        '<td><input type="number" min="0.0001" step="any" value="' + item.cantidad + '" data-idx="' + idx + '" data-field="cantidad" class="form-input" style="padding:6px 8px;text-align:center;" /></td>' +
                        '<td><input type="number" min="0" step="0.01" value="' + item.precio.toFixed(2) + '" data-idx="' + idx + '" data-field="precio" class="form-input" style="padding:6px 8px;" /></td>' +
                        '<td><input type="number" min="0" step="0.01" value="' + item.descuento.toFixed(2) + '" data-idx="' + idx + '" data-field="descuento" class="form-input" style="padding:6px 8px;" /></td>' +
                        '<td><input type="number" min="0" max="100" step="0.01" value="' + item.impuesto.toFixed(2) + '" data-idx="' + idx + '" data-field="impuesto" class="form-input" style="padding:6px 8px;text-align:center;" /></td>' +
                        '<td><strong>' + formatMoney(total) + '</strong></td>' +
                        '<td><button type="button" class="btn-icon-action btn-icon-action-danger" data-remove="' + idx + '">✕</button></td></tr>';
                }).join('');

                itemsBody.querySelectorAll('input[data-field]').forEach(function (input) {
                    input.addEventListener('change', function () {
                        var idx = parseInt(this.dataset.idx);
                        items[idx][this.dataset.field] = parseFloat(this.value) || 0;
                        renderItems();
                    });
                });
                itemsBody.querySelectorAll('[data-remove]').forEach(function (btn) {
                    btn.addEventListener('click', function () { items.splice(parseInt(this.dataset.remove), 1); renderItems(); });
                });
                actualizarTotales();
                actualizarHiddenInputs();
            }

            function actualizarTotales() {
                var subtotal = 0, descuento = 0, impuestos = 0, total = 0;
                items.forEach(function (item) {
                    var st = item.cantidad * item.precio - item.descuento;
                    var iv = st * (item.impuesto / 100);
                    subtotal += item.cantidad * item.precio;
                    descuento += item.descuento;
                    impuestos += iv;
                    total += st + iv;
                });
                document.getElementById('subtotal').textContent = formatMoney(subtotal);
                document.getElementById('descuentoTotal').textContent = formatMoney(descuento);
                document.getElementById('impuestosTotal').textContent = formatMoney(impuestos);
                document.getElementById('totalFinal').textContent = formatMoney(total);
            }

            function actualizarHiddenInputs() {
                var container = document.getElementById('hiddenItems');
                if (container) container.remove();
                var div = document.createElement('div');
                div.id = 'hiddenItems';
                items.forEach(function (item, idx) {
                    div.innerHTML += '<input type="hidden" name="Input.Items[' + idx + '].ProductoId" value="' + item.productoId + '" />' +
                        '<input type="hidden" name="Input.Items[' + idx + '].Cantidad" value="' + item.cantidad + '" />' +
                        '<input type="hidden" name="Input.Items[' + idx + '].PrecioUnitario" value="' + item.precio + '" />' +
                        '<input type="hidden" name="Input.Items[' + idx + '].Descuento" value="' + item.descuento + '" />' +
                        '<input type="hidden" name="Input.Items[' + idx + '].ImpuestoPorcentaje" value="' + item.impuesto + '" />';
                });
                document.getElementById('ordenForm').appendChild(div);
            }

            searchInput.addEventListener('input', function () { mostrarResultados(this.value); });
            document.addEventListener('click', function (e) {
                if (!resultsBox.contains(e.target) && e.target !== searchInput) resultsBox.style.display = 'none';
            });

            // Cambiar moneda recalcula
            monedaSelect.addEventListener('change', function () { renderItems(); });

            // Compra ya recibida: campos dinámicos
            var chk = document.getElementById('yaRecibida');
            function sincronizarRecibida() {
                var on = chk.checked;
                document.getElementById('recibidaBox').style.display = on ? 'block' : 'none';
                document.getElementById('estadoField').style.display = on ? 'none' : '';
                document.getElementById('btnTexto').textContent = on ? 'Registrar compra recibida' : 'Crear orden';
                var f = document.getElementById('Input_NumeroFacturaProveedor');
                if (f) f.required = on;
            }
            chk.addEventListener('change', sincronizarRecibida);
            sincronizarRecibida();

            // Autorelleno por proveedor: moneda y productos habituales con su último precio
            var habituales = JSON.parse(document.getElementById('habitualesJson').value || '[]');
            var provSel = document.getElementById('proveedorSelect');
            function alCambiarProveedor(aplicarMoneda) {
                var opt = provSel.options[provSel.selectedIndex];
                if (aplicarMoneda && opt && opt.dataset.moneda) {
                    var m = monedaSelect.querySelector('option[value="' + opt.dataset.moneda + '"]');
                    if (m) { monedaSelect.value = opt.dataset.moneda; renderItems(); }
                }
                var pid = parseInt(provSel.value) || 0;
                var lista = habituales.filter(function (h) { return h.proveedorId === pid; });
                var box = document.getElementById('habitualesBox');
                var cont = document.getElementById('habitualesList');
                cont.innerHTML = '';
                lista.forEach(function (h) {
                    var prod = productos.find(function (p) { return p.id === h.productoId; });
                    if (!prod) return;
                    var b = document.createElement('button');
                    b.type = 'button'; b.className = 'btn-secondary'; b.style.padding = '4px 10px'; b.style.fontSize = '12px';
                    b.textContent = '+ ' + prod.nombre;
                    b.addEventListener('click', function () {
                        var existia = items.some(function (i) { return i.productoId === prod.id; });
                        agregarItem(prod);
                        if (!existia) { var it = items.find(function (i) { return i.productoId === prod.id; }); if (it) { it.precio = h.precio; renderItems(); } }
                    });
                    cont.appendChild(b);
                });
                box.style.display = cont.children.length ? 'block' : 'none';
            }
            provSel.addEventListener('change', function () { alCambiarProveedor(true); });
            alCambiarProveedor(false);
        })();
    </script>
}