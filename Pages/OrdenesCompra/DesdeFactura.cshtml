@page
@model Kirkenta.Pages.OrdenesCompra.DesdeFacturaModel
@{
    ViewData["Title"] = "Orden de compra desde foto";
}

<style>
    .df-drop { border: 2px dashed var(--color-primary-border); background: var(--color-primary-soft); border-radius: 16px; padding: 28px 16px; text-align: center; cursor: pointer; }
    .df-drop:hover { border-color: var(--color-primary); }
    .df-drop .ic { font-size: 40px; }
    .df-prev { max-width: 100%; max-height: 320px; border-radius: 12px; border: 1px solid var(--color-border); margin-top: 12px; display: none; }
    .df-aviso { background: var(--color-warning-bg); border: 1px solid var(--color-warning-border); color: var(--color-warning-text); border-radius: 12px; padding: 10px 14px; font-size: 13px; margin-bottom: 14px; }
    .df-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 12px; }
    .df-tab input, .df-tab select { min-width: 70px; }
    .df-tab td { vertical-align: middle; }
    .df-leido { font-size: 12px; color: var(--color-muted); }
    .df-ok { color: var(--color-success-text); font-weight: 700; font-size: 12px; }
    .df-dudoso { color: var(--color-warning-text); font-weight: 700; font-size: 12px; }
    .df-nada { color: var(--color-danger-text); font-weight: 700; font-size: 12px; }
    .df-tot { display: flex; gap: 18px; justify-content: flex-end; flex-wrap: wrap; margin-top: 12px; font-size: 15px; }
    .df-tot b { font-size: 18px; }
    #dfMsg { display: none; }
    .df-spin { display: none; text-align: center; padding: 18px; color: var(--color-muted); }
</style>

<div class="module-header">
    <div class="module-header-left">
        <h2>Orden de compra desde foto</h2>
        <p>Toma una foto de la factura de tu proveedor. La IA propone los productos y precios; <strong>tú revisas y corriges</strong> antes de crear la orden (queda en Borrador).</p>
    </div>
    <a asp-page="/OrdenesCompra/Index" class="btn btn-secondary">← Órdenes de compra</a>
</div>

@if (!Model.IaActiva)
{
    <div class="module-card">
        <h3 style="margin-top:0;">La IA no está activada</h3>
        <p style="color:var(--color-muted);">Esta función necesita un modelo de IA que <strong>entienda imágenes</strong> (por ejemplo <code>llava</code> o <code>qwen2.5-vl</code> con Ollama, o <code>gpt-4o-mini</code> en un proveedor compatible con OpenAI).</p>
        @if (Model.EsAdmin)
        {
            <a asp-page="/Configuracion/AsistenteIA" class="btn btn-primary">Configurar la IA</a>
        }
        else
        {
            <p>Pide a un administrador que la configure en Configuración → Asistente con IA.</p>
        }
    </div>
}
else
{
    <div id="dfData" hidden data-proveedores="@Model.ProveedoresJson" data-productos="@Model.ProductosJson"></div>
    @Html.AntiForgeryToken()

    <div class="module-card" id="dfPaso1">
        <div class="df-aviso">🔒 La foto de la factura se envía al servidor de IA que tienes configurado para leerla. No se guarda en el sistema.</div>
        <label class="df-drop" for="dfArchivo">
            <div class="ic">📷</div>
            <strong>Tomar o elegir la foto de la factura</strong>
            <div style="color:var(--color-muted);font-size:13px;margin-top:4px;">JPG, PNG o WebP · de frente, con buena luz y que se lean todas las líneas</div>
        </label>
        <input type="file" id="dfArchivo" accept="image/*" capture="environment" style="display:none" />
        <img id="dfPrev" class="df-prev" alt="Vista previa de la factura" />
        <div class="df-spin" id="dfSpin">⏳ Leyendo la factura con IA… puede tardar hasta un par de minutos.</div>
        <div class="module-alert module-alert-error" id="dfErr" style="display:none;margin-top:12px;"></div>
        <div style="margin-top:14px;"><button type="button" class="btn btn-primary" id="dfLeer" disabled>✨ Leer factura</button></div>
    </div>

    <div id="dfPaso2" style="display:none">
        <div class="module-card">
            <h3 style="margin-top:0;">Datos de la factura</h3>
            <div class="df-grid">
                <div class="form-group"><label for="dfProv">Proveedor *</label><select id="dfProv" class="form-control"></select><div class="df-leido" id="dfProvLeido"></div></div>
                <div class="form-group"><label for="dfNum">N° de factura</label><input id="dfNum" class="form-control" maxlength="40" /></div>
                <div class="form-group"><label for="dfFecha">Fecha de la factura</label><input id="dfFecha" type="date" class="form-control" /></div>
            </div>
            <div class="module-alert module-alert-warning" id="dfDif" style="display:none;margin-top:10px;"></div>
        </div>

        <div class="module-card">
            <h3 style="margin-top:0;">Productos <span class="df-leido">· escribe para buscar y elige el producto de tu inventario</span></h3>
            <div class="table-responsive">
                <table class="data-table df-tab">
                    <thead><tr><th>Leído en la factura</th><th style="min-width:260px">Producto del sistema</th><th>Cantidad</th><th>Precio sin ISV</th><th>ISV %</th><th>Subtotal</th><th></th></tr></thead>
                    <tbody id="dfBody"></tbody>
                </table>
            </div>
            <datalist id="dfLista"></datalist>
            <div class="df-tot"><span>Subtotal: <b id="dfSub">L. 0.00</b></span><span>ISV: <b id="dfIsv">L. 0.00</b></span><span>Total: <b id="dfTot">L. 0.00</b></span></div>
            <p class="df-leido" style="text-align:right;margin:6px 0 0;">Si el precio de la factura ya incluye ISV, ajusta el precio o el % para que el total coincida.</p>
            <div class="module-alert module-alert-error" id="dfErr2" style="display:none;margin-top:12px;"></div>
            <div style="margin-top:14px;display:flex;gap:10px;flex-wrap:wrap;">
                <button type="button" class="btn btn-primary" id="dfCrear">✔ Crear orden de compra (Borrador)</button>
                <button type="button" class="btn btn-secondary" id="dfOtra">Leer otra foto</button>
            </div>
        </div>
    </div>

    <script src="~/js/factura-ia.js" asp-append-version="true"></script>
}
