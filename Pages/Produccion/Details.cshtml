@page "{id:int}"
@model Kirkenta.Pages.Produccion.DetailsModel
@{
    ViewData["Title"] = $"Orden {Model.Orden.Numero}";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/Produccion/Index" class="back-link">← Volver a órdenes</a>
        <h2>Orden @Model.Orden.Numero</h2>
        <p>@(Model.ProductoFinal?.Nombre ?? "Producto eliminado") · @Model.Orden.Fecha.ToString("dd/MM/yyyy")</p>
    </div>
    <div class="module-header-right">
        @if (Model.PuedeEditar && Model.Orden.Estado == "Planificada")
        {
            <a asp-page="/Produccion/Edit" asp-route-id="@Model.Orden.Id" class="btn-secondary">Editar</a>
        }
        <a asp-page="/Produccion/Calidad" asp-route-OrdenId="@Model.Orden.Id" class="btn-secondary">Inspección de calidad</a>
    </div>
</div>

@if (TempData["Success"] != null) { <div class="module-alert module-alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="module-alert module-alert-error">@TempData["Error"]</div> }

<div class="kpi-grid" style="margin-bottom: 20px;">
    <div class="kpi-card">
        <span class="kpi-label">Estado</span>
        <span class="kpi-value" style="font-size: 20px;">@(Model.Orden.Estado == "EnProceso" ? "En proceso" : Model.Orden.Estado)</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Cantidad planificada</span>
        <span class="kpi-value">@Model.Orden.Cantidad.ToString("0.##")</span>
        @if (Model.Orden.Estado == "Terminada") { <span class="kpi-trend">Producida: @Model.Orden.CantidadProducida.ToString("0.##")</span> }
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Costo de insumos</span>
        <span class="kpi-value">L. @Model.Orden.CostoTotal.ToString("N2")</span>
        @if (Model.Orden.Estado == "Terminada" && Model.Orden.CantidadProducida > 0)
        {
            <span class="kpi-trend">L. @((Model.Orden.CostoTotal / Model.Orden.CantidadProducida).ToString("N2")) por unidad</span>
        }
    </div>
</div>

@if (Model.PuedeEditar)
{
    <div class="module-card" style="padding: 20px; margin-bottom: 20px;">
        @if (Model.Orden.Estado == "Planificada")
        {
            if (!Model.InsumosSuficientes)
            {
                <div class="module-alert module-alert-warning">Hay insumos sin stock suficiente. Revisa la tabla antes de iniciar.</div>
            }
            <div style="display:flex; gap:10px;">
                <form method="post" asp-page-handler="Iniciar" asp-route-id="@Model.Orden.Id" onsubmit="return confirm('Se descontarán los insumos del inventario. ¿Iniciar producción?');">
                    <button type="submit" class="btn-primary">Iniciar producción</button>
                </form>
                <form method="post" asp-page-handler="Cancelar" asp-route-id="@Model.Orden.Id" onsubmit="return confirm('¿Cancelar la orden?');">
                    <button type="submit" class="btn-secondary">Cancelar orden</button>
                </form>
            </div>
        }
        else if (Model.Orden.Estado == "EnProceso")
        {
            <div style="display:flex; gap:10px; align-items:flex-end; flex-wrap: wrap;">
                <form method="post" asp-page-handler="Terminar" asp-route-id="@Model.Orden.Id" class="erp-form" style="display:flex; gap:10px; align-items:flex-end;">
                    <div class="form-field" style="margin:0;">
                        <label>Cantidad realmente producida</label>
                        <input name="cantidadProducida" type="number" step="0.0001" min="0.0001" value="@Model.Orden.Cantidad.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-input" required />
                    </div>
                    <button type="submit" class="btn-primary">Terminar y recibir en inventario</button>
                </form>
                <form method="post" asp-page-handler="Cancelar" asp-route-id="@Model.Orden.Id" onsubmit="return confirm('Se devolverán los insumos al inventario. ¿Cancelar?');">
                    <button type="submit" class="btn-secondary">Cancelar y devolver insumos</button>
                </form>
            </div>
        }
    </div>
}

<div class="module-card" style="margin-bottom: 20px;">
    <div style="padding: 16px 20px; font-weight: 600;">Insumos</div>
    <div class="table-wrapper">
        <table class="erp-table">
            <thead>
                <tr><th>Insumo</th><th style="text-align:right;">Cantidad</th><th style="text-align:right;">Stock actual</th><th style="text-align:right;">Costo unit.</th><th style="text-align:right;">Subtotal</th></tr>
            </thead>
            <tbody>
                @foreach (var i in Model.Insumos)
                {
                    var falta = Model.Orden.Estado == "Planificada" && (i.Producto == null || i.Producto.Stock < i.Detalle.Cantidad);
                    <tr>
                        <td>@(i.Producto?.Nombre ?? "Producto eliminado")</td>
                        <td style="text-align:right;">@i.Detalle.Cantidad.ToString("0.####")</td>
                        <td style="text-align:right; @(falta ? "color: var(--color-danger); font-weight:600;" : "")">@((i.Producto?.Stock ?? 0).ToString("0.##"))</td>
                        <td style="text-align:right;">L. @i.Detalle.CostoUnitario.ToString("N2")</td>
                        <td style="text-align:right;">L. @((i.Detalle.Cantidad * i.Detalle.CostoUnitario).ToString("N2"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="module-card">
    <div style="padding: 16px 20px; font-weight: 600;">Inspecciones de calidad</div>
    @if (Model.Inspecciones.Count == 0)
    {
        <div class="empty-state"><h3>Sin inspecciones para esta orden</h3></div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="erp-table">
                <thead><tr><th>Fecha</th><th style="text-align:right;">Inspeccionadas</th><th style="text-align:right;">Defectuosas</th><th>Resultado</th><th>Observaciones</th></tr></thead>
                <tbody>
                    @foreach (var q in Model.Inspecciones)
                    {
                        <tr>
                            <td>@q.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td style="text-align:right;">@q.CantidadInspeccionada.ToString("0.##")</td>
                            <td style="text-align:right;">@q.CantidadDefectuosa.ToString("0.##")</td>
                            <td><span class="badge @(q.Resultado == "Aprobado" ? "badge-success" : q.Resultado == "Rechazado" ? "badge-danger" : "badge-warning")">@q.Resultado</span></td>
                            <td>@q.Observaciones</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
