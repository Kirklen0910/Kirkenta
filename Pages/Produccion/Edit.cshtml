@page "{id:int?}"
@model Kirkenta.Pages.Produccion.EditModel
@{
    ViewData["Title"] = Model.EsNuevo ? "Nueva orden de producción" : "Editar orden de producción";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/Produccion/Index" class="back-link">← Volver a órdenes</a>
        <h2>@(Model.EsNuevo ? "Nueva orden de producción" : "Editar orden de producción")</h2>
        <p>Número: <strong>@Model.Numero</strong></p>
    </div>
</div>

<div class="module-card" style="padding: 28px;">
    <form method="post" class="erp-form" id="formOrden">
        <input type="hidden" asp-for="Input.Id" />
        <div asp-validation-summary="All" class="module-alert module-alert-error"></div>

        <div class="form-row">
            <div class="form-field">
                <label>Producto a fabricar *</label>
                <select asp-for="Input.ProductoId" class="form-input">
                    <option value="0">— Selecciona —</option>
                    @foreach (var p in Model.Productos)
                    {
                        <option value="@p.Id">@p.Nombre @(string.IsNullOrEmpty(p.SKU) ? "" : "(" + p.SKU + ")")</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label>Cantidad a producir *</label>
                <input asp-for="Input.Cantidad" type="number" step="0.0001" min="0" class="form-input" />
            </div>
        </div>
        <div class="form-row">
            <div class="form-field">
                <label>Fecha *</label>
                <input asp-for="Input.Fecha" type="date" class="form-input" />
            </div>
            <div class="form-field">
                <label>Notas</label>
                <input asp-for="Input.Notas" class="form-input" />
            </div>
        </div>

        <h3 class="form-section-title">Insumos / materia prima (total para esta orden)</h3>
        <div id="lineas">
            @for (var i = 0; i < Model.Input.Lineas.Count; i++)
            {
                <div class="form-row linea-insumo" style="align-items: flex-end;">
                    <div class="form-field">
                        <label>Insumo</label>
                        <select name="Input.Lineas[@i].ProductoId" class="form-input">
                            <option value="0">— Selecciona —</option>
                            @foreach (var p in Model.Productos)
                            {
                                <option value="@p.Id" selected="@(Model.Input.Lineas[i].ProductoId == p.Id)">@p.Nombre (stock: @p.Stock.ToString("0.##"))</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label>Cantidad</label>
                        <input name="Input.Lineas[@i].Cantidad" type="number" step="0.0001" min="0" class="form-input" value="@(Model.Input.Lineas[i].Cantidad?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                    </div>
                    <button type="button" class="btn-secondary btn-quitar">Quitar</button>
                </div>
            }
        </div>
        <button type="button" class="btn-secondary" id="btnAgregar">+ Agregar insumo</button>

        <div class="form-actions">
            <a asp-page="/Produccion/Index" class="btn-secondary">Cancelar</a>
            <button type="submit" class="btn-primary">Guardar orden</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var cont = document.getElementById('lineas');

            function reindexar() {
                var filas = cont.querySelectorAll('.linea-insumo');
                filas.forEach(function (fila, i) {
                    fila.querySelectorAll('select, input').forEach(function (el) {
                        el.name = el.name.replace(/Input\.Lineas\[\d+\]/, 'Input.Lineas[' + i + ']');
                    });
                });
            }

            document.getElementById('btnAgregar').addEventListener('click', function () {
                var filas = cont.querySelectorAll('.linea-insumo');
                var nueva = filas[filas.length - 1].cloneNode(true);
                nueva.querySelector('select').value = '0';
                nueva.querySelector('input').value = '';
                cont.appendChild(nueva);
                reindexar();
            });

            cont.addEventListener('click', function (e) {
                if (!e.target.classList.contains('btn-quitar')) return;
                var filas = cont.querySelectorAll('.linea-insumo');
                if (filas.length > 1) {
                    e.target.closest('.linea-insumo').remove();
                } else {
                    filas[0].querySelector('select').value = '0';
                    filas[0].querySelector('input').value = '';
                }
                reindexar();
            });

            document.getElementById('formOrden').addEventListener('submit', reindexar);
        })();
    </script>
}
