@page
@model Kirkenta.Pages.PagosProveedor.CreateModel
@{
    ViewData["Title"] = "Registrar pago a proveedor";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/PagosProveedor/Index" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Volver a pagos
        </a>
        <h2>Registrar pago</h2>
        <p>Número: <strong>@Model.NumeroPreview</strong></p>
    </div>
</div>

<div class="module-card form-card">
    <form method="post" class="erp-form">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="module-alert module-alert-error">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <span asp-validation-summary="ModelOnly"></span>
            </div>
        }

        <div class="form-field">
            <label asp-for="Input.OrdenCompraId">Orden de compra *</label>
            <select asp-for="Input.OrdenCompraId" class="form-input" id="ordenSelect" required>
                <option value="">— Selecciona una orden por pagar —</option>
                @foreach (var o in Model.OrdenesPorPagar)
                {
                    var prov = Model.Proveedores.FirstOrDefault(p => p.Id == o.ProveedorId);
                    <option value="@o.Id" data-saldo="@o.Saldo" data-proveedorid="@o.ProveedorId" data-proveedor="@prov?.Nombre">
                        @o.Numero — @prov?.Nombre — Saldo: L. @o.Saldo.ToString("N2")
                    </option>
                }
            </select>
            <small class="form-help">Solo aparecen órdenes recibidas con saldo pendiente</small>
        </div>

        <div class="form-field">
            <label>Proveedor</label>
            <input type="text" id="proveedorMostrar" class="form-input" readonly />
            <input type="hidden" asp-for="Input.ProveedorId" id="proveedorIdInput" />
        </div>

        <div class="form-field">
            <label>Saldo pendiente de la orden</label>
            <input type="text" id="saldoMostrar" class="form-input" readonly />
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.Monto">Monto a pagar *</label>
                <input asp-for="Input.Monto" type="number" step="0.01" min="0.01" class="form-input" id="montoInput" required />
            </div>
            <div class="form-field">
                <label asp-for="Input.MetodoPagoId">Método de pago *</label>
                <select asp-for="Input.MetodoPagoId" class="form-input" required>
                    @foreach (var m in Model.MetodosPago)
                    {
                        <option value="@m.Id">@m.Nombre</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.Referencia">Referencia / Nº de documento</label>
                <input asp-for="Input.Referencia" class="form-input" placeholder="Ej: cheque 001, transferencia, etc." />
            </div>
            <div class="form-field">
                <label asp-for="Input.MonedaId">Moneda *</label>
                <select asp-for="Input.MonedaId" class="form-input" required>
                    @foreach (var m in Model.Monedas)
                    {
                        <option value="@m.Id">@m.Codigo - @m.Nombre</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.Notas">Notas</label>
            <textarea asp-for="Input.Notas" class="form-input" rows="2"></textarea>
        </div>

        <div class="form-divider"></div>

        <div class="form-field">
            <label class="form-checkbox" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                <input asp-for="Input.RegistrarEnFinanzas" type="checkbox" checked />
                <span><strong>Registrar el egreso automáticamente en Finanzas</strong></span>
            </label>
            <small class="form-help">Se creará un movimiento de egreso en la cuenta bancaria por defecto, con la categoría "Pago a proveedores". Si lo desmarcas, podrás registrarlo manualmente después.</small>
        </div>

        <div class="form-actions">
            <a asp-page="/PagosProveedor/Index" class="btn-secondary">Cancelar</a>
            <button type="submit" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                Registrar pago
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var ordenSelect = document.getElementById('ordenSelect');
            var proveedorMostrar = document.getElementById('proveedorMostrar');
            var proveedorIdInput = document.getElementById('proveedorIdInput');
            var saldoMostrar = document.getElementById('saldoMostrar');
            var montoInput = document.getElementById('montoInput');

            function actualizar() {
                var opt = ordenSelect.options[ordenSelect.selectedIndex];
                if (!opt || !opt.value) {
                    proveedorMostrar.value = '';
                    proveedorIdInput.value = '';
                    saldoMostrar.value = '';
                    montoInput.value = '';
                    return;
                }
                var saldo = parseFloat(opt.dataset.saldo) || 0;
                proveedorMostrar.value = opt.dataset.proveedor || '';
                proveedorIdInput.value = opt.dataset.proveedorid || '';
                saldoMostrar.value = 'L. ' + saldo.toFixed(2);
                montoInput.value = saldo.toFixed(2);
                montoInput.max = saldo;
            }

            ordenSelect.addEventListener('change', actualizar);
            actualizar();
        })();
    </script>
}