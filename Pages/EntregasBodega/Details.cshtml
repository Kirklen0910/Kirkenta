@page "{id:int}"
@model Kirkenta.Pages.EntregasBodega.DetailsModel
@{
    ViewData["Title"] = $"Entrega {Model.Entrega.Numero}";
}

<style>
    .kk-ent { max-width: 820px; margin: 0 auto; }
    .kk-ent-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; padding-bottom: 18px; border-bottom: 1px solid var(--color-border); }
    .kk-ent-titulo { font-size: 11.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--color-muted); font-weight: 600; }
    .kk-ent-num { font-size: 26px; font-weight: 700; letter-spacing: -.01em; margin-top: 2px; }
    .kk-ent-fecha { color: var(--color-muted); font-size: 13px; margin-top: 2px; }
    .kk-ent-estado { font-size: 11.5px; font-weight: 700; padding: 4px 12px; border-radius: 99px; text-transform: uppercase; letter-spacing: .06em; }
    .kk-ent-ok { background: rgba(16,185,129,.14); color: #059669; }
    .kk-ent-anulado { background: rgba(239,68,68,.14); color: #dc2626; }
    .kk-ent-meta { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px 24px; padding: 20px 0; }
    .kk-ent-meta dt { font-size: 11.5px; color: var(--color-muted); font-weight: 500; margin: 0 0 2px; }
    .kk-ent-meta dd { margin: 0; font-size: 14px; font-weight: 600; }
    .kk-ent-meta a { color: inherit; text-decoration: none; border-bottom: 1px dotted var(--color-muted); }
    .kk-ent table { width: 100%; border-collapse: collapse; }
    .kk-ent th { text-align: left; font-size: 11.5px; font-weight: 600; color: var(--color-muted); text-transform: uppercase; letter-spacing: .05em; padding: 8px 0; border-bottom: 1px solid var(--color-border); }
    .kk-ent td { padding: 11px 0; border-bottom: 1px solid var(--color-border); font-size: 14px; }
    .kk-ent .r { text-align: right; }
    .kk-ent td a { color: inherit; text-decoration: none; }
    .kk-ent-pendiente { margin-top: 16px; font-size: 13px; color: var(--color-muted); }
    .kk-ent-firmas { display: none; gap: 60px; margin-top: 64px; }
    .kk-ent-firmas div { flex: 1; border-top: 1px solid #000; padding-top: 6px; font-size: 12px; text-align: center; }
    .kk-ent-anular { margin-top: 28px; padding-top: 18px; border-top: 1px dashed var(--color-border); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    @@media (max-width: 640px) { .kk-ent-meta { grid-template-columns: 1fr 1fr; } }
    @@media print {
        .kk-ent-firmas { display: flex; }
        .kk-ent-noprint { display: none !important; }
        .kk-ent { max-width: 100%; }
    }
</style>

<div class="module-header kk-ent-noprint">
    <div class="module-header-left">
        <a asp-page="/EntregasBodega/Index" class="back-link">← Volver a entregas</a>
    </div>
    <div class="module-header-right">
        <button type="button" class="btn-secondary" onclick="window.print()">Imprimir</button>
        @if (Model.Factura != null)
        {
            <a asp-page="/Facturas/Details" asp-route-id="@Model.Factura.Id" class="btn-secondary">Ver factura @Model.Factura.Numero</a>
        }
        <a asp-page="/Ventas/Details" asp-route-id="@Model.Venta.Id" class="btn-secondary">Ver venta @Model.Venta.Numero</a>
        @if (!Model.Entrega.Anulada && Model.PendienteVenta > 0)
        {
            <a asp-page="/EntregasBodega/Create" asp-route-ventaId="@Model.Venta.Id" class="btn-primary">Entregar lo que falta</a>
        }
    </div>
</div>

@if (TempData["Success"] != null) { <div class="module-alert module-alert-success kk-ent-noprint">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="module-alert module-alert-error kk-ent-noprint">@TempData["Error"]</div> }

<div class="module-card" style="padding: 28px;">
    <div class="kk-ent">
        <div class="kk-ent-head">
            <div>
                <div class="kk-ent-titulo">Comprobante de entrega</div>
                <div class="kk-ent-num">@Model.Entrega.Numero</div>
                <div class="kk-ent-fecha">@Model.Entrega.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            @if (Model.Entrega.Anulada)
            {
                <span class="kk-ent-estado kk-ent-anulado">Anulado</span>
            }
            else
            {
                <span class="kk-ent-estado kk-ent-ok kk-ent-noprint">Vigente</span>
            }
        </div>

        <dl class="kk-ent-meta">
            <div><dt>Cliente</dt><dd>
                @if (Model.Cliente != null) { <a asp-page="/Clientes/Details" asp-route-id="@Model.Cliente.Id">@Model.Cliente.Nombre</a> } else { <text>Consumidor final</text> }
            </dd></div>
            <div><dt>Factura</dt><dd>
                @if (Model.Factura != null) { <a asp-page="/Facturas/Details" asp-route-id="@Model.Factura.Id">@Model.Factura.Numero</a> } else { <text>Sin facturar</text> }
            </dd></div>
            <div><dt>Venta</dt><dd><a asp-page="/Ventas/Details" asp-route-id="@Model.Venta.Id">@Model.Venta.Numero</a></dd></div>
            <div><dt>Recibe</dt><dd>@(Model.Entrega.RecibidoPor ?? "—")</dd></div>
            <div><dt>Entregó (bodega)</dt><dd>@(Model.Usuario ?? "—")</dd></div>
        </dl>

        <table>
            <thead>
                <tr>
                    <th>Producto</th>
                    <th class="r">Entregado</th>
                    <th class="r">Vendido</th>
                    <th class="r">Pendiente</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model.Filas)
                {
                    <tr>
                        <td>@f.Producto</td>
                        <td class="r"><strong>@f.Cantidad.ToString("0.####")</strong></td>
                        <td class="r">@f.Vendida.ToString("0.####")</td>
                        <td class="r">@f.PendienteAhora.ToString("0.####")</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!string.IsNullOrEmpty(Model.Entrega.Notas))
        {
            <p style="margin-top:14px; font-size:13px;"><strong>Notas:</strong> @Model.Entrega.Notas</p>
        }

        <p class="kk-ent-pendiente">
            @if (Model.PendienteVenta > 0)
            {
                <text>Falta por entregar de esta venta: <strong>@Model.PendienteVenta.ToString("0.####")</strong> unidades.</text>
            }
            else
            {
                <text>Venta entregada por completo.</text>
            }
        </p>

        <div class="kk-ent-firmas">
            <div>Firma de quien recibe</div>
            <div>Firma de bodega</div>
        </div>

        @if (Model.Entrega.Anulada)
        {
            <p class="kk-ent-noprint" style="margin-top:18px; font-size:13px; color:#dc2626;">
                Anulado el @Model.Entrega.FechaAnulacion?.ToString("dd/MM/yyyy HH:mm") — @Model.Entrega.MotivoAnulacion
            </p>
        }

        @if (!Model.Entrega.Anulada && Model.PuedeAnular)
        {
            <form method="post" asp-page-handler="Anular" asp-route-id="@Model.Entrega.Id" class="kk-ent-anular kk-ent-noprint" onsubmit="return confirm('¿Anular este comprobante? Lo entregado volverá a quedar pendiente.');">
                <input type="text" name="motivo" class="form-input" required maxlength="200" placeholder="Motivo de la anulación" style="max-width:320px" />
                <button type="submit" class="btn-secondary" style="color:#b91c1c">Anular comprobante</button>
            </form>
        }
    </div>
</div>
