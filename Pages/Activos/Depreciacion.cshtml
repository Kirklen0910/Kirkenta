@page
@model Kirkenta.Pages.Activos.DepreciacionModel
@{
    ViewData["Title"] = "Depreciación de activos";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/Activos/Index" class="back-link">← Volver a activos</a>
        <h2>Depreciación mensual</h2>
        <p>Método de línea recta: (costo − valor residual) ÷ vida útil en meses</p>
    </div>
</div>

@if (TempData["Success"] != null) { <div class="module-alert module-alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="module-alert module-alert-error">@TempData["Error"]</div> }

<div class="module-card" style="margin-bottom: 20px;">
    <form method="get" class="module-toolbar">
        <div class="filter-group">
            <select name="Mes" class="filter-select">
                @for (var m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(Model.Mes == m)">@(new DateTime(2000, m, 1).ToString("MMMM"))</option>
                }
            </select>
            <input type="number" name="Anio" value="@Model.Anio" class="filter-select" style="width: 100px;" />
            <button type="submit" class="btn-secondary">Ver período</button>
        </div>
    </form>

    @if (Model.Lineas.Count == 0)
    {
        <div class="empty-state"><h3>No hay activos vigentes para este período</h3></div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="erp-table">
                <thead>
                    <tr><th>Código</th><th>Activo</th><th style="text-align:right;">Dep. acumulada</th><th style="text-align:right;">A depreciar</th><th>Estado</th></tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.Lineas)
                    {
                        <tr>
                            <td>@l.Activo.Codigo</td>
                            <td>@l.Activo.Nombre</td>
                            <td style="text-align:right;">L. @l.Activo.DepreciacionAcumulada.ToString("N2")</td>
                            <td style="text-align:right;">L. @l.Monto.ToString("N2")</td>
                            <td>
                                @if (l.YaDepreciado) { <span class="badge badge-success">Depreciado</span> }
                                else if (l.Monto <= 0) { <span class="badge badge-info">Totalmente depreciado</span> }
                                else { <span class="badge badge-warning">Pendiente</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div style="padding: 16px 20px; display:flex; justify-content: space-between; align-items:center;">
            <strong>Total a depreciar: L. @Model.TotalPendiente.ToString("N2")</strong>
            @if (Model.PuedeEjecutar && Model.TotalPendiente > 0)
            {
                <form method="post" asp-page-handler="Ejecutar" onsubmit="return confirm('¿Aplicar la depreciación de este período?');">
                    <input type="hidden" name="Anio" value="@Model.Anio" />
                    <input type="hidden" name="Mes" value="@Model.Mes" />
                    <button type="submit" class="btn-primary">Aplicar depreciación</button>
                </form>
            }
        </div>
    }
</div>

<div class="module-card">
    <div style="padding: 16px 20px; font-weight: 600;">Últimos períodos depreciados</div>
    @if (Model.Historial.Count == 0)
    {
        <div class="empty-state"><h3>Aún no hay depreciaciones aplicadas</h3></div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="erp-table">
                <thead><tr><th>Período</th><th>Activos</th><th style="text-align:right;">Total</th></tr></thead>
                <tbody>
                    @foreach (var h in Model.Historial)
                    {
                        <tr><td>@h.Mes.ToString("D2")/@h.Anio</td><td>@h.Activos</td><td style="text-align:right;">L. @h.Total.ToString("N2")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
