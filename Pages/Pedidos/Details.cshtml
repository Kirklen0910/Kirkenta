@page "{id:int}"
@model Kirkenta.Pages.Pedidos.DetailsModel
@{
    ViewData["Title"] = $"Pedido {Model.Pedido.Numero}";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/Pedidos/Index" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Volver a pedidos
        </a>
        <h2>Pedido @Model.Pedido.Numero</h2>
        <p>Creado el @Model.Pedido.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <div class="module-header-right" style="display:flex;gap:8px;flex-wrap:wrap;">
        <partial name="_WhatsAppPdf" model="@(new Kirkenta.Helpers.WhatsAppPdf(Model.Cliente.Telefono, Kirkenta.Helpers.WhatsAppHelper.MensajePedido(Model.EmpresaNombre, (string.IsNullOrWhiteSpace(Model.Cliente.Nombre) || Model.Cliente.Nombre!.Contains("consumidor final", StringComparison.OrdinalIgnoreCase) ? null : Model.Cliente.Nombre), Model.Pedido.Numero, Model.Pedido.Estado, Model.Pedido.Total), "Pedido-" + Model.Pedido.Numero + ".pdf"))" />
        @if (Model.Pedido.FacturaId != null)
        {
            <a asp-page="/Facturas/Details" asp-route-id="@Model.Pedido.FacturaId" class="btn-primary">Ver factura</a>
        }
        else if (Model.Pedido.Estado != "Cancelado")
        {
            <form method="post" asp-page-handler="Facturar" asp-route-id="@Model.Pedido.Id" style="display:inline;"
                  onsubmit="return confirm('¿Facturar este pedido? Se descontará el inventario.');">
                <button type="submit" class="btn-primary">Facturar pedido</button>
            </form>
        }
        @{
            var siguientes = Model.Pedido.Estado switch
            {
                "Pendiente" => new[] { "En preparacion", "Cancelado" },
                "En preparacion" => new[] { "Enviado", "Entregado", "Cancelado" },
                "Enviado" => new[] { "Entregado" },
                _ => Array.Empty<string>()
            };
        }
        @foreach (var s in siguientes)
        {
            if (s == "Cancelado" && Model.Pedido.FacturaId != null) { continue; }
            <form method="post" asp-page-handler="Estado" asp-route-id="@Model.Pedido.Id" style="display:inline;"
                  onsubmit="@(s == "Cancelado" ? "return confirm('¿Cancelar este pedido?');" : "return true;")">
                <input type="hidden" name="nuevoEstado" value="@s" />
                <button type="submit" class="btn-secondary">@(s == "En preparacion" ? "Pasar a preparación" : s == "Enviado" ? "Marcar enviado" : s == "Entregado" ? "Marcar entregado" : "Cancelar")</button>
            </form>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="module-alert module-alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="module-alert module-alert-error">@TempData["Error"]</div>
}

<div class="module-card" style="padding: 28px;" data-pdf-doc>
    <div class="cotizacion-header">
        <div class="cotizacion-info">
            <h3>Cliente</h3>
            <p><strong>@Model.Cliente.Nombre</strong></p>
            @if (!string.IsNullOrEmpty(Model.Cliente.RTN))
            {
                <p>RTN: @Model.Cliente.RTN</p>
            }
            @if (Model.Pedido.FechaEntrega.HasValue)
            {
                <p style="margin-top:8px;"><strong>Fecha de entrega:</strong> @Model.Pedido.FechaEntrega.Value.ToString("dd/MM/yyyy")</p>
            }
        </div>
        <div class="cotizacion-estado">
            <span class="badge @(Model.Pedido.Estado switch {
                "Entregado" => "badge-success",
                "Cancelado" => "badge-danger",
                "Enviado" => "badge-info",
                "En preparacion" => "badge-info",
                _ => "badge-warning"
            })" style="font-size: 13px; padding: 6px 14px;">
                @Model.Pedido.Estado
            </span>
        </div>
    </div>

    <div class="table-wrapper" style="margin-top: 24px;">
        <table class="erp-table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th style="text-align: right;">Cantidad</th>
                    <th style="text-align: right;">Precio</th>
                    <th style="text-align: right;">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    var prod = Model.Productos.FirstOrDefault(p => p.Id == item.ProductoId);
                    <tr>
                        <td>@(prod?.Nombre ?? "—")</td>
                        <td style="text-align: right;">@item.Cantidad</td>
                        <td style="text-align: right;">L. @item.PrecioUnitario.ToString("N2")</td>
                        <td style="text-align: right;"><strong>L. @item.Total.ToString("N2")</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="totales-panel" style="margin-top: 24px;">
        <div class="totales-row">
            <span>Subtotal:</span>
            <strong>L. @Model.Pedido.Subtotal.ToString("N2")</strong>
        </div>
        <div class="totales-row">
            <span>Descuento:</span>
            <strong>L. @Model.Pedido.Descuento.ToString("N2")</strong>
        </div>
        <div class="totales-row">
            <span>Impuestos:</span>
            <strong>L. @Model.Pedido.Impuestos.ToString("N2")</strong>
        </div>
        <div class="totales-row totales-row-final">
            <span>TOTAL:</span>
            <strong>L. @Model.Pedido.Total.ToString("N2")</strong>
        </div>
    </div>
</div>