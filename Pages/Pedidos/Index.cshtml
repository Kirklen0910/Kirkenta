@page
@model Kirkenta.Pages.Pedidos.IndexModel
@{
    ViewData["Title"] = "Pedidos";
}

<div class="module-header">
    <div class="module-header-left">
        <h2>Pedidos</h2>
        <p>Administra los pedidos de tus clientes</p>
    </div>
</div>

<div class="module-card">
    <div class="module-toolbar">
        <div class="search-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" id="searchInput" placeholder="Buscar por número o cliente..." />
        </div>
        <div class="filter-group">
            <select id="filterEstado" class="filter-select">
                <option value="">Todos los estados</option>
                <option value="Pendiente">Pendiente</option>
                <option value="En preparacion">En preparación</option>
                <option value="Enviado">Enviado</option>
                <option value="Entregado">Entregado</option>
                <option value="Cancelado">Cancelado</option>
            </select>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="module-alert module-alert-success">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            @TempData["Success"]
        </div>
    }

    @if (Model.Pedidos.Count == 0)
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13"/>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
            </svg>
            <h3>No hay pedidos</h3>
            <p>Los pedidos se generan al convertir cotizaciones aceptadas</p>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="erp-table" id="pedidosTable">
                <thead>
                    <tr>
                        <th>Número</th>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th>Entrega</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th style="width: 140px; text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Pedidos)
                    {
                        var cliente = Model.Clientes.FirstOrDefault(c => c.Id == p.ClienteId);
                        var badgeClass = p.Estado switch
                        {
                            "Pendiente" => "badge badge-warning",
                            "En preparacion" => "badge badge-info",
                            "Enviado" => "badge badge-info",
                            "Entregado" => "badge badge-success",
                            "Cancelado" => "badge badge-danger",
                            _ => "badge"
                        };
                        <tr data-numero="@p.Numero.ToLower()" data-cliente="@(cliente?.Nombre.ToLower() ?? "")" data-estado="@p.Estado">
                            <td><strong>@p.Numero</strong></td>
                            <td>@(cliente?.Nombre ?? "—")</td>
                            <td>@p.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@(p.FechaEntrega?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td><strong>L. @p.Total.ToString("N2")</strong></td>
                            <td><span class="@badgeClass">@p.Estado</span></td>
                            <td>
                                <div class="table-actions">
                                    <a asp-page="/Pedidos/Details" asp-route-id="@p.Id" class="btn-icon-action" title="Ver">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                            <circle cx="12" cy="12" r="3"/>
                                        </svg>
                                    </a>
                                    <a asp-page="/Pedidos/Edit" asp-route-id="@p.Id" class="btn-icon-action" title="Editar estado">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var searchInput = document.getElementById('searchInput');
            var filterEstado = document.getElementById('filterEstado');
            var table = document.getElementById('pedidosTable');
            if (!table) return;
            var rows = table.querySelectorAll('tbody tr');

            function filterRows() {
                var search = (searchInput?.value || '').toLowerCase().trim();
                var estado = filterEstado?.value || '';
                rows.forEach(function (row) {
                    var numero = row.dataset.numero || '';
                    var cliente = row.dataset.cliente || '';
                    var rowEstado = row.dataset.estado || '';
                    var matchSearch = !search || numero.includes(search) || cliente.includes(search);
                    var matchEstado = !estado || rowEstado === estado;
                    row.style.display = (matchSearch && matchEstado) ? '' : 'none';
                });
            }
            searchInput?.addEventListener('input', filterRows);
            filterEstado?.addEventListener('change', filterRows);
        })();
    </script>
}