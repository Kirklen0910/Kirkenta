@page
@model Kirkenta.Pages.Bajas.CreateModel
@{
    ViewData["Title"] = "Nueva baja";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/Bajas/Index" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Volver a bajas
        </a>
        <h2>Nueva baja</h2>
        <p>Número: <strong>@Model.NumeroPreview</strong></p>
    </div>
</div>

<div class="module-card form-card">
    <form method="post" class="erp-form">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="module-alert module-alert-error">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <span asp-validation-summary="ModelOnly"></span>
            </div>
        }

        <div class="module-alert" style="background: var(--color-warning-bg); border: 1px solid var(--color-warning-border); color: var(--color-warning); margin: 0 0 18px 0;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            <strong>Esta baja quedará como "Pendiente" hasta que un administrador la apruebe.</strong>
        </div>

        <div class="form-field">
            <label>Producto *</label>
            <div class="producto-search-wrapper">
                <input type="text"
                       id="productoSearch"
                       class="form-input"
                       placeholder="Buscar producto por nombre o SKU..."
                       autocomplete="off" />
                <input type="hidden" asp-for="Input.ProductoId" id="productoIdInput" />
                <div class="producto-search-results" id="productoResults"></div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.Cantidad">Cantidad a dar de baja *</label>
                <input asp-for="Input.Cantidad" type="number" step="0.01" min="0.01" class="form-input" id="cantidadInput" required />
                <small class="form-help" id="stockInfo"></small>
            </div>
            <div class="form-field">
                <label asp-for="Input.TipoBaja">Tipo de baja *</label>
                <select asp-for="Input.TipoBaja" class="form-input" required>
                    <option value="">— Selecciona —</option>
                    <option value="Dañado">Dañado</option>
                    <option value="Perdido">Perdido / Robado</option>
                    <option value="Vencido">Vencido</option>
                    <option value="Error de conteo">Error de conteo</option>
                    <option value="Muestra gratuita">Muestra gratuita</option>
                    <option value="Uso interno">Uso interno</option>
                    <option value="Devolución a proveedor">Devolución a proveedor</option>
                    <option value="Otro">Otro</option>
                </select>
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.Motivo">Motivo / Justificación *</label>
            <textarea asp-for="Input.Motivo" class="form-input" rows="3" placeholder="Explica detalladamente por qué se da de baja este producto..." required></textarea>
            <small class="form-help">Este motivo quedará registrado en la auditoría.</small>
        </div>

        <div class="form-divider"></div>
        <h3 class="form-section-title">Valor de la baja</h3>
        <p class="form-section-desc">Se calcula automáticamente según el costo del producto</p>

        <div class="totales-panel">
            <div class="totales-row">
                <span>Costo unitario:</span>
                <strong id="costoUnitario">L. 0.00</strong>
            </div>
            <div class="totales-row">
                <span>Cantidad:</span>
                <strong id="cantidadMostrar">0</strong>
            </div>
            <div class="totales-row totales-row-final">
                <span>VALOR TOTAL DE PÉRDIDA:</span>
                <strong id="valorTotal">L. 0.00</strong>
            </div>
        </div>

        <div class="form-actions">
            <a asp-page="/Bajas/Index" class="btn-secondary">Cancelar</a>
            <button type="submit" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                Solicitar baja
            </button>
        </div>
    </form>
</div>

<input type="hidden" id="productosJson" value="@Model.ProductosJson" />

@section Scripts {
    <script>
        (function () {
            var productos = JSON.parse(document.getElementById('productosJson').value || '[]');
            var productoSearch = document.getElementById('productoSearch');
            var productoResults = document.getElementById('productoResults');
            var productoIdInput = document.getElementById('productoIdInput');
            var cantidadInput = document.getElementById('cantidadInput');
            var costoUnitarioEl = document.getElementById('costoUnitario');
            var cantidadMostrarEl = document.getElementById('cantidadMostrar');
            var valorTotalEl = document.getElementById('valorTotal');
            var stockInfo = document.getElementById('stockInfo');

            var productoActual = null;

            function formatMoney(n) {
                return 'L. ' + (n || 0).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
            }

            // === Buscador de productos ===
            function buscarProductos(texto) {
                if (!texto || texto.length < 2) { productoResults.style.display = 'none'; return; }
                var t = texto.toLowerCase();
                var filtrados = productos.filter(function (p) {
                    return (p.nombre || '').toLowerCase().includes(t)
                        || (p.sku || '').toLowerCase().includes(t);
                }).slice(0, 8);

                if (filtrados.length === 0) {
                    productoResults.innerHTML = '<div class="producto-result-item" style="cursor:default; color: var(--color-muted); justify-content: center;">Sin resultados</div>';
                    productoResults.style.display = 'block';
                    return;
                }

                productoResults.innerHTML = filtrados.map(function (p) {
                    return '<div class="producto-result-item" data-id="' + p.id + '">' +
                        '<div><strong>' + p.nombre + '</strong>' +
                        (p.sku ? '<br><small>SKU: ' + p.sku + '</small>' : '') +
                        '<br><small>Stock actual: ' + p.stock + ' | Costo: ' + formatMoney(p.precioCompra) + '</small>' +
                        '</div></div>';
                }).join('');
                productoResults.style.display = 'block';

                productoResults.querySelectorAll('.producto-result-item[data-id]').forEach(function (el) {
                    el.addEventListener('click', function () {
                        var id = parseInt(this.dataset.id);
                        productoActual = productos.find(function (p) { return p.id === id; });
                        if (productoActual) {
                            productoIdInput.value = productoActual.id;
                            productoSearch.value = productoActual.nombre;
                            stockInfo.textContent = 'Stock disponible: ' + productoActual.stock;
                            actualizarValores();
                        }
                        productoResults.style.display = 'none';
                    });
                });
            }

            productoSearch.addEventListener('input', function () { buscarProductos(this.value); });
            productoSearch.addEventListener('focus', function () { if (this.value.length >= 2) buscarProductos(this.value); });

            document.addEventListener('click', function (e) {
                if (!productoResults.contains(e.target) && e.target !== productoSearch) {
                    productoResults.style.display = 'none';
                }
            });

            // === Calcular valores ===
            function actualizarValores() {
                if (!productoActual) {
                    costoUnitarioEl.textContent = 'L. 0.00';
                    cantidadMostrarEl.textContent = '0';
                    valorTotalEl.textContent = 'L. 0.00';
                    return;
                }

                var cantidad = parseFloat(cantidadInput.value) || 0;
                var costo = productoActual.precioCompra;

                costoUnitarioEl.textContent = formatMoney(costo);
                cantidadMostrarEl.textContent = cantidad;
                valorTotalEl.textContent = formatMoney(costo * cantidad);

                // Validar que no exceda el stock
                if (cantidad > productoActual.stock) {
                    cantidadInput.style.borderColor = 'var(--color-danger)';
                    stockInfo.style.color = 'var(--color-danger)';
                    stockInfo.textContent = '⚠️ Cantidad excede el stock disponible (' + productoActual.stock + ')';
                } else {
                    cantidadInput.style.borderColor = '';
                    stockInfo.style.color = '';
                    stockInfo.textContent = 'Stock disponible: ' + productoActual.stock;
                }
            }

            cantidadInput.addEventListener('input', actualizarValores);
        })();
    </script>
}