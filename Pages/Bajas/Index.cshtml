@page
@model Kirkenta.Pages.Bajas.IndexModel
@{
    ViewData["Title"] = "Bajas de inventario";
}

<div class="module-header">
    <div class="module-header-left">
        <h2>Bajas de inventario</h2>
        <p>Registro de productos dados de baja por daño, pérdida, vencimiento u otros</p>
    </div>
    <div class="module-header-right">
        <a asp-page="/Conversiones/Index" class="btn-secondary" title="Fraccionar un producto en otro sin registrar pérdida">Conversiones</a>
        @if (Model.PuedeCrear)
        {
        <a asp-page="/Bajas/Create" class="btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Nueva baja
        </a>
        }
    </div>
</div>

<!-- KPIs -->
<div class="kpi-grid" style="margin-bottom: 20px;">
    <div class="kpi-card">
        <span class="kpi-label">Bajas este mes</span>
        <span class="kpi-value">@Model.BajasMes</span>
        <span class="kpi-trend">@Model.BajasMesValor.ToString("C") perdidos</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Pendientes de aprobación</span>
        <span class="kpi-value" style="color: var(--color-warning);">@Model.Pendientes</span>
        <span class="kpi-trend">Requieren revisión</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Total histórico</span>
        <span class="kpi-value">@Model.TotalHistorico</span>
        <span class="kpi-trend down">@Model.TotalHistoricoValor.ToString("C") acumulado</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Aprobadas</span>
        <span class="kpi-value" style="color: var(--color-success);">@Model.Aprobadas</span>
        <span class="kpi-trend up">Con impacto en inventario</span>
    </div>
</div>

<div class="module-card">
    <form method="get" class="module-toolbar">
        <div class="search-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" name="Q" value="@Model.Q" placeholder="Buscar por número, producto o motivo..." />
        </div>
        <div class="filter-group">
            <select name="Estado" class="filter-select">
                <option value="">Todos los estados</option>
                <option value="Pendiente" selected="@(Model.Estado == "Pendiente")">Pendiente</option>
                <option value="Aprobada" selected="@(Model.Estado == "Aprobada")">Aprobada</option>
                <option value="Rechazada" selected="@(Model.Estado == "Rechazada")">Rechazada</option>
            </select>
            <select name="Tipo" class="filter-select">
                <option value="">Todos los tipos</option>
                <option value="Dañado" selected="@(Model.Tipo == "Dañado")">Dañado</option>
                <option value="Perdido" selected="@(Model.Tipo == "Perdido")">Perdido / Robado</option>
                <option value="Vencido" selected="@(Model.Tipo == "Vencido")">Vencido</option>
                <option value="Error de conteo" selected="@(Model.Tipo == "Error de conteo")">Error de conteo</option>
                <option value="Muestra gratuita" selected="@(Model.Tipo == "Muestra gratuita")">Muestra gratuita</option>
                <option value="Uso interno" selected="@(Model.Tipo == "Uso interno")">Uso interno</option>
                <option value="Devolución a proveedor" selected="@(Model.Tipo == "Devolución a proveedor")">Devolución a proveedor</option>
                <option value="Otro" selected="@(Model.Tipo == "Otro")">Otro</option>
            </select>
            <button type="submit" class="btn-secondary">Filtrar</button>
            <a asp-page="/Bajas/Index" class="btn-secondary">Limpiar</a>
        </div>
    </form>

    @if (TempData["Success"] != null)
    {
        <div class="module-alert module-alert-success">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="module-alert module-alert-error">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            @TempData["Error"]
        </div>
    }

    @if (Model.Bajas.Count == 0)
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"/>
                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
            </svg>
            <h3>No hay bajas registradas</h3>
            <p>Registra la primera baja cuando un producto se dañe o pierda</p>
            @if (Model.PuedeCrear)
            {
            <a asp-page="/Bajas/Create" class="btn-primary">Registrar baja</a>
            }
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="erp-table" id="bajasTable">
                <thead>
                    <tr>
                        <th>Número</th>
                        <th>Fecha</th>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Tipo</th>
                        <th>Valor</th>
                        <th>Estado</th>
                        <th style="width: 180px; text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Bajas)
                    {
                        var prod = Model.Productos.FirstOrDefault(p => p.Id == b.ProductoId);
                        var badgeClass = b.Estado switch
                        {
                            "Pendiente" => "badge badge-warning",
                            "Aprobada" => "badge badge-success",
                            "Rechazada" => "badge badge-danger",
                            _ => "badge"
                        };
                        <tr data-numero="@b.Numero.ToLower()"
                            data-producto="@(prod?.Nombre.ToLower() ?? "")"
                            data-motivo="@b.Motivo.ToLower()"
                            data-estado="@b.Estado"
                            data-tipo="@b.TipoBaja">
                            <td><strong>@b.Numero</strong></td>
                            <td>@b.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(prod?.Nombre ?? "—")</td>
                            <td><strong>@b.Cantidad</strong></td>
                            <td>
                                <span class="badge badge-info">@b.TipoBaja</span>
                            </td>
                            <td><strong>L. @b.ValorTotal.ToString("N2")</strong></td>
                            <td><span class="@badgeClass">@b.Estado</span></td>
                            <td>
                                <div class="table-actions">
                                    <a asp-page="/Bajas/Details" asp-route-id="@b.Id" class="btn-icon-action" title="Ver detalle">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                            <circle cx="12" cy="12" r="3"/>
                                        </svg>
                                    </a>
                                    @if (b.Estado == "Pendiente" && Model.PuedeAprobar)
                                    {
                                        <a asp-page="/Bajas/Aprobar" asp-route-id="@b.Id" class="btn-icon-action" title="Aprobar / Rechazar" style="color: var(--color-warning);">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"/>
                                            </svg>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="Model.Pager" />
    }
</div>
