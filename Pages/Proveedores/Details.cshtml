@page "{id:int}"
@model Kirkenta.Pages.Proveedores.DetailsModel
@{
    ViewData["Title"] = $"Proveedor: {Model.Proveedor.Nombre}";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/Proveedores/Index" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Volver a proveedores
        </a>
        <h2>@Model.Proveedor.Nombre</h2>
        <p>@Model.Proveedor.Codigo • @(Model.Proveedor.Activo ? "Activo" : "Inactivo")</p>
    </div>
    <div class="module-header-right">
        <a asp-page="/Proveedores/Edit" asp-route-id="@Model.Proveedor.Id" class="btn-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
            Editar
        </a>
    </div>
</div>

<!-- KPIs del proveedor -->
<div class="kpi-grid" style="margin-bottom: 20px;">
    <div class="kpi-card">
        <span class="kpi-label">Total comprado</span>
        <span class="kpi-value">L. @Model.TotalComprado.ToString("N2")</span>
        <span class="kpi-trend">@Model.CantidadCompras órdenes</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Saldo pendiente</span>
        <span class="kpi-value" style="color: @(Model.SaldoPendiente > 0 ? "var(--color-danger)" : "var(--color-success)");">
            L. @Model.SaldoPendiente.ToString("N2")
        </span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Última compra</span>
        <span class="kpi-value" style="font-size: 18px;">
            @(Model.UltimaCompra?.ToString("dd/MM/yyyy") ?? "Sin compras")
        </span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Condición de pago</span>
        <span class="kpi-value" style="font-size: 18px;">
            @if (Model.Proveedor.CondicionPago == "Credito")
            {
                <span>@Model.Proveedor.DiasCredito días</span>
            }
            else
            {
                <span>Contado</span>
            }
        </span>
    </div>
</div>

<div class="empresa-layout">
    <div class="module-card empresa-info-card">
        <h3 class="form-section-title">Información de contacto</h3>

        <div class="empresa-info-grid">
            <div class="empresa-info-item empresa-info-full">
                <span class="empresa-info-label">Nombre</span>
                <span class="empresa-info-value">@Model.Proveedor.Nombre</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.Proveedor.RazonSocial))
            {
                <div class="empresa-info-item empresa-info-full">
                    <span class="empresa-info-label">Razón social</span>
                    <span class="empresa-info-value">@Model.Proveedor.RazonSocial</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.Proveedor.RTN))
            {
                <div class="empresa-info-item">
                    <span class="empresa-info-label">RTN</span>
                    <span class="empresa-info-value">@Model.Proveedor.RTN</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.Proveedor.Contacto))
            {
                <div class="empresa-info-item">
                    <span class="empresa-info-label">Contacto</span>
                    <span class="empresa-info-value">@Model.Proveedor.Contacto</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.Proveedor.Telefono))
            {
                <div class="empresa-info-item">
                    <span class="empresa-info-label">Teléfono</span>
                    <span class="empresa-info-value">@Model.Proveedor.Telefono</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.Proveedor.Email))
            {
                <div class="empresa-info-item">
                    <span class="empresa-info-label">Email</span>
                    <span class="empresa-info-value">@Model.Proveedor.Email</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.Proveedor.Direccion))
            {
                <div class="empresa-info-item empresa-info-full">
                    <span class="empresa-info-label">Dirección</span>
                    <span class="empresa-info-value">@Model.Proveedor.Direccion</span>
                </div>
            }
        </div>

        <div class="form-divider"></div>
        <h3 class="form-section-title">Condiciones comerciales</h3>

        <div class="empresa-info-grid">
            <div class="empresa-info-item">
                <span class="empresa-info-label">Condición de pago</span>
                <span class="empresa-info-value">
                    @if (Model.Proveedor.CondicionPago == "Credito")
                    {
                        <span class="badge badge-warning">@Model.Proveedor.DiasCredito días de crédito</span>
                    }
                    else
                    {
                        <span class="badge badge-info">Contado</span>
                    }
                </span>
            </div>
            @if (Model.Proveedor.LimiteCredito > 0)
            {
                <div class="empresa-info-item">
                    <span class="empresa-info-label">Límite de crédito</span>
                    <span class="empresa-info-value">L. @Model.Proveedor.LimiteCredito.ToString("N2")</span>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.Proveedor.Banco) || !string.IsNullOrEmpty(Model.Proveedor.CuentaBancaria))
        {
            <div class="form-divider"></div>
            <h3 class="form-section-title">Datos bancarios</h3>

            <div class="empresa-info-grid">
                @if (!string.IsNullOrEmpty(Model.Proveedor.Banco))
                {
                    <div class="empresa-info-item">
                        <span class="empresa-info-label">Banco</span>
                        <span class="empresa-info-value">@Model.Proveedor.Banco</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Proveedor.CuentaBancaria))
                {
                    <div class="empresa-info-item">
                        <span class="empresa-info-label">Cuenta</span>
                        <span class="empresa-info-value" style="font-family: monospace;">@Model.Proveedor.CuentaBancaria</span>
                    </div>
                }
            </div>
        }
    </div>

    <div class="module-card" style="padding: 24px;">
        <h3 class="form-section-title">Historial de compras</h3>
        <p class="form-section-desc">Últimas órdenes de compra a este proveedor</p>

        @if (Model.UltimasOrdenes.Count == 0)
        {
            <div class="empty-state" style="padding: 40px 20px;">
                <p style="font-size: 13px; color: var(--color-muted);">Sin compras registradas</p>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table class="erp-table">
                    <thead>
                        <tr>
                            <th>Número</th>
                            <th>Fecha</th>
                            <th>Total</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var oc in Model.UltimasOrdenes)
                        {
                            <tr>
                                <td><strong>@oc.Numero</strong></td>
                                <td>@oc.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>L. @oc.Total.ToString("N2")</td>
                                <td>
                                    @if (oc.Estado == "Recibida")
                                    {
                                        <span class="badge badge-success">@oc.Estado</span>
                                    }
                                    else if (oc.Estado == "Cancelada")
                                    {
                                        <span class="badge badge-danger">@oc.Estado</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">@oc.Estado</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>