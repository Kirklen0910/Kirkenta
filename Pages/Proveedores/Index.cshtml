@page
@model Kirkenta.Pages.Proveedores.IndexModel
@{
    ViewData["Title"] = "Proveedores";
}

<div class="module-header">
    <div class="module-header-left">
        <h2>Proveedores</h2>
        <p>Administra tus proveedores y sus condiciones de compra</p>
    </div>
    <div class="module-header-right">
        <a asp-page="/Proveedores/Create" class="btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Nuevo proveedor
        </a>
        @if (Model.PuedeImportar)
        {
            <a asp-page="/Proveedores/Import" class="btn-secondary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="17 8 12 3 7 8"/>
                    <line x1="12" y1="3" x2="12" y2="15"/>
                </svg>
                Importar
            </a>
        }
        @if (Model.PuedeExportar)
        {
            <button type="button" class="btn-secondary" onclick="mostrarOpcionesExport()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                Exportar
            </button>
        }
    </div>
</div>

<div class="module-card">
    <div class="module-toolbar">
        <div class="search-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" id="searchInput" placeholder="Buscar por nombre, RTN, email o código..." />
        </div>
        <div class="filter-group">
            <select id="filterEstado" class="filter-select">
                <option value="">Todos</option>
                <option value="activo">Activos</option>
                <option value="inactivo">Inactivos</option>
            </select>
            <select id="filterCondicion" class="filter-select">
                <option value="">Todas las condiciones</option>
                <option value="Contado">Contado</option>
                <option value="Credito">Crédito</option>
            </select>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="module-alert module-alert-success">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="module-alert module-alert-error">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            @TempData["Error"]
        </div>
    }

    @if (Model.Proveedores.Count == 0)
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13"/>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                <circle cx="5.5" cy="18.5" r="2.5"/>
                <circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
            <h3>No hay proveedores registrados</h3>
            <p>Crea tu primer proveedor para empezar a comprar</p>
            <a asp-page="/Proveedores/Create" class="btn-primary">Crear proveedor</a>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="erp-table" id="proveedoresTable">
                <thead>
                    <tr>
                        <th style="width: 50px;"></th>
                        <th>Proveedor</th>
                        <th>Contacto</th>
                        <th>Condición</th>
                        <th>Moneda</th>
                        <th>Estado</th>
                        <th style="width: 180px; text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Proveedores)
                    {
                        var moneda = Model.Monedas.FirstOrDefault(m => m.Id == p.MonedaId);
                        <tr data-nombre="@p.Nombre.ToLower()"
                            data-rtn="@(p.RTN?.ToLower() ?? "")"
                            data-email="@(p.Email?.ToLower() ?? "")"
                            data-codigo="@(p.Codigo?.ToLower() ?? "")"
                            data-estado="@(p.Activo ? "activo" : "inactivo")"
                            data-condicion="@p.CondicionPago">
                            <td>
                                <div class="user-avatar-sm" style="background: var(--color-primary);">
                                    @(string.IsNullOrEmpty(p.Nombre) ? "?" : p.Nombre.Substring(0, 1).ToUpper())
                                </div>
                            </td>
                            <td>
                                <div class="table-user-cell">
                                    <span class="table-user-name">@p.Nombre</span>
                                    @if (!string.IsNullOrEmpty(p.RTN))
                                    {
                                        <span class="table-user-sub">RTN: @p.RTN</span>
                                    }
                                    @if (!string.IsNullOrEmpty(p.Codigo))
                                    {
                                        <span class="table-user-sub" style="font-family: monospace;">@p.Codigo</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="table-user-cell">
                                    @if (!string.IsNullOrEmpty(p.Telefono))
                                    {
                                        <span class="table-user-sub">@p.Telefono</span>
                                    }
                                    @if (!string.IsNullOrEmpty(p.Email))
                                    {
                                        <span class="table-user-sub">@p.Email</span>
                                    }
                                    @if (!string.IsNullOrEmpty(p.Contacto))
                                    {
                                        <span class="table-user-sub">Contacto: @p.Contacto</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (p.CondicionPago == "Credito")
                                {
                                    <span class="badge badge-warning">@p.DiasCredito días</span>
                                }
                                else
                                {
                                    <span class="badge badge-info">Contado</span>
                                }
                            </td>
                            <td>
                                <span style="font-family: monospace; font-size: 12px;">@(moneda?.Codigo ?? "HNL")</span>
                            </td>
                            <td>
                                @if (p.Activo)
                                {
                                    <span class="badge badge-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Inactivo</span>
                                }
                            </td>
                            <td>
                                <div class="table-actions">
                                    <a asp-page="/Proveedores/Details" asp-route-id="@p.Id" class="btn-icon-action" title="Ver detalle">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                            <circle cx="12" cy="12" r="3"/>
                                        </svg>
                                    </a>
                                    <a asp-page="/Proveedores/Edit" asp-route-id="@p.Id" class="btn-icon-action" title="Editar">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                        </svg>
                                    </a>
                                    <a asp-page="/Proveedores/Delete" asp-route-id="@p.Id" class="btn-icon-action btn-icon-action-danger" title="Eliminar">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6"/>
                                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal de exportación -->
<div id="modalExport" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center; padding:20px;">
    <div style="background:var(--color-surface); border-radius:var(--radius-lg); max-width:480px; width:100%; overflow:hidden;">
        <div style="padding:20px 24px; border-bottom:1px solid var(--color-border); display:flex; justify-content:space-between; align-items:center;">
            <h3 style="font-size:16px; font-weight:700;">Exportar proveedores</h3>
            <button type="button" onclick="cerrarModalExport()" style="background:none; border:none; cursor:pointer; font-size:20px; color:var(--color-muted);">&times;</button>
        </div>
        <div style="padding:24px; display:flex; flex-direction:column; gap:16px;">
            <div class="form-field">
                <label style="font-size:13px; font-weight:600; display:block; margin-bottom:6px;">Formato</label>
                <select id="exportFormato" class="form-input">
                    <option value="excel">Excel (.xlsx)</option>
                    <option value="csv">CSV (.csv)</option>
                    <option value="json">JSON (.json)</option>
                </select>
            </div>
            <div class="form-field">
                <label class="form-checkbox" style="display:flex; align-items:center; gap:8px; font-size:13px;">
                    <input type="checkbox" id="exportSoloActivos" />
                    <span>Solo proveedores activos</span>
                </label>
            </div>
        </div>
        <div style="padding:16px 24px; background:#f9fafb; border-top:1px solid var(--color-border); display:flex; gap:12px; justify-content:flex-end;">
            <button type="button" class="btn-secondary" onclick="cerrarModalExport()">Cancelar</button>
            <a id="btnDescargarExport" href="#" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                Descargar
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var searchInput = document.getElementById('searchInput');
            var filterEstado = document.getElementById('filterEstado');
            var filterCondicion = document.getElementById('filterCondicion');
            var table = document.getElementById('proveedoresTable');
            if (table) {
                var rows = table.querySelectorAll('tbody tr');

                function filterRows() {
                    var search = (searchInput?.value || '').toLowerCase().trim();
                    var estado = filterEstado?.value || '';
                    var condicion = filterCondicion?.value || '';

                    rows.forEach(function (row) {
                        var nombre = row.dataset.nombre || '';
                        var rtn = row.dataset.rtn || '';
                        var email = row.dataset.email || '';
                        var codigo = row.dataset.codigo || '';
                        var rowEstado = row.dataset.estado || '';
                        var rowCondicion = row.dataset.condicion || '';

                        var matchSearch = !search || nombre.includes(search) || rtn.includes(search) || email.includes(search) || codigo.includes(search);
                        var matchEstado = !estado || rowEstado === estado;
                        var matchCondicion = !condicion || rowCondicion === condicion;

                        row.style.display = (matchSearch && matchEstado && matchCondicion) ? '' : 'none';
                    });
                }

                searchInput?.addEventListener('input', filterRows);
                filterEstado?.addEventListener('change', filterRows);
                filterCondicion?.addEventListener('change', filterRows);
            }
        })();

        function mostrarOpcionesExport() {
            document.getElementById('modalExport').style.display = 'flex';
            actualizarLinkExport();
        }
        function cerrarModalExport() {
            document.getElementById('modalExport').style.display = 'none';
        }
        function actualizarLinkExport() {
            var formato = document.getElementById('exportFormato').value;
            var soloActivos = document.getElementById('exportSoloActivos').checked;
            document.getElementById('btnDescargarExport').href =
                '/Proveedores/Export?formato=' + formato + '&soloActivos=' + soloActivos;
        }
        document.getElementById('exportFormato')?.addEventListener('change', actualizarLinkExport);
        document.getElementById('exportSoloActivos')?.addEventListener('change', actualizarLinkExport);
    </script>
}