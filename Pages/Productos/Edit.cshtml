@page "{id:int}"
@model Kirkenta.Pages.Productos.EditModel
@{
    ViewData["Title"] = "Editar producto";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/Productos/Index" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Volver a productos
        </a>
        <h2>Editar producto</h2>
    </div>
</div>

<div class="module-card form-card">
    <form method="post" class="erp-form">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="module-alert module-alert-error">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <span asp-validation-summary="ModelOnly"></span>
            </div>
        }

        <input type="hidden" asp-for="Input.Id" />

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.SKU">SKU</label>
                <input asp-for="Input.SKU" class="form-input" />
            </div>
            <div class="form-field">
                <label asp-for="Input.CodigoBarras">Código de barras</label>
                <input asp-for="Input.CodigoBarras" class="form-input" />
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.Nombre">Nombre *</label>
            <input asp-for="Input.Nombre" class="form-input" required />
        </div>

        <div class="form-field">
            <label asp-for="Input.Descripcion">Descripción</label>
            <textarea asp-for="Input.Descripcion" class="form-input" rows="2"></textarea>
        </div>

        <div class="form-field">
            <label asp-for="Input.CategoriaId">Categoría</label>
            <select asp-for="Input.CategoriaId" class="form-input">
                <option value="">Sin categoría</option>
                @foreach (var cat in Model.Categorias)
                {
                    <option value="@cat.Id">@cat.Nombre</option>
                }
            </select>
        </div>

        <div class="form-divider"></div>
        <h3 class="form-section-title">Precios</h3>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.PrecioCompra">Precio compra (L.)</label>
                <input asp-for="Input.PrecioCompra" type="number" step="0.01" class="form-input" />
            </div>
            <div class="form-field">
                <label asp-for="Input.PrecioVenta">Precio venta (L.) *</label>
                <input asp-for="Input.PrecioVenta" type="number" step="0.01" class="form-input" required />
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.PrecioMayorista">Precio mayorista (L.)</label>
            <input asp-for="Input.PrecioMayorista" type="number" step="0.01" class="form-input" />
        </div>

        <div class="form-divider"></div>
        <h3 class="form-section-title">Inventario</h3>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.Stock">Stock actual</label>
                <input asp-for="Input.Stock" type="number" step="0.01" class="form-input" />
            </div>
            <div class="form-field">
                <label asp-for="Input.StockMinimo">Stock mínimo</label>
                <input asp-for="Input.StockMinimo" type="number" step="0.01" class="form-input" />
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.UnidadMedida">Unidad de medida</label>
            <select asp-for="Input.UnidadMedida" class="form-input">
                @foreach (var u in Model.Unidades)
                {
                    if (u.Nombre == Model.Input.UnidadMedida)
                    {
                        <option value="@u.Nombre" selected>@u.Nombre (@u.Abreviatura)</option>
                    }
                    else
                    {
                        <option value="@u.Nombre">@u.Nombre (@u.Abreviatura)</option>
                    }
                }
            </select>
            <small class="form-help">
                ¿Falta alguna? <a asp-page="/UnidadesMedida/Create" target="_blank">Crear nueva unidad</a>
            </small>
        </div>

        <div class="form-field">
            <label class="form-checkbox">
                <input asp-for="Input.Activo" type="checkbox" />
                <span>Producto activo</span>
            </label>
        </div>

        <div class="form-actions">
            <a asp-page="/Productos/Index" class="btn-secondary">Cancelar</a>
            <button type="submit" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                Guardar cambios
            </button>
        </div>
    </form>
</div>