@page
@model Kirkenta.Pages.Migracion.IndexModel
@using Kirkenta.Helpers.Migracion
@{
    ViewData["Title"] = "Migración desde otro sistema";
}

<div class="module-header">
    <div class="module-header-left">
        <h2>Migración desde otro sistema</h2>
        <p>Sube el respaldo o la exportación del sistema anterior: Kirkenta lee las tablas, adivina a qué módulo va cada una y te lleva a revisar el mapeo antes de importar.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="module-alert module-alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="module-alert module-alert-error">@TempData["Error"]</div>
}

@if (Model.Token == null)
{
    <div class="module-card form-card-wide" style="padding:20px">
        <form method="post" asp-page-handler="Subir" enctype="multipart/form-data" class="erp-form">
            <h3 style="margin-bottom:8px">1. Sube el archivo del sistema anterior</h3>
            <p style="font-size:13px;color:var(--color-muted);margin-bottom:12px">
                Formatos: <strong>.json</strong> (varias tablas o una lista), <strong>.zip</strong> (incluye los respaldos de Kirkenta y zips con un archivo por tabla),
                <strong>.xlsx</strong> / <strong>.xls</strong> (cada hoja es una tabla), <strong>.csv</strong>, <strong>.sql</strong> (volcado de MySQL, PostgreSQL o SQL Server con sentencias INSERT), <strong>.dbf</strong> (dBase/FoxPro), bases <strong>SQLite</strong> (.db, .sqlite), <strong>Access</strong> (.mdb, .accdb),
                respaldos de <strong>SQL Server</strong> (.bak, .mdf) y bases <strong>Firebird</strong> (.fdb).
                Máximo 200 MB. El archivo no se ejecuta: solo se lee.
            </p>
            <input type="file" name="Archivo" accept=".json,.jsonl,.zip,.xlsx,.xls,.csv,.tsv,.txt,.sql,.dbf,.db,.sqlite,.sqlite3,.db3,.mdb,.accdb,.bak,.mdf,.fdb,.gdb" required />
            <div style="margin-top:14px">
                <button type="submit" class="btn-primary">Analizar archivo</button>
            </div>
        </form>

        <hr style="margin:20px 0" />
        <form method="post" asp-page-handler="Conectar" class="erp-form" autocomplete="off">
            <h3 style="margin-bottom:8px">…o conéctate directo a la base del sistema anterior</h3>
            <p style="font-size:13px;color:var(--color-muted);margin-bottom:12px">
                Sin exportar nada: Kirkenta lee todas las tablas directamente. <strong>Solo lee</strong>, nunca modifica la base del sistema anterior,
                y la contraseña no se guarda. Funciona con SQL Server, MySQL/MariaDB, PostgreSQL y Firebird.
            </p>
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px">
                <div class="form-field"><label>Tipo de base</label>
                    <select name="Conexion.Motor" class="form-input" id="kkMigMotor">
                        @foreach (var m in Kirkenta.Helpers.Migracion.MigracionConexionDirecta.Motores)
                        {
                            <option value="@m" data-puerto="@Kirkenta.Helpers.Migracion.MigracionConexionDirecta.PuertoPorDefecto(m)">@Kirkenta.Helpers.Migracion.MigracionConexionDirecta.NombreMotor(m)</option>
                        }
                    </select></div>
                <div class="form-field"><label>Servidor</label><input name="Conexion.Servidor" class="form-input" placeholder="localhost o 192.168.1.10\SQLEXPRESS" /></div>
                <div class="form-field"><label>Puerto</label><input name="Conexion.Puerto" type="number" class="form-input" id="kkMigPuerto" placeholder="1433" /></div>
                <div class="form-field"><label>Base de datos</label><input name="Conexion.BaseDatos" class="form-input" required placeholder="Nombre de la base o ruta del .fdb" /></div>
                <div class="form-field"><label>Usuario</label><input name="Conexion.Usuario" class="form-input" autocomplete="off" /></div>
                <div class="form-field"><label>Contraseña</label><input name="Conexion.Clave" type="password" class="form-input" autocomplete="new-password" /></div>
            </div>
            <label class="form-checkbox" style="margin-top:8px;font-size:13px"><input type="checkbox" name="Conexion.SeguridadWindows" value="true" /> <span>SQL Server: usar la sesión de Windows (sin usuario ni contraseña)</span></label>
            <div style="margin-top:12px"><button type="submit" class="btn-primary">Conectar y analizar</button></div>
        </form>
        <script>
            (function () {
                var m = document.getElementById('kkMigMotor'), p = document.getElementById('kkMigPuerto');
                if (!m || !p) return;
                function poner() { p.placeholder = m.options[m.selectedIndex].getAttribute('data-puerto'); }
                m.addEventListener('change', poner); poner();
            })();
        </script>

        <details style="margin-top:18px;font-size:13px">
            <summary style="cursor:pointer;font-weight:600">¿El sistema viejo usa Access, un respaldo .bak o un archivo de Firebird?</summary>
            <p style="margin-top:8px;color:var(--color-muted)">
                <strong>Access (.mdb / .accdb):</strong> súbelo como archivo; se lee directo (si el servidor no tiene el motor de Access, se indica cómo instalarlo gratis).
                <strong>Respaldo de SQL Server (.bak):</strong> súbelo como archivo; se restaura en una base temporal del SQL Server de este equipo, se lee y se borra.
                <strong>Firebird (.fdb / .gdb):</strong> súbelo como archivo si este equipo tiene Firebird, o usa la conexión directa de arriba escribiendo la ruta del archivo como "Base de datos".
            </p>
        </details>

        @if (Model.HayPrevio)
        {
            <hr style="margin:18px 0" />
            <p>Tienes una migración en curso (los datos temporales se guardan 24 horas).</p>
            <a asp-page="/Migracion/Index" asp-route-continuar="1" class="btn-secondary">Continuar migración</a>
        }
    </div>
}
else
{
    @if (Model.Avisos.Count > 0)
    {
        <div class="module-alert module-alert-error">
            @foreach (var a in Model.Avisos) { <div>@a</div> }
        </div>
    }

    <div class="module-card" style="padding:16px;margin-bottom:12px;border:2px solid var(--color-primary, #2563eb)">
        <h3 style="margin-bottom:6px">⚡ Migración automática (recomendada)</h3>
        <p style="font-size:13px;color:var(--color-muted);margin-bottom:10px">
            Importa todo de una vez en el orden correcto: impuestos, unidades, categorías, productos con su stock inicial, clientes, proveedores, ventas históricas, saldos por cobrar/pagar y kardex.
            Primero puedes «Revisar todo» sin guardar; al migrar se hace un respaldo y todo entra completo o no entra nada.
        </p>
        <a asp-page="/Migracion/Automatica" asp-route-token="@Model.Token" class="btn-primary">Abrir migración automática</a>
    </div>

    <div class="module-card" style="padding:16px">
        <h3 style="margin-bottom:6px">Modo manual: revisa lo que encontramos @(string.IsNullOrEmpty(Model.NombreArchivo) ? "" : "en " + Model.NombreArchivo)</h3>
        <p style="font-size:13px;color:var(--color-muted);margin-bottom:12px">
            Orden recomendado: impuestos → unidades → categorías → productos (con su stock inicial) → clientes → proveedores → y al final los saldos por cobrar/pagar, el historial de ventas y el kardex.
            «Enviar» abre el asistente de importación del módulo con las columnas ya adivinadas; ahí revisas, corriges y confirmas.
            Nada se guarda hasta que confirmes en ese asistente. Puedes importar en modo «solo agregar nuevos» o «actualizar existentes».
        </p>

        <div class="table-wrapper">
            <table class="erp-table">
                <thead>
                    <tr>
                        <th>Tabla del archivo</th>
                        <th style="text-align:right">Filas</th>
                        <th>Columnas</th>
                        <th>Destino sugerido</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var d in Model.Detecciones)
                {
                    var lotes = MigracionAlmacen.TotalLotes(d.Tabla.Rows.Count);
                    foreach (var lote in Enumerable.Range(0, lotes))
                    {
                        <tr>
                            <td>
                                <strong>@d.Tabla.Nombre</strong>
                                @if (lotes > 1) { <div style="font-size:12px;color:var(--color-muted)">Lote @(lote + 1) de @lotes</div> }
                                @if (d.PosibleFuturo != null) { <div style="font-size:12px;color:var(--color-muted)">@d.PosibleFuturo</div> }
                            </td>
                            <td style="text-align:right">@d.Tabla.Rows.Count.ToString("N0")</td>
                            <td style="font-size:12px;max-width:340px">
                                @string.Join(", ", d.Tabla.Headers.Take(10))@(d.Tabla.Headers.Count > 10 ? $" … (+{d.Tabla.Headers.Count - 10})" : "")
                            </td>
                            <td colspan="2">
                                <form method="post" asp-page-handler="Enviar" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
                                    <input type="hidden" name="token" value="@Model.Token" />
                                    <input type="hidden" name="tabla" value="@d.Indice" />
                                    <input type="hidden" name="lote" value="@lote" />
                                    <select name="entidad" class="filter-select">
                                        <option value="">— No migrar / elegir —</option>
                                        <optgroup label="Historial y saldos">
                                            @foreach (var h in MigracionHistorialHelper.Tipos)
                                            {
                                                <option value="@("@" + h)" selected="@(d.Entidad == null && d.TipoHistorial == h)">@MigracionHistorialHelper.NombreTipo(h)</option>
                                            }
                                        </optgroup>
                                        <optgroup label="Catálogos">
                                        @foreach (var e in MigracionAnalizador.Entidades)
                                        {
                                            <option value="@e.Key" selected="@(d.Entidad?.Key == e.Key && d.Confianza is "Alta" or "Media")">@e.Nombre</option>
                                        }
                                        </optgroup>
                                    </select>
                                    @if (d.Entidad != null)
                                    {
                                        var color = d.Confianza == "Alta" ? "#15803d" : d.Confianza == "Media" ? "#b45309" : "#b91c1c";
                                        <span style="font-size:12px;font-weight:600;color:@color">@d.Confianza (@d.Puntaje)</span>
                                    }
                                    <button type="submit" class="btn-primary">Enviar</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        <form method="post" asp-page-handler="Descartar" style="margin-top:14px" onsubmit="return confirm('¿Descartar la migración y borrar los datos temporales?');">
            <button type="submit" class="btn-secondary">Descartar y empezar de nuevo</button>
        </form>
    </div>
}

@if (Model.Lotes.Count > 0)
{
    <div class="module-card" style="padding:16px;margin-top:16px">
        <h3 style="margin-bottom:6px">Lotes ya importados</h3>
        <p style="font-size:13px;color:var(--color-muted);margin-bottom:10px">Si algo se importó mal, deshaz el lote completo. Se conservan los registros que ya tengan cobros, pagos, facturas o devoluciones.</p>
        <div class="table-wrapper">
            <table class="erp-table">
                <thead><tr><th>Lote</th><th>Fecha</th><th style="text-align:right">Ventas históricas</th><th style="text-align:right">Saldos por cobrar</th><th style="text-align:right">Compras y saldos por pagar</th><th style="text-align:right">Kardex</th><th style="text-align:right">Empleados, cuentas y otros</th><th></th></tr></thead>
                <tbody>
                @foreach (var l in Model.Lotes)
                {
                    <tr>
                        <td><code>@l.Lote</code></td>
                        <td>@(l.Fecha?.ToString("dd/MM/yyyy HH:mm"))</td>
                        <td style="text-align:right">@l.Ventas.ToString("N0")</td>
                        <td style="text-align:right">@l.SaldosCxC.ToString("N0")</td>
                        <td style="text-align:right">@l.SaldosCxP.ToString("N0")</td>
                        <td style="text-align:right">@l.Kardex.ToString("N0")</td>
                        <td style="text-align:right">@l.Otros.ToString("N0")</td>
                        <td>
                            <form method="post" asp-page-handler="DeshacerLote" onsubmit="return confirm('¿Deshacer el lote @l.Lote?');">
                                <input type="hidden" name="lote" value="@l.Lote" />
                                <button type="submit" class="btn-secondary">Deshacer</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
