@page
@model Kirkenta.Pages.Migracion.AutomaticaModel
@using Kirkenta.Helpers.Migracion
@{
    ViewData["Title"] = "Migración automática";
}

<div class="module-header">
    <div class="module-header-left">
        <h2>⚡ Migración automática</h2>
        <p>Kirkenta reconoce cada tabla, la ordena según sus dependencias y la importa toda junta: o entra completa o no entra nada.</p>
    </div>
    <div class="module-header-right">
        <a asp-page="/Migracion/Index" asp-route-continuar="1" class="btn-secondary">Modo manual (tabla por tabla)</a>
    </div>
</div>

@if (TempData["Error"] != null) { <div class="module-alert module-alert-error">@TempData["Error"]</div> }

@if (Model.EnCurso != null)
{
    var t = Model.EnCurso;
    <div class="module-card" style="padding:18px;margin-bottom:12px">
        <div style="display:flex;justify-content:space-between;gap:12px;font-size:14px">
            <strong>@(t.Aplicar ? "Migrando…" : "Revisando… (no se guarda nada)")</strong>
            <strong id="mig-pct">@t.Porcentaje %</strong>
        </div>
        <div style="height:8px;background:var(--color-surface-2);border-radius:99px;overflow:hidden;margin:10px 0 8px">
            <div id="mig-barra" style="height:100%;width:@(t.Porcentaje)%;background:var(--color-primary);border-radius:99px;transition:width .4s"></div>
        </div>
        <div id="mig-etapa" style="font-size:13px;color:var(--color-muted)">@t.Etapa</div>
    </div>
    <script>
        (function () {
            var url = '?handler=Estado&Tarea=@t.Id';
            var fin = '?Token=@Model.Token&Tarea=@t.Id';
            function ver() {
                fetch(url, { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (e) {
                    document.getElementById('mig-pct').textContent = e.p + ' %';
                    document.getElementById('mig-barra').style.width = e.p + '%';
                    document.getElementById('mig-etapa').textContent = e.etapa;
                    if (e.listo) location.href = fin; else setTimeout(ver, 800);
                }).catch(function () { setTimeout(ver, 2000); });
            }
            setTimeout(ver, 500);
        })();
    </script>
}

@if (Model.Resultado != null)
{
    var res = Model.Resultado;
    <div class="module-card" style="padding:16px;margin-bottom:12px">
        @if (!res.Ok)
        {
            <div class="module-alert module-alert-error"><strong>❌ @res.ErrorFatal</strong></div>
        }
        else if (res.SoloRevision)
        {
            <div class="module-alert module-alert-success"><strong>🔎 Revisión terminada: no se guardó nada.</strong> Esto es exactamente lo que pasaría al migrar.</div>
        }
        else
        {
            <div class="module-alert module-alert-success"><strong>✅ Migración terminada.</strong>
                @if (res.Respaldo != null) { <span> Respaldo previo: <code>@res.Respaldo</code> (Configuración → Respaldos).</span> }
            </div>
        }

        @if (res.Pasos.Count > 0)
        {
            <div class="table-wrapper">
                <table class="erp-table">
                    <thead><tr><th>Paso</th><th>Tabla</th><th style="text-align:right">Filas</th><th style="text-align:right">@(res.SoloRevision ? "Se crearían" : "Creados")</th><th style="text-align:right">Ya estaban</th><th style="text-align:right">Descartados</th><th>Detalle</th></tr></thead>
                    <tbody>
                    @foreach (var rp in res.Pasos)
                    {
                        var x = rp.Res!;
                        <tr>
                            <td><strong>@rp.Paso.Titulo</strong></td>
                            <td>@rp.Paso.TablaNombre</td>
                            <td style="text-align:right">@x.Filas.ToString("N0")</td>
                            <td style="text-align:right">@x.Creados.ToString("N0")</td>
                            <td style="text-align:right">@x.YaImportados.ToString("N0")</td>
                            <td style="text-align:right">@((x.DescartadasTotal + x.Omitidos).ToString("N0"))</td>
                            <td style="font-size:12px">
                                @if (x.Errores.Count > 0) { <span style="color:#b91c1c">@string.Join(" ", x.Errores)</span> }
                                else
                                {
                                    @if (x.TercerosCreados > 0 || x.TercerosPorCrear > 0) { <div>Clientes/proveedores nuevos: @(Math.Max(x.TercerosCreados, x.TercerosPorCrear))</div> }
                                    @if (x.LineasCreadas > 0) { <div>Líneas de detalle: @x.LineasCreadas.ToString("N0")</div> }
                                    @if (x.Monto > 0) { <div>@(rp.Paso.Destino == "Productos" ? "Valor del inventario al costo" : "Monto"): L. @x.Monto.ToString("N2")</div> }
                                }
                            </td>
                        </tr>
                        @if (x.Descartes.Count > 0 || x.Advertencias.Count > 0)
                        {
                            <tr><td colspan="7" style="background:var(--color-surface-2)">
                                <details>
                                    <summary style="cursor:pointer;font-size:13px">@rp.Paso.Titulo: @(x.Descartes.Count > 0 ? $"{x.DescartadasTotal} fila(s) descartada(s)" : "") @(x.Advertencias.Count > 0 ? $"· {x.Advertencias.Count} aviso(s)" : "")</summary>
                                    <ul style="font-size:12px;margin-top:6px">
                                        @foreach (var d in x.Descartes) { <li><strong>Descartada:</strong> @d</li> }
                                        @foreach (var a in x.Advertencias) { <li>@a</li> }
                                    </ul>
                                </details>
                            </td></tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        }
        @if (res.Conciliacion.Count > 0)
        {
            var cuadraTodo = res.Conciliacion.All(c => c.Cuadra);
            <h3 style="margin:18px 0 6px;font-size:15px">Conciliación: sistema anterior contra Kirkenta</h3>
            <p style="font-size:13px;color:var(--color-muted);margin:0 0 8px">
                @(cuadraTodo ? "✅ Todo lo que venía en el sistema anterior está en Kirkenta o tiene explicación." : "⚠️ Hay pasos que no cuadran: revisa su detalle antes de dar la migración por buena.")
            </p>
            <div class="table-wrapper">
                <table class="erp-table">
                    <thead><tr><th>Paso</th><th style="text-align:right">Filas origen</th><th style="text-align:right">@(res.SoloRevision ? "Se crearían" : "Creados")</th><th style="text-align:right">Ya estaban</th><th style="text-align:right">Descartados</th><th>Monto</th><th style="text-align:right">Origen</th><th style="text-align:right">Kirkenta</th><th>Resultado</th></tr></thead>
                    <tbody>
                    @foreach (var c in res.Conciliacion)
                    {
                        <tr>
                            <td><strong>@c.Titulo</strong><div style="font-size:12px;color:var(--color-muted)">@c.Tabla</div></td>
                            <td style="text-align:right">@c.FilasOrigen.ToString("N0")</td>
                            <td style="text-align:right">@c.Creados.ToString("N0")</td>
                            <td style="text-align:right">@c.YaExistian.ToString("N0")</td>
                            <td style="text-align:right">@c.Descartados.ToString("N0")</td>
                            <td style="font-size:12px">@(c.Concepto ?? "—")</td>
                            <td style="text-align:right;white-space:nowrap">@(c.MontoOrigen.HasValue ? "L. " + c.MontoOrigen.Value.ToString("N2") : "—")</td>
                            <td style="text-align:right;white-space:nowrap">@(c.MontoMigrado.HasValue ? "L. " + c.MontoMigrado.Value.ToString("N2") : "—")</td>
                            <td style="font-size:12px"><span class="badge @(c.Cuadra ? "badge-success" : "badge-danger")">@(c.Cuadra ? "Cuadra" : "Revisar")</span> @c.Explicacion@(c.Recortados > 0 ? $" {c.Recortados} texto(s) recortado(s)." : "")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        @if (res.Verificacion.Count > 0)
        {
            var revisados = res.Verificacion.Sum(v => v.Revisados);
            var difs = res.Verificacion.Sum(v => v.TotalDiferencias);
            var recortes = res.Verificacion.Sum(v => v.Recortados);
            <h3 style="margin:18px 0 6px;font-size:15px">Verificación registro por registro</h3>
            <p style="font-size:13px;margin:0 0 8px">
                @if (difs == 0 && recortes == 0)
                {
                    <span>✅ @revisados.ToString("N0") registros comparados campo por campo contra el origen: todos iguales.</span>
                }
                else
                {
                    <span>⚠️ @revisados.ToString("N0") registros comparados: @difs.ToString("N0") diferencia(s)@(recortes > 0 ? $" y {recortes:N0} texto(s) recortado(s)" : "").</span>
                }
            </p>
            <div class="table-wrapper">
                <table class="erp-table">
                    <thead><tr><th>Paso</th><th style="text-align:right">Comparados</th><th style="text-align:right">Diferencias</th><th>Resultado</th></tr></thead>
                    <tbody>
                    @foreach (var v in res.Verificacion)
                    {
                        <tr>
                            <td><strong>@v.Titulo</strong><div style="font-size:12px;color:var(--color-muted)">@v.Tabla</div></td>
                            <td style="text-align:right">@v.Revisados.ToString("N0")</td>
                            <td style="text-align:right">@((v.TotalDiferencias + v.Recortados).ToString("N0"))</td>
                            <td style="font-size:12px">
                                @if (v.Exacto) { <span class="badge badge-success">Idéntico</span> }
                                else
                                {
                                    <details>
                                        <summary style="cursor:pointer"><span class="badge badge-danger">Revisar</span> ver qué cambió</summary>
                                        <ul style="margin:6px 0 0 16px">
                                            @foreach (var d in v.Diferencias) { <li>@d</li> }
                                            @if (v.TotalDiferencias > 50) { <li>…y @((v.TotalDiferencias - 50).ToString("N0")) más.</li> }
                                        </ul>
                                    </details>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        @if (res.RevisionesIntegridad > 0)
        {
            <h3 style="margin:18px 0 6px;font-size:15px">Revisión de integridad del sistema @(res.SoloRevision ? "(como quedaría)" : "migrado")</h3>
            @if (res.Integridad.Count == 0)
            {
                <p style="font-size:13px;margin:0">✅ Las @res.RevisionesIntegridad revisiones salen limpias: ventas, cobros, cuentas, compras, inventario, nómina y contabilidad cuadran.</p>
            }
            else
            {
                <ul style="font-size:13px;margin:0 0 0 18px">
                    @foreach (var h in res.Integridad)
                    {
                        <li><strong>@h.Area · @h.Titulo:</strong> @h.Total hallazgo(s). @string.Join(" · ", h.Ejemplos)</li>
                    }
                </ul>
                <p style="font-size:12px;color:var(--color-muted);margin-top:6px">Detalle completo en Finanzas → Integridad.</p>
            }
        }

        @if (res.Aplicado)
        {
            <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap">
                <a asp-page="/Productos/Index" class="btn-secondary">Ver productos</a>
                <a asp-page="/Clientes/Index" class="btn-secondary">Ver clientes</a>
                <a asp-page="/Finanzas/Cobros/Index" class="btn-secondary">Ver cobros pendientes</a>
                <a asp-page="/RRHH/Empleados/Index" class="btn-secondary">Ver empleados</a>
                <a asp-page="/Finanzas/Cuentas/Index" class="btn-secondary">Ver cajas y bancos</a>
                <a asp-page="/Finanzas/Integridad/Index" class="btn-secondary">Integridad completa</a>
                <a asp-page="/Migracion/Index" asp-route-continuar="1" class="btn-primary">Ver lotes / deshacer</a>
            </div>
        }
    </div>
}

@if (Model.EnCurso == null && (Model.Resultado == null || !Model.Resultado.Aplicado))
{
    <form method="post" class="module-card" style="padding:16px">
        <input type="hidden" name="Token" value="@Model.Token" />

        @if (Model.RegistrosExistentes > 0)
        {
            <div class="module-alert module-alert-error" style="margin-bottom:12px">
                El sistema ya tiene datos (@Model.RegistrosExistentes.ToString("N0") entre productos, clientes, proveedores y ventas).
                Lo que ya exista se salta sin duplicar, pero lo ideal es migrar sobre un sistema vacío.
            </div>
        }

        <h3 style="margin-bottom:6px">Plan de migración</h3>
        <p style="font-size:13px;color:var(--color-muted);margin-bottom:10px">
            Se ejecuta en este orden. Si una tabla no se reconoció bien, cambia su destino. Las filas con datos inválidos se descartan y se te listan al final; nada se inventa.
        </p>

        <div class="table-wrapper">
            <table class="erp-table">
                <thead><tr><th>#</th><th>Tabla del archivo</th><th style="text-align:right">Filas</th><th>Destino</th><th>Seguridad</th><th>Estado</th></tr></thead>
                <tbody>
                @{ int n = 0; }
                @foreach (var p in Model.Plan)
                {
                    n++;
                    var etiqueta = p.Incluir ? "✔ Se migra" : "— No se migra";
                    <tr style="@(p.Incluir ? "" : "opacity:.7")">
                        <td>@(p.Incluir ? p.Orden.ToString() : "")</td>
                        <td><strong>@p.TablaNombre</strong></td>
                        <td style="text-align:right">@p.Filas.ToString("N0")</td>
                        <td>
                            <select name="Destino[@p.TablaIndice]" class="filter-select">
                                <option value="" selected="@(p.Destino == "")">— No migrar —</option>
                                @foreach (var dst in MigracionAutomaticaHelper.Destinos)
                                {
                                    <option value="@dst" selected="@(p.Destino == dst)">@MigracionAutomaticaHelper.TituloDe(dst)</option>
                                }
                            </select>
                        </td>
                        <td>@p.Confianza</td>
                        <td style="font-size:12px">
                            @etiqueta
                            @if (p.Motivo != null) { <div style="color:var(--color-muted)">@p.Motivo</div> }
                            @if (p.Incluir && p.DetalleIndice.HasValue) { <div style="color:var(--color-muted)">con líneas de «@Model.Tablas[p.DetalleIndice.Value].Nombre»</div> }
                            @foreach (var rel in p.Relaciones) { <div style="color:var(--color-muted)">↪ @rel</div> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @{ var ambiguas = Model.Formatos.Where(f => f.EsFecha && f.Ambiguo).ToList(); }
        @if (ambiguas.Count > 0)
        {
            <div class="module-alert" style="margin-top:14px;font-size:13px">
                <strong>¿Cómo vienen las fechas?</strong>
                En @string.Join(", ", ambiguas.Select(a => $"{a.Tabla}.{a.Columna}")) ningún valor lo aclara (por ejemplo «@ambiguas[0].Ejemplo»).
                <div style="margin-top:6px;display:flex;gap:16px;flex-wrap:wrap">
                    <label><input type="radio" name="FormatoFecha" value="dmy" checked="@(Model.FormatoFecha != "mdy")" /> Día/mes/año</label>
                    <label><input type="radio" name="FormatoFecha" value="mdy" checked="@(Model.FormatoFecha == "mdy")" /> Mes/día/año</label>
                </div>
            </div>
        }

        <div style="margin-top:14px;font-size:13px">
            <label style="display:flex;gap:8px;align-items:flex-start">
                <input type="checkbox" name="Confirmo" value="true" />
                <span>Entiendo que se hará un <strong>respaldo automático</strong> y luego se importará todo lo marcado. Las ventas migradas no mueven stock ni caja; el stock inicial entra por Productos.</span>
            </label>
        </div>

        <div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap">
            <button type="submit" asp-page-handler="Revisar" class="btn-secondary">1. Revisar todo (no guarda nada)</button>
            <button type="submit" asp-page-handler="Migrar" class="btn-primary">2. Migrar todo</button>
        </div>
    </form>
}
