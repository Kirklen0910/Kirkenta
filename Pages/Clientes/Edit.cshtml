@page "{id:int}"
@model Kirkenta.Pages.Clientes.EditModel
@{
    ViewData["Title"] = "Editar cliente";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/Clientes/Index" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Volver a clientes
        </a>
        <h2>Editar cliente</h2>
        <p>Modifica la información del cliente</p>
    </div>
</div>

<div class="module-card form-card">
    <form method="post" class="erp-form">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="module-alert module-alert-error">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <span asp-validation-summary="ModelOnly"></span>
            </div>
        }

        <input type="hidden" asp-for="Input.Id" />

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.Codigo">Código</label>
                <input asp-for="Input.Codigo" class="form-input" />
            </div>
            <div class="form-field">
                <label asp-for="Input.TipoCliente">Tipo de cliente *</label>
                <select asp-for="Input.TipoCliente" class="form-input" required>
                    <option value="Regular">Regular</option>
                    <option value="Mayorista">Mayorista</option>
                    <option value="VIP">VIP</option>
                </select>
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.Nombre">Nombre *</label>
            <input asp-for="Input.Nombre" class="form-input" required />
        </div>

        <div class="form-field">
            <label asp-for="Input.RazonSocial">Razón social</label>
            <input asp-for="Input.RazonSocial" class="form-input" />
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.RTN">RTN</label>
                <input asp-for="Input.RTN" class="form-input" />
            </div>
            <div class="form-field">
                <label asp-for="Input.Telefono">Teléfono</label>
                <input asp-for="Input.Telefono" class="form-input" />
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" type="email" class="form-input" />
        </div>

        <div class="form-field">
            <label asp-for="Input.Direccion">Dirección</label>
            <input asp-for="Input.Direccion" class="form-input" />
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.Ciudad">Ciudad</label>
                <input asp-for="Input.Ciudad" class="form-input" />
            </div>
            <div class="form-field">
                <label asp-for="Input.Pais">País</label>
                <input asp-for="Input.Pais" class="form-input" />
            </div>
        </div>

        <div class="form-divider"></div>
        <h3 class="form-section-title">Crédito</h3>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.LimiteCredito">Límite de crédito (L.)</label>
                <input asp-for="Input.LimiteCredito" type="number" step="0.01" class="form-input" />
            </div>
            <div class="form-field">
                <label asp-for="Input.DiasCredito">Días de crédito</label>
                <input asp-for="Input.DiasCredito" type="number" class="form-input" />
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.Notas">Notas</label>
            <textarea asp-for="Input.Notas" class="form-input" rows="2"></textarea>
        </div>

        <div class="form-field">
            <label class="form-checkbox">
                <input asp-for="Input.Activo" type="checkbox" />
                <span>Cliente activo</span>
            </label>
        </div>

        <div class="form-actions">
            <a asp-page="/Clientes/Index" class="btn-secondary">Cancelar</a>
            <button type="submit" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                Guardar cambios
            </button>
        </div>
    </form>
</div>