@page
@model Kirkenta.Pages.Categorias.IndexModel
@{
    ViewData["Title"] = "Categorías";
}

<div class="module-header">
    <div class="module-header-left">
        <h2>Categorías</h2>
        <p>Organiza tus productos en categorías</p>
    </div>
    <div class="module-header-right">
        @if (Model.PuedeCrear)
        {
            <a asp-page="/Categorias/Create" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Nueva categoría
            </a>
        }
    </div>
</div>

<div class="module-card">
    @if (TempData["Success"] != null)
    {
        <div class="module-alert module-alert-success">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            @TempData["Success"]
        </div>
    }

    @if (Model.Categorias.Count == 0)
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"/>
                <rect x="14" y="3" width="7" height="7"/>
                <rect x="14" y="14" width="7" height="7"/>
                <rect x="3" y="14" width="7" height="7"/>
            </svg>
            <h3>No hay categorías</h3>
            <p>Crea la primera categoría para organizar tus productos</p>
        </div>
    }
    else
    {
        <div class="roles-grid">
            @foreach (var cat in Model.Categorias)
            {
                <div class="role-card">
                    <div class="role-card-header">
                        <div class="role-color" style="background: @cat.Color;"></div>
                        <div class="role-info">
                            <h3>@cat.Nombre</h3>
                            @if (!cat.Activa)
                            {
                                <span class="badge badge-danger">Inactiva</span>
                            }
                        </div>
                    </div>

                    <p class="role-desc">@(cat.Descripcion ?? "Sin descripción")</p>

                    <div class="role-stats">
                        <span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                            </svg>
                            @Model.ConteoProductos.GetValueOrDefault(cat.Id, 0) productos
                        </span>
                    </div>

                    <div class="role-actions">
                        <a asp-page="/Categorias/Edit" asp-route-id="@cat.Id" class="btn-sm btn-secondary">Editar</a>
                        <a asp-page="/Categorias/Delete" asp-route-id="@cat.Id" class="btn-sm btn-danger">Eliminar</a>
                    </div>
                </div>
            }
        </div>
    }
</div>