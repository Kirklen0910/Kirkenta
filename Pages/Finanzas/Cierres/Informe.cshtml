@page "{id:int?}"
@model Kirkenta.Pages.Finanzas.Cierres.InformeModel
@{
    ViewData["Title"] = Model.Titulo;
}

<div class="module-header">
    <div class="module-header-left">
        @if (Model.Id.HasValue)
        {
            <a asp-page="/Finanzas/Cierres/Details" asp-route-id="@Model.Id" class="back-link">← Volver al cierre</a>
        }
        else
        {
            <a asp-page="/Finanzas/Cierres/Index" class="back-link">← Volver a cierres</a>
        }
        <h2>@Model.Titulo</h2>
        <p>@Model.Empresa · @Model.PeriodoTexto</p>
    </div>
    <div class="module-header-right">
        <button type="button" class="btn-secondary" onclick="window.print()">Imprimir / PDF</button>
    </div>
</div>

@if (!Model.Id.HasValue)
{
    <form method="get" class="kk-inf-periodo no-pdf">
        <div><label for="desde">Desde</label><input id="desde" type="date" name="desde" class="form-input" value="@Model.Desde?.ToString("yyyy-MM-dd")" onchange="this.form.submit()" /></div>
        <div><label for="hasta">Hasta</label><input id="hasta" type="date" name="hasta" class="form-input" value="@Model.Hasta?.ToString("yyyy-MM-dd")" onchange="this.form.submit()" /></div>
        @{
            var hoy = DateTime.Today;
            var rapidos = new[] { ("Hoy", hoy), ("7 días", hoy.AddDays(-6)), ("Este mes", new DateTime(hoy.Year, hoy.Month, 1)) };
        }
        <div class="kk-inf-periodo-rapido">
            @foreach (var (texto, desdeRapido) in rapidos)
            {
                var activo = Model.Desde?.Date == desdeRapido && Model.Hasta?.Date == hoy;
                <a href="?desde=@desdeRapido.ToString("yyyy-MM-dd")&hasta=@hoy.ToString("yyyy-MM-dd")" class="@(activo ? "is-on" : "")">@texto</a>
            }
        </div>
    </form>
}

<partial name="_InformeMetodos" model="Model.Informe" />
<partial name="_InformeDescuentos" model="Model.Informe.Descuentos" />
<partial name="_InformeSaldoFavor" model="Model.Informe.SaldoFavor" />
