@page
@model Kirkenta.Pages.Finanzas.Cierres.CreateModel
@{
    ViewData["Title"] = "Nuevo cierre de caja";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/Finanzas/Cierres/Index" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Volver a cierres
        </a>
        <h2>Nuevo cierre de caja</h2>
        <p>Realiza el arqueo y declara el destino del efectivo</p>
    </div>
</div>

<div class="module-card form-card-wide">
    <form method="post" enctype="multipart/form-data" class="erp-form">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="module-alert module-alert-error">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <div asp-validation-summary="All"></div>
            </div>
        }

        <h3 class="form-section-title">1. Datos del cierre</h3>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.CuentaId">Cuenta a cerrar *</label>
                <select asp-for="Input.CuentaId" class="form-input" required>
                    <option value="">— Selecciona una cuenta —</option>
                    @foreach (var c in Model.Cuentas)
                    {
                        <option value="@c.Id">@c.Nombre — Saldo actual: L. @c.SaldoActual.ToString("N2")</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label asp-for="Input.Fecha">Fecha *</label>
                <input asp-for="Input.Fecha" type="date" class="form-input" required />
            </div>
        </div>

        <div class="form-row">
            <div class="form-field" id="campoContado">
                <label asp-for="Input.EfectivoContado">Efectivo contado físicamente *</label>
                <input asp-for="Input.EfectivoContado" asp-format="{0:0.00}" type="number" step="0.01" min="0" class="form-input" id="contadoInput" required />
                <small class="form-help">Total del dinero que cuentas en la caja. <strong id="ayudaEsperado"></strong></small>
            </div>
            <div class="form-field">
                <label asp-for="Input.Tolerancia">Tolerancia (L.)</label>
                <input asp-for="Input.Tolerancia" asp-format="{0:0.00}" type="number" step="0.01" min="0" class="form-input" value="20.00" />
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.Notas">Notas del cierre</label>
            <textarea asp-for="Input.Notas" class="form-input" rows="2" placeholder="Observaciones generales..."></textarea>
        </div>

        <div class="form-divider"></div>
        <h3 class="form-section-title">📊 Informe previo del día</h3>
        <p class="form-section-desc">Revísalo antes de cerrar: cambia entre Todo, Efectivo, Tarjeta, Transferencia o Crédito para ver cómo se movió cada método.</p>
        <div id="informePrevio"><p class="form-help">Selecciona la cuenta para ver el informe.</p></div>

        <div id="bloqueConteo" style="display:none;margin-top:14px;">
            <h4 style="margin:0 0 6px;font-size:14px;">Conteo de vouchers y comprobantes (opcional)</h4>
            <p class="form-help" style="margin:0 0 8px;">Escribe lo que contaste de tarjeta, transferencias u otros métodos para compararlo con el sistema. Queda registrado en las notas del cierre.</p>
            <div id="filasConteo" class="kk-inf-box"></div>
            <input type="hidden" asp-for="Input.ConteoJson" id="conteoJson" />
        </div>

        <div class="module-card" style="margin-top:16px;background:var(--color-surface-2);">
            <label style="display:flex;gap:10px;align-items:flex-start;cursor:pointer;">
                <input type="checkbox" asp-for="Input.SinConteo" id="sinConteo" style="margin-top:4px;" />
                <span><strong>Cerrar sin contar el efectivo ni los comprobantes</strong><br />
                <span class="form-help">El sistema usará el efectivo esperado y lo dejará marcado en el cierre. Requiere el usuario y la contraseña de un administrador.</span></span>
            </label>
            <div id="bloqueAutorizacion" style="display:none;margin-top:12px;">
                <div class="form-row">
                    <div class="form-field">
                        <label asp-for="Input.AutorizadorUsuario">Usuario administrador</label>
                        <input asp-for="Input.AutorizadorUsuario" class="form-input" autocomplete="off" />
                    </div>
                    <div class="form-field">
                        <label asp-for="Input.AutorizadorPassword">Contraseña</label>
                        <input asp-for="Input.AutorizadorPassword" type="password" value="" class="form-input" autocomplete="new-password" />
                    </div>
                </div>
            </div>
        </div>

        <div id="bloqueDistribucion">
        <div class="form-divider"></div>
        <h3 class="form-section-title">2. Distribución del efectivo</h3>
        <p class="form-section-desc">
            ¿A dónde va el efectivo contado? <strong>La suma debe coincidir con lo contado.</strong>
            Lo que deposites <strong>sale de la caja y entra al banco</strong>; lo que dejes como fondo se queda en la caja para la próxima apertura.
            <strong>Cerrar no saca el dinero de la caja:</strong> si no repartes nada, todo queda como fondo y la próxima apertura lo esperará ahí.
        </p>
        @if (!Model.CuentasBancarias.Any())
        {
            <div class="module-alert module-alert-warning" style="margin:0 0 14px">
                Todavía no tienes una cuenta de banco a la que depositar. <a href="/Finanzas/Cuentas/Create" style="text-decoration:underline">Crear cuenta de banco</a>
            </div>
        }

        <div style="background: #eef2ff; padding: 12px 16px; border-radius: 8px; border: 1px solid #c7d2fe; margin-bottom: 16px;">
            <span style="font-size: 13px; font-weight: 600; color: var(--color-primary);">Efectivo contado:</span>
            <strong id="totalContadoDisplay" style="font-size: 15px; color: var(--color-primary);">L. 0.00</strong>
            <span style="margin-left: 20px; font-size: 13px; font-weight: 600; color: var(--color-muted);">Distribuido:</span>
            <strong id="totalDistribuidoDisplay" style="font-size: 15px; color: var(--color-muted);">L. 0.00</strong>
            <span style="margin-left: 20px; font-size: 13px; font-weight: 600;">Pendiente:</span>
            <strong id="pendienteDisplay" style="font-size: 15px; color: var(--color-danger);">L. 0.00</strong>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.MontoPorDepositar">🕒 Para depositar después</label>
                <input asp-for="Input.MontoPorDepositar" asp-format="{0:0.00}" type="number" step="0.01" min="0" class="form-input distribucion-input" id="porDepositarInput" placeholder="0.00" />
                <small class="form-help">Si el banco ya cerró: sale de la caja y queda «por depositar». Mañana registras la boleta en este cierre.</small>
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.MontoRetiroBanco">🏦 Depositado hoy en el banco</label>
                <input asp-for="Input.MontoRetiroBanco" asp-format="{0:0.00}" type="number" step="0.01" min="0" class="form-input distribucion-input" id="retiroInput" placeholder="0.00" />
                <small class="form-help">Monto que llevas al banco</small>
            </div>
            <div class="form-field">
                <label asp-for="Input.CuentaBancoDestinoId">Cuenta bancaria destino</label>
                <select asp-for="Input.CuentaBancoDestinoId" class="form-input">
                    <option value="">— Selecciona banco —</option>
                    @foreach (var b in Model.CuentasBancarias)
                    {
                        <option value="@b.Id">@b.Nombre</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.ReferenciaRetiro">Referencia del depósito</label>
            <input asp-for="Input.ReferenciaRetiro" class="form-input" placeholder="Ej: Boleta #12345, transferencia #67890" />
            <small class="form-help">El número de la boleta del depósito. Sube la foto de la boleta abajo, en «Adjuntos».</small>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.MontoFondoCaja">💰 Fondo para próximo día</label>
                <input asp-for="Input.MontoFondoCaja" asp-format="{0:0.00}" type="number" step="0.01" min="0" class="form-input distribucion-input" id="fondoInput" placeholder="0.00" />
                <small class="form-help">Efectivo que se queda en caja para dar cambio</small>
            </div>
            <div class="form-field">
                <label asp-for="Input.MontoEntregaAdmin">👤 Entrega a administración</label>
                <input asp-for="Input.MontoEntregaAdmin" asp-format="{0:0.00}" type="number" step="0.01" min="0" class="form-input distribucion-input" id="entregaInput" placeholder="0.00" />
                <small class="form-help">Si se entrega el efectivo a otra persona</small>
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.UsuarioRecibeEntregaId">Usuario que recibe</label>
                <select asp-for="Input.UsuarioRecibeEntregaId" class="form-input">
                    <option value="">— Selecciona usuario —</option>
                    @foreach (var u in Model.Usuarios)
                    {
                        <option value="@u.Id">@u.Username</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label asp-for="Input.NombreRecibeEntrega">O nombre de quien recibe</label>
                <input asp-for="Input.NombreRecibeEntrega" class="form-input" placeholder="Si no es usuario del sistema" />
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.ReferenciaEntrega">Referencia de la entrega</label>
            <input asp-for="Input.ReferenciaEntrega" class="form-input" placeholder="Ej: Recibo #001" />
        </div>

        </div>

        <div class="form-divider"></div>
        <h3 class="form-section-title">3. Adjuntos / Comprobantes</h3>
        <p class="form-section-desc">Sube fotos de las boletas de depósito, recibos, etc.</p>

        <div class="form-field">
            <label>Comprobantes</label>
            <input type="file" name="Input.Adjuntos" multiple accept=".pdf,.jpg,.jpeg,.png"
                   style="display:block; font-size:13px; padding: 10px; border: 2px dashed var(--color-border); border-radius: 6px; width: 100%;" />
            <small class="form-help">PDF, JPG o PNG. Máximo 10 MB por archivo. Puedes subir varios.</small>
        </div>

        <div class="form-actions">
            <a asp-page="/Finanzas/Cierres/Index" class="btn-secondary">Cancelar</a>
            <button type="submit" class="btn-primary" style="background: var(--color-success);">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                Confirmar cierre
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/informe-metodos.js" asp-append-version="true"></script>
    <script>
        (function () {
            var cuenta = document.getElementById('Input_CuentaId');
            var fecha = document.getElementById('Input_Fecha');
            var panel = document.getElementById('informePrevio');
            var bloqueConteo = document.getElementById('bloqueConteo');
            var filas = document.getElementById('filasConteo');
            var json = document.getElementById('conteoJson');
            var ayuda = document.getElementById('ayudaEsperado');
            var sin = document.getElementById('sinConteo');
            var auth = document.getElementById('bloqueAutorizacion');
            var dist = document.getElementById('bloqueDistribucion');
            var contado = document.getElementById('contadoInput');
            var campoContado = document.getElementById('campoContado');
            var datos = null;

            function money(n) { return 'L. ' + (Number(n) || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
            function norm(s) { return String(s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''); }
            function esEfectivo(m) { return /efectivo/.test(norm(m.nombre) + ' ' + norm(m.tipo)); }

            function actualizarConteo() {
                var lista = [];
                filas.querySelectorAll('[data-fila]').forEach(function (f) {
                    var inp = f.querySelector('input');
                    var s = parseFloat(f.getAttribute('data-sistema')) || 0;
                    var dif = f.querySelector('[data-dif]');
                    if (inp.value === '') { dif.textContent = '—'; dif.style.color = ''; return; }
                    var c = parseFloat(inp.value) || 0;
                    var d = c - s;
                    dif.textContent = (d === 0 ? 'Cuadra' : money(d));
                    dif.style.color = Math.abs(d) < 0.01 ? 'var(--color-success)' : 'var(--color-danger)';
                    lista.push({ n: f.getAttribute('data-nombre'), s: s, c: c });
                });
                json.value = lista.length ? JSON.stringify(lista) : '';
            }

            function armarConteo(d) {
                filas.textContent = '';
                var conMov = (d.metodos || []).filter(function (m) { return !esEfectivo(m) && m.total > 0; });
                bloqueConteo.style.display = conMov.length && !sin.checked ? '' : 'none';
                conMov.forEach(function (m) {
                    var f = document.createElement('div');
                    f.setAttribute('data-fila', '1'); f.setAttribute('data-sistema', m.total); f.setAttribute('data-nombre', m.nombre);
                    f.style.cssText = 'display:grid;grid-template-columns:1.2fr 1fr 1fr 1fr;gap:10px;align-items:center;padding:8px 6px;border-bottom:1px solid var(--color-border);';
                    var a = document.createElement('strong'); a.textContent = m.nombre;
                    var b = document.createElement('span'); b.textContent = 'Sistema: ' + money(m.total);
                    var wrap = document.createElement('span');
                    var inp = document.createElement('input'); inp.type = 'number'; inp.step = '0.01'; inp.min = '0'; inp.className = 'form-input'; inp.placeholder = 'Contado';
                    inp.setAttribute('aria-label', 'Contado de ' + m.nombre);
                    inp.addEventListener('input', actualizarConteo);
                    wrap.appendChild(inp);
                    var dif = document.createElement('span'); dif.setAttribute('data-dif', '1'); dif.textContent = '—';
                    f.appendChild(a); f.appendChild(b); f.appendChild(wrap); f.appendChild(dif);
                    filas.appendChild(f);
                });
                ayuda.textContent = d.efectivo ? 'El sistema espera ' + money(d.efectivo.esperado) + ' en efectivo.' : '';
                actualizarConteo();
            }

            function cargarPrevio() {
                if (!cuenta.value) {
                    panel.textContent = 'Selecciona la cuenta para ver el informe.';
                    bloqueConteo.style.display = 'none'; ayuda.textContent = ''; return;
                }
                panel.textContent = 'Cargando informe…';
                fetch(window.location.pathname + '?handler=Previo&cuentaId=' + encodeURIComponent(cuenta.value) + '&fecha=' + encodeURIComponent(fecha.value), { credentials: 'same-origin' })
                    .then(function (r) { if (!r.ok) throw new Error('http'); return r.text(); })
                    .then(function (html) { panel.innerHTML = html; window.kkInformeInit(panel); })
                    .catch(function () { panel.textContent = 'No se pudo cargar el informe previo. Puedes continuar con el cierre.'; });
            }

            panel.addEventListener('kk-informe-listo', function (e) { datos = e.detail; armarConteo(datos); });
            cuenta.addEventListener('change', cargarPrevio);
            fecha.addEventListener('change', cargarPrevio);

            function aplicarSinConteo() {
                var on = sin.checked;
                auth.style.display = on ? '' : 'none';
                // el reparto del efectivo (depósito, fondo, entrega) se hace igual: sin conteo se reparte lo esperado
                campoContado.style.display = on ? 'none' : '';
                contado.required = !on;
                if (on && datos && datos.efectivo) {
                    contado.value = Number(datos.efectivo.esperado || 0).toFixed(2);
                    contado.dispatchEvent(new Event('input', { bubbles: true }));
                }
                if (datos) armarConteo(datos);
            }
            sin.addEventListener('change', aplicarSinConteo);
            aplicarSinConteo();
            if (cuenta.value) cargarPrevio();
        })();
    </script>
    <script>
        (function () {
            var contado = document.getElementById('contadoInput');
            var retiro = document.getElementById('retiroInput');
            var fondo = document.getElementById('fondoInput');
            var entrega = document.getElementById('entregaInput');
            var porDepositar = document.getElementById('porDepositarInput');

            var displayContado = document.getElementById('totalContadoDisplay');
            var displayDistribuido = document.getElementById('totalDistribuidoDisplay');
            var displayPendiente = document.getElementById('pendienteDisplay');

            function formatMoney(n) {
                return 'L. ' + (n || 0).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
            }

            function actualizar() {
                var totalContado = parseFloat(contado.value) || 0;
                var totalRetiro = parseFloat(retiro.value) || 0;
                var totalFondo = parseFloat(fondo.value) || 0;
                var totalEntrega = parseFloat(entrega.value) || 0;
                var totalPorDepositar = parseFloat(porDepositar.value) || 0;

                var totalDistribuido = totalRetiro + totalFondo + totalEntrega + totalPorDepositar;
                var pendiente = totalContado - totalDistribuido;

                displayContado.textContent = formatMoney(totalContado);
                displayDistribuido.textContent = formatMoney(totalDistribuido);
                displayPendiente.textContent = formatMoney(pendiente);

                if (Math.abs(pendiente) < 0.01) {
                    displayPendiente.style.color = 'var(--color-success)';
                } else {
                    displayPendiente.style.color = 'var(--color-danger)';
                }
            }

            contado.addEventListener('input', actualizar);
            retiro.addEventListener('input', actualizar);
            fondo.addEventListener('input', actualizar);
            entrega.addEventListener('input', actualizar);
            porDepositar.addEventListener('input', actualizar);

            // Auto-calcular fondo: al ingresar contado, sugerir que todo el efectivo va al banco menos un fondo
            contado.addEventListener('input', function () {
                var valor = parseFloat(this.value) || 0;
                if (!retiro.value && !fondo.value && !entrega.value && valor > 0) {
                    // Sugerir que se quede L. 500 de fondo y el resto al banco
                    fondo.value = Math.min(500, valor).toFixed(2);
                    retiro.value = (valor - parseFloat(fondo.value)).toFixed(2);
                    actualizar();
                }
            });

            actualizar();
        })();
    </script>
}