@page
@model Kirkenta.Pages.Finanzas.Movimientos.IndexModel
@{
    ViewData["Title"] = "Movimientos financieros";
}

<div class="module-header">
    <div class="module-header-left">
        <h2>Movimientos financieros</h2>
        <p>Ingresos, egresos y transferencias</p>
    </div>
    <div class="module-header-right">
        @if (Model.PuedeCrear)
        {
            <a asp-page="/Finanzas/Movimientos/Create" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Nuevo movimiento
            </a>
        }
        <a asp-page="/Finanzas/Index" class="btn-secondary">Volver a Finanzas</a>
    </div>
</div>

<div class="kpi-grid" style="margin-bottom: 20px;">
    <div class="kpi-card">
        <span class="kpi-label">Total ingresos</span>
        <span class="kpi-value" style="color: var(--color-success);">+ L. @Model.TotalIngresos.ToString("N2")</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Total egresos</span>
        <span class="kpi-value" style="color: var(--color-danger);">- L. @Model.TotalEgresos.ToString("N2")</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Balance</span>
        <span class="kpi-value" style="color: @(Model.Balance >= 0 ? "var(--color-success)" : "var(--color-danger)");">
            L. @Model.Balance.ToString("N2")
        </span>
        <span class="kpi-trend">@Model.CantidadMovimientos movimientos</span>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="module-alert module-alert-success">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="module-alert module-alert-error">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        @TempData["Error"]
    </div>
}

<div class="module-card">
    <div class="module-toolbar">
        <div class="search-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" id="searchInput" placeholder="Buscar por número, concepto o referencia..." />
        </div>
        <div class="filter-group">
            <select id="filterTipo" class="filter-select">
                <option value="">Todos los tipos</option>
                <option value="Ingreso">Ingresos</option>
                <option value="Egreso">Egresos</option>
                <option value="Transferencia">Transferencias</option>
            </select>
            <select id="filterCuenta" class="filter-select">
                <option value="">Todas las cuentas</option>
                @foreach (var c in Model.Cuentas)
                {
                    <option value="@c.Id">@c.Nombre</option>
                }
            </select>
            <select id="filterEstado" class="filter-select">
                <option value="">Todos</option>
                <option value="Activo">Activos</option>
                <option value="Anulado">Anulados</option>
            </select>
        </div>
    </div>

    @if (Model.Movimientos.Count == 0)
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="1" x2="12" y2="23"/>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
            <h3>No hay movimientos</h3>
            <p>Registra tu primer ingreso o egreso</p>
            <a asp-page="/Finanzas/Movimientos/Create" class="btn-primary">Nuevo movimiento</a>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="erp-table" id="movTable">
                <thead>
                    <tr>
                        <th>Número</th>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Concepto</th>
                        <th>Cuenta</th>
                        <th>Categoría</th>
                        <th style="text-align: right;">Monto</th>
                        <th>Estado</th>
                        <th style="width: 140px; text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Movimientos)
                    {
                        <tr data-numero="@m.Numero.ToLower()"
                            data-concepto="@m.Concepto.ToLower()"
                            data-referencia="@(m.Referencia?.ToLower() ?? "")"
                            data-tipo="@m.Tipo"
                            data-cuentaid="@m.CuentaNombre"
                            data-estado="@m.Estado">
                            <td><span style="font-family: monospace;">@m.Numero</span></td>
                            <td>@m.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (m.Tipo == "Ingreso")
                                {
                                    <span class="badge badge-success">Ingreso</span>
                                }
                                else if (m.Tipo == "Egreso")
                                {
                                    <span class="badge badge-danger">Egreso</span>
                                }
                                else
                                {
                                    <span class="badge badge-info">Transferencia</span>
                                }
                            </td>
                            <td>
                                <strong>@m.Concepto</strong>
                                @if (!string.IsNullOrEmpty(m.Referencia))
                                {
                                    <br /><span class="table-user-sub">Ref: @m.Referencia</span>
                                }
                            </td>
                            <td>
                                @m.CuentaNombre
                                @if (!string.IsNullOrEmpty(m.CuentaDestinoNombre))
                                {
                                    <br /><span class="table-user-sub">→ @m.CuentaDestinoNombre</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(m.CategoriaNombre))
                                {
                                    <span class="badge" style="background: @(m.CategoriaColor)20; color: @m.CategoriaColor;">@m.CategoriaNombre</span>
                                }
                                else
                                {
                                    <span class="table-user-sub">—</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <strong style="color: @(m.Tipo == "Ingreso" ? "var(--color-success)" : m.Tipo == "Egreso" ? "var(--color-danger)" : "var(--color-primary)");">
                                    @(m.Tipo == "Ingreso" ? "+" : m.Tipo == "Egreso" ? "-" : "↔") L. @m.Monto.ToString("N2")
                                </strong>
                            </td>
                            <td>
                                @if (m.Estado == "Activo")
                                {
                                    <span class="badge badge-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Anulado</span>
                                }
                            </td>
                            <td>
                                <div class="table-actions">
                                    @if (Model.PuedeEditar && m.Estado == "Activo" && m.Origen == "Manual")
                                    {
                                        <a asp-page="/Finanzas/Movimientos/Edit" asp-route-id="@m.Id" class="btn-icon-action" title="Editar">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                            </svg>
                                        </a>
                                    }
                                    @if (Model.PuedeAnular && m.Estado == "Activo")
                                    {
                                        <a asp-page="/Finanzas/Movimientos/Anular" asp-route-id="@m.Id" class="btn-icon-action btn-icon-action-danger" title="Anular">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10"/>
                                                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                                            </svg>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var searchInput = document.getElementById('searchInput');
            var filterTipo = document.getElementById('filterTipo');
            var filterCuenta = document.getElementById('filterCuenta');
            var filterEstado = document.getElementById('filterEstado');
            var table = document.getElementById('movTable');
            if (!table) return;
            var rows = table.querySelectorAll('tbody tr');

            function filterRows() {
                var search = (searchInput?.value || '').toLowerCase().trim();
                var tipo = filterTipo?.value || '';
                var cuenta = filterCuenta?.value || '';
                var estado = filterEstado?.value || '';

                rows.forEach(function (row) {
                    var numero = row.dataset.numero || '';
                    var concepto = row.dataset.concepto || '';
                    var referencia = row.dataset.referencia || '';
                    var rowTipo = row.dataset.tipo || '';
                    var rowCuenta = row.dataset.cuentaid || '';
                    var rowEstado = row.dataset.estado || '';

                    var matchSearch = !search || numero.includes(search) || concepto.includes(search) || referencia.includes(search);
                    var matchTipo = !tipo || rowTipo === tipo;
                    var matchCuenta = !cuenta || rowCuenta === cuenta;
                    var matchEstado = !estado || rowEstado === estado;

                    row.style.display = (matchSearch && matchTipo && matchCuenta && matchEstado) ? '' : 'none';
                });
            }

            searchInput?.addEventListener('input', filterRows);
            filterTipo?.addEventListener('change', filterRows);
            filterCuenta?.addEventListener('change', filterRows);
            filterEstado?.addEventListener('change', filterRows);
        })();
    </script>
}