@page
@model Kirkenta.Pages.Finanzas.Movimientos.CreateModel
@{
    ViewData["Title"] = "Nuevo movimiento";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/Finanzas/Movimientos/Index" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Volver a movimientos
        </a>
        <h2>Nuevo movimiento</h2>
        <p>Número: <strong>@Model.NumeroPreview</strong></p>
    </div>
</div>

<div class="module-card form-card-wide">
    <form method="post" class="erp-form" id="movForm">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="module-alert module-alert-error">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <div asp-validation-summary="All"></div>
            </div>
        }

        <h3 class="form-section-title">Datos del movimiento</h3>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.Tipo">Tipo *</label>
                <select asp-for="Input.Tipo" class="form-input" id="tipoSelect" required>
                    <option value="Ingreso">Ingreso</option>
                    <option value="Egreso" selected>Egreso</option>
                    <option value="Transferencia">Transferencia entre cuentas</option>
                </select>
            </div>
            <div class="form-field">
                <label asp-for="Input.Fecha">Fecha *</label>
                <input asp-for="Input.Fecha" type="date" class="form-input" required />
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.CuentaId" id="cuentaLabel">Cuenta *</label>
                <select asp-for="Input.CuentaId" class="form-input" required>
                    <option value="">— Selecciona —</option>
                    @foreach (var c in Model.Cuentas)
                    {
                        <option value="@c.Id">@c.Nombre — L. @c.SaldoActual.ToString("N2")</option>
                    }
                </select>
            </div>
            <div class="form-field" id="cuentaDestinoField" style="display: none;">
                <label asp-for="Input.CuentaDestinoId">Cuenta destino *</label>
                <select asp-for="Input.CuentaDestinoId" class="form-input">
                    <option value="">— Selecciona —</option>
                    @foreach (var c in Model.Cuentas)
                    {
                        <option value="@c.Id">@c.Nombre — L. @c.SaldoActual.ToString("N2")</option>
                    }
                </select>
            </div>
            <div class="form-field" id="categoriaField">
                <label asp-for="Input.CategoriaId">Categoría *</label>
                <select asp-for="Input.CategoriaId" class="form-input" id="categoriaSelect">
                    <option value="">— Selecciona —</option>
                    @foreach (var c in Model.Categorias)
                    {
                        <option value="@c.Id" data-tipo="@c.Tipo">@c.Nombre</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.Monto">Monto *</label>
                <input asp-for="Input.Monto" type="number" step="0.01" min="0.01" class="form-input" required />
            </div>
            <div class="form-field">
                <label asp-for="Input.FormaPago">Forma de pago</label>
                <select asp-for="Input.FormaPago" class="form-input">
                    <option value="">— Selecciona —</option>
                    <option value="Efectivo">Efectivo</option>
                    <option value="Transferencia">Transferencia bancaria</option>
                    <option value="Cheque">Cheque</option>
                    <option value="Tarjeta">Tarjeta</option>
                    <option value="Deposito">Depósito</option>
                </select>
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.Concepto">Concepto *</label>
            <input asp-for="Input.Concepto" class="form-input" placeholder="Ej: Pago de energía eléctrica, Venta del día..." required />
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.Referencia">Referencia</label>
                <input asp-for="Input.Referencia" class="form-input" placeholder="Ej: Cheque 001, Transferencia #123" />
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.Notas">Notas</label>
            <textarea asp-for="Input.Notas" class="form-input" rows="2"></textarea>
        </div>

        <div class="form-actions">
            <a asp-page="/Finanzas/Movimientos/Index" class="btn-secondary">Cancelar</a>
            <button type="submit" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                Registrar movimiento
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var tipoSelect = document.getElementById('tipoSelect');
            var categoriaField = document.getElementById('categoriaField');
            var cuentaDestinoField = document.getElementById('cuentaDestinoField');
            var categoriaSelect = document.getElementById('categoriaSelect');
            var cuentaLabel = document.getElementById('cuentaLabel');

            function actualizar() {
                var tipo = tipoSelect.value;

                if (tipo === 'Transferencia') {
                    categoriaField.style.display = 'none';
                    cuentaDestinoField.style.display = '';
                    cuentaLabel.textContent = 'Cuenta origen *';
                } else {
                    categoriaField.style.display = '';
                    cuentaDestinoField.style.display = 'none';
                    cuentaLabel.textContent = 'Cuenta *';

                    // Filtrar categorías según tipo
                    Array.from(categoriaSelect.options).forEach(function (opt) {
                        if (!opt.value) return;
                        opt.style.display = (opt.dataset.tipo === tipo) ? '' : 'none';
                    });
                    // Resetear selección si no aplica
                    var sel = categoriaSelect.selectedOptions[0];
                    if (sel && sel.dataset.tipo && sel.dataset.tipo !== tipo) {
                        categoriaSelect.value = '';
                    }
                }
            }

            tipoSelect.addEventListener('change', actualizar);
            actualizar();
        })();
    </script>
}