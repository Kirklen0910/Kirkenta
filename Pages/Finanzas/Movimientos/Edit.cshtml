@page "{id:int}"
@model Kirkenta.Pages.Finanzas.Movimientos.EditModel
@{
    ViewData["Title"] = "Editar movimiento";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/Finanzas/Movimientos/Index" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Volver a movimientos
        </a>
        <h2>Editar movimiento @Model.Numero</h2>
    </div>
</div>

<div class="module-card form-card-wide">
    <form method="post" class="erp-form">
        <input type="hidden" asp-for="Input.Id" />
        <input type="hidden" asp-for="Input.Tipo" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="module-alert module-alert-error">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <div asp-validation-summary="All"></div>
            </div>
        }

        <div class="module-alert" style="background: #eef2ff; border: 1px solid #c7d2fe; color: var(--color-primary);">
            <strong>Tipo:</strong> @Model.Input.Tipo — no se puede cambiar el tipo al editar
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.Fecha">Fecha *</label>
                <input asp-for="Input.Fecha" type="date" class="form-input" required />
            </div>
            <div class="form-field">
                <label asp-for="Input.CuentaId">Cuenta *</label>
                <select asp-for="Input.CuentaId" class="form-input" required>
                    @foreach (var c in Model.Cuentas)
                    {
                        <option value="@c.Id">@c.Nombre</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.CategoriaId">Categoría *</label>
                <select asp-for="Input.CategoriaId" class="form-input">
                    <option value="">— Selecciona —</option>
                    @foreach (var c in Model.Categorias.Where(x => x.Tipo == Model.Input.Tipo))
                    {
                        <option value="@c.Id">@c.Nombre</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label asp-for="Input.Monto">Monto *</label>
                <input asp-for="Input.Monto" type="number" step="0.01" min="0.01" class="form-input" required />
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.Concepto">Concepto *</label>
                <input asp-for="Input.Concepto" class="form-input" required />
            </div>
            <div class="form-field">
                <label asp-for="Input.FormaPago">Forma de pago</label>
                <select asp-for="Input.FormaPago" class="form-input">
                    <option value="">— Selecciona —</option>
                    <option value="Efectivo">Efectivo</option>
                    <option value="Transferencia">Transferencia bancaria</option>
                    <option value="Cheque">Cheque</option>
                    <option value="Tarjeta">Tarjeta</option>
                    <option value="Deposito">Depósito</option>
                </select>
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.Referencia">Referencia</label>
            <input asp-for="Input.Referencia" class="form-input" />
        </div>

        <div class="form-field">
            <label asp-for="Input.Notas">Notas</label>
            <textarea asp-for="Input.Notas" class="form-input" rows="2"></textarea>
        </div>

        <div class="form-actions">
            <a asp-page="/Finanzas/Movimientos/Index" class="btn-secondary">Cancelar</a>
            <button type="submit" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                Guardar cambios
            </button>
        </div>
    </form>
</div>