@page
@model Kirkenta.Pages.Finanzas.Categorias.IndexModel
@{
    ViewData["Title"] = "Categorías financieras";
    var ingresos = Model.Categorias.Where(c => c.Tipo == "Ingreso").ToList();
    var egresos = Model.Categorias.Where(c => c.Tipo == "Egreso").ToList();
}

<div class="module-header">
    <div class="module-header-left">
        <h2>Categorías financieras</h2>
        <p>Clasificación de ingresos y egresos</p>
    </div>
    <div class="module-header-right">
        @if (Model.PuedeCrear)
        {
            <a asp-page="/Finanzas/Categorias/Create" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Nueva categoría
            </a>
        }
        <a asp-page="/Finanzas/Index" class="btn-secondary">Volver a Finanzas</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="module-alert module-alert-success">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="module-alert module-alert-error">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        @TempData["Error"]
    </div>
}

<div class="panel-grid">
    <!-- CATEGORÍAS DE INGRESO -->
    <div class="module-card" style="padding: 20px;">
        <h3 class="panel-title" style="margin-bottom: 16px; color: var(--color-success);">💰 Categorías de Ingreso (@ingresos.Count)</h3>

        @if (ingresos.Count == 0)
        {
            <p style="color: var(--color-muted); text-align: center; padding: 30px;">Sin categorías de ingreso</p>
        }
        else
        {
            <div class="table-wrapper">
                <table class="erp-table">
                    <thead>
                        <tr>
                            <th style="width: 40px;"></th>
                            <th>Nombre</th>
                            <th>Cuenta contable</th>
                            <th style="width: 120px; text-align: right;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in ingresos)
                        {
                            <tr>
                                <td>
                                    <div style="width: 24px; height: 24px; border-radius: 6px; background: @c.Color;"></div>
                                </td>
                                <td>
                                    <strong>@c.Nombre</strong>
                                    @if (c.EsSistema)
                                    {
                                        <span class="badge badge-info" style="font-size: 10px; margin-left: 4px;">Sistema</span>
                                    }
                                    @if (!string.IsNullOrEmpty(c.Descripcion))
                                    {
                                        <br /><span class="table-user-sub">@c.Descripcion</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(c.CuentaContable))
                                    {
                                        <span style="font-family: monospace;">@c.CuentaContable</span>
                                    }
                                    else
                                    {
                                        <span class="table-user-sub">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions">
                                        @if (Model.PuedeEditar)
                                        {
                                            <a asp-page="/Finanzas/Categorias/Edit" asp-route-id="@c.Id" class="btn-icon-action" title="Editar">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                </svg>
                                            </a>
                                        }
                                        @if (Model.PuedeEliminar && !c.EsSistema)
                                        {
                                            <a asp-page="/Finanzas/Categorias/Delete" asp-route-id="@c.Id" class="btn-icon-action btn-icon-action-danger" title="Eliminar">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="3 6 5 6 21 6"/>
                                                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                                </svg>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- CATEGORÍAS DE EGRESO -->
    <div class="module-card" style="padding: 20px;">
        <h3 class="panel-title" style="margin-bottom: 16px; color: var(--color-danger);">💸 Categorías de Egreso (@egresos.Count)</h3>

        @if (egresos.Count == 0)
        {
            <p style="color: var(--color-muted); text-align: center; padding: 30px;">Sin categorías de egreso</p>
        }
        else
        {
            <div class="table-wrapper">
                <table class="erp-table">
                    <thead>
                        <tr>
                            <th style="width: 40px;"></th>
                            <th>Nombre</th>
                            <th>Cuenta contable</th>
                            <th style="width: 120px; text-align: right;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in egresos)
                        {
                            <tr>
                                <td>
                                    <div style="width: 24px; height: 24px; border-radius: 6px; background: @c.Color;"></div>
                                </td>
                                <td>
                                    <strong>@c.Nombre</strong>
                                    @if (c.EsSistema)
                                    {
                                        <span class="badge badge-info" style="font-size: 10px; margin-left: 4px;">Sistema</span>
                                    }
                                    @if (!string.IsNullOrEmpty(c.Descripcion))
                                    {
                                        <br /><span class="table-user-sub">@c.Descripcion</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(c.CuentaContable))
                                    {
                                        <span style="font-family: monospace;">@c.CuentaContable</span>
                                    }
                                    else
                                    {
                                        <span class="table-user-sub">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions">
                                        @if (Model.PuedeEditar)
                                        {
                                            <a asp-page="/Finanzas/Categorias/Edit" asp-route-id="@c.Id" class="btn-icon-action" title="Editar">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                </svg>
                                            </a>
                                        }
                                        @if (Model.PuedeEliminar && !c.EsSistema)
                                        {
                                            <a asp-page="/Finanzas/Categorias/Delete" asp-route-id="@c.Id" class="btn-icon-action btn-icon-action-danger" title="Eliminar">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="3 6 5 6 21 6"/>
                                                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                                </svg>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>