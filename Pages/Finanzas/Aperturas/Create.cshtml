@page
@model Kirkenta.Pages.Finanzas.Aperturas.CreateModel
@{
    ViewData["Title"] = "Nueva apertura de caja";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/Finanzas/Aperturas/Index" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Volver a aperturas
        </a>
        <h2>Nueva apertura de caja</h2>
        <p>Registra el saldo inicial con el que abre la caja</p>
    </div>
</div>

<div class="module-card form-card">
    <form method="post" class="erp-form">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="module-alert module-alert-error">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <div asp-validation-summary="All"></div>
            </div>
        }

        <div class="module-alert" style="background: #eef2ff; border: 1px solid #c7d2fe; color: var(--color-primary);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="16" x2="12" y2="12"/>
                <line x1="12" y1="8" x2="12.01" y2="8"/>
            </svg>
            <div>
                <strong>Apertura obligatoria</strong>
                <p style="margin: 4px 0 0 0; font-size: 12.5px;">Para poder hacer ventas en el POS, primero debes abrir la caja con un saldo inicial. Al cerrar el día, el sistema calculará el efectivo esperado basándose en este saldo.</p>
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.CuentaId">Cuenta a abrir *</label>
            <select asp-for="Input.CuentaId" class="form-input" required>
                <option value="">— Selecciona una cuenta —</option>
                @foreach (var c in Model.Cuentas)
                {
                    <option value="@c.Id">@c.Nombre — Saldo actual: L. @c.SaldoActual.ToString("N2")</option>
                }
            </select>
            <small class="form-help">Solo se muestran cajas activas sin apertura en curso</small>
        </div>

        <div class="form-field">
            <label asp-for="Input.SaldoInicial">Saldo inicial (efectivo) *</label>
            <input asp-for="Input.SaldoInicial" type="number" step="0.01" min="0" class="form-input" placeholder="Ej: 2000.00" required />
            <small class="form-help">Es el efectivo físico que tienes en la caja para dar cambio</small>
        </div>

        <div class="form-field">
            <label asp-for="Input.Notas">Notas / Observaciones</label>
            <textarea asp-for="Input.Notas" class="form-input" rows="2" placeholder="Ej: Se inicia caja con L. 2,000 para cambio"></textarea>
        </div>

        <div class="form-actions">
            <a asp-page="/Finanzas/Aperturas/Index" class="btn-secondary">Cancelar</a>
            <button type="submit" class="btn-primary" style="background: var(--color-success);">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                Abrir caja
            </button>
        </div>
    </form>
</div>