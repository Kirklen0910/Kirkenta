@page
@model Kirkenta.Pages.Finanzas.Aperturas.CreateModel
@{
    ViewData["Title"] = "Nueva apertura de caja";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/Finanzas/Aperturas/Index" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Volver a aperturas
        </a>
        <h2>Nueva apertura de caja</h2>
        <p>Registra el saldo inicial con el que abre la caja</p>
    </div>
</div>

<div class="module-card form-card">
    <form method="post" class="erp-form">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="module-alert module-alert-error">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <div asp-validation-summary="All"></div>
            </div>
        }

        <div class="module-alert" style="background: var(--color-primary-soft); border: 1px solid var(--color-primary-border); color: var(--color-primary);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="16" x2="12" y2="12"/>
                <line x1="12" y1="8" x2="12.01" y2="8"/>
            </svg>
            <div>
                <strong>Apertura obligatoria</strong>
                <p style="margin: 4px 0 0 0; font-size: 12.5px;">Cuenta el efectivo que hay en la caja antes de vender. Lo normal es que sea el fondo que dejó el último cierre: el sistema te lo muestra. Si cuentas otra cantidad, la diferencia queda registrada para que todo cuadre.</p>
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.CuentaId">Cuenta a abrir *</label>
            <select asp-for="Input.CuentaId" class="form-input" required>
                <option value="">— Selecciona una cuenta —</option>
                @foreach (var c in Model.Cuentas)
                {
                    <option value="@c.Id" data-saldo="@c.SaldoActual.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">@c.Nombre — en el sistema: L. @c.SaldoActual.ToString("N2")</option>
                }
            </select>
            <small class="form-help">Solo se muestran cajas activas sin apertura en curso</small>
        </div>

        <div class="form-field">
            <label asp-for="Input.SaldoInicial">Saldo inicial (efectivo) *</label>
            <input asp-for="Input.SaldoInicial" asp-format="{0:0.00}" type="number" step="0.01" min="0" class="form-input" placeholder="Ej: 2000.00" required />
            <small class="form-help">Es el efectivo físico que tienes en la caja para dar cambio</small>
        </div>

        <div id="bloqueDiferencia" class="module-alert module-alert-warning" style="display:none;margin:0 0 14px;flex-direction:column;align-items:stretch">
            <div id="textoDiferencia"></div>
            <div class="form-field" id="campoOrigen" style="margin:8px 0 0">
                <label asp-for="Input.CuentaOrigenFondoId">¿De dónde sale el efectivo de más?</label>
                <select asp-for="Input.CuentaOrigenFondoId" class="form-input" id="origenFondo">
                    <option value="">No lo traje de otra cuenta: es un sobrante del conteo</option>
                    @foreach (var o in Model.CuentasOrigen)
                    {
                        <option value="@o.Id" data-caja="@o.Id">@(o.Tipo == "Banco" ? "🏦" : "💵") @o.Nombre (L. @o.SaldoActual.ToString("N2"))</option>
                    }
                </select>
                <small class="form-help">Si lo sacaste del banco o de otra caja, elígela: se registra como una transferencia y no como ganancia.</small>
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.Notas">Notas / Observaciones</label>
            <textarea asp-for="Input.Notas" class="form-input" rows="2" placeholder="Ej: Se inicia caja con L. 2,000 para cambio"></textarea>
        </div>

        <div class="form-actions">
            <a asp-page="/Finanzas/Aperturas/Index" class="btn-secondary">Cancelar</a>
            <button type="submit" class="btn-primary" style="background: var(--color-success);">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                Abrir caja
            </button>
        </div>
    </form>
</div>

<script>
    (function () {
        var caja = document.getElementById('Input_CuentaId');
        var monto = document.getElementById('Input_SaldoInicial');
        var bloque = document.getElementById('bloqueDiferencia');
        var texto = document.getElementById('textoDiferencia');
        var campoOrigen = document.getElementById('campoOrigen');
        var origen = document.getElementById('origenFondo');
        var tocado = monto.value !== '' && Number(monto.value) !== 0;
        function L(n) { return 'L. ' + Number(n).toLocaleString('es-HN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
        function saldo() { var o = caja.options[caja.selectedIndex]; return o && o.dataset.saldo ? Number(o.dataset.saldo) : null; }
        function revisar() {
            var s = saldo();
            if (s === null || monto.value === '') { bloque.style.display = 'none'; return; }
            var d = Math.round((Number(monto.value) - s) * 100) / 100;
            if (Math.abs(d) < 0.01) { bloque.style.display = 'none'; origen.value = ''; return; }
            bloque.style.display = 'flex';
            texto.innerHTML = '';
            var b = document.createElement('strong');
            b.textContent = d > 0 ? 'Vas a abrir con ' + L(d) + ' más de lo que dice el sistema (' + L(s) + ').'
                                  : 'Vas a abrir con ' + L(-d) + ' menos de lo que dice el sistema (' + L(s) + ').';
            texto.appendChild(b);
            if (d < 0) {
                var p = document.createElement('div'); p.style.fontSize = '12.5px'; p.style.marginTop = '4px';
                p.textContent = 'Se registrará como faltante de caja. Si ese dinero se depositó o se entregó, regístralo antes como transferencia (Finanzas → Movimientos) y no como faltante.';
                texto.appendChild(p);
            }
            campoOrigen.style.display = d > 0 ? '' : 'none';
            if (d <= 0) origen.value = '';
            // no se ofrece como origen la misma caja que se abre
            Array.prototype.forEach.call(origen.options, function (o) { if (o.dataset.caja) o.hidden = o.dataset.caja === caja.value; });
        }
        caja.addEventListener('change', function () {
            var s = saldo();
            if (s !== null && !tocado) monto.value = s.toFixed(2);   // propone el fondo que dejó el último cierre
            revisar();
        });
        monto.addEventListener('input', function () { tocado = true; revisar(); });
        revisar();
    })();
</script>