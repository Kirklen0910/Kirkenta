@page
@model Kirkenta.Pages.Finanzas.Aperturas.IndexModel
@{
    ViewData["Title"] = "Aperturas de caja";
}

<div class="module-header">
    <div class="module-header-left">
        <h2>Aperturas de caja</h2>
        <p>Saldo inicial con el que abre cada caja</p>
    </div>
    <div class="module-header-right">
        @if (Model.PuedeCrear)
        {
            <a asp-page="/Finanzas/Aperturas/Create" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Nueva apertura
            </a>
        }
        <a asp-page="/Finanzas/Index" class="btn-secondary">Volver a Finanzas</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="module-alert module-alert-success">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="module-alert module-alert-error">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        @TempData["Error"]
    </div>
}

<div class="kpi-grid" style="margin-bottom: 20px;">
    <div class="kpi-card">
        <span class="kpi-label">Aperturas activas</span>
        <span class="kpi-value" style="color: var(--color-success);">@Model.AperturasActivas</span>
        <span class="kpi-trend">Cajas abiertas ahora</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Total aperturas</span>
        <span class="kpi-value">@Model.Aperturas.Count</span>
        <span class="kpi-trend">Histórico</span>
    </div>
</div>

<div class="module-card">
    @if (Model.Aperturas.Count == 0)
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2"/>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
            </svg>
            <h3>No hay aperturas registradas</h3>
            <p>Registra la primera apertura de caja para empezar</p>
            <a asp-page="/Finanzas/Aperturas/Create" class="btn-primary">Nueva apertura</a>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="erp-table">
                <thead>
                    <tr>
                        <th>Número</th>
                        <th>Fecha</th>
                        <th>Cuenta</th>
                        <th>Usuario</th>
                        <th style="text-align: right;">Saldo inicial</th>
                        <th>Estado</th>
                        <th>Cierre</th>
                        <th style="width: 80px; text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Aperturas)
                    {
                        <tr>
                            <td><span style="font-family: monospace;">@a.Numero</span></td>
                            <td>@a.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@a.CuentaNombre</td>
                            <td>@a.UsuarioNombre</td>
                            <td style="text-align: right;"><strong>L. @a.SaldoInicial.ToString("N2")</strong></td>
                            <td>
                                @if (a.Activa)
                                {
                                    <span class="badge badge-success">Abierta</span>
                                }
                                else
                                {
                                    <span class="badge" style="background: #e5e7eb; color: #6b7280;">Cerrada</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(a.CierreNumero) && a.CierreId.HasValue)
                                {
                                    <a asp-page="/Finanzas/Cierres/Details" asp-route-id="@a.CierreId" style="font-family: monospace;">@a.CierreNumero</a>
                                }
                                else
                                {
                                    <span class="table-user-sub">—</span>
                                }
                            </td>
                            <td>
                                <div class="table-actions">
                                    @if (Model.PuedeCerrar && a.Activa)
                                    {
                                        <a asp-page="/Finanzas/Cierres/Create" class="btn-icon-action" title="Cerrar caja" style="color: var(--color-success);">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                            </svg>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>