@page
@model Kirkenta.Pages.Finanzas.Cuentas.CreateModel
@{
    ViewData["Title"] = "Nueva cuenta financiera";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/Finanzas/Cuentas/Index" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Volver a cuentas
        </a>
        <h2>Nueva cuenta financiera</h2>
        <p>Registra una caja o cuenta bancaria</p>
    </div>
</div>

<div class="module-card form-card-wide">
    <form method="post" class="erp-form">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="module-alert module-alert-error">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <div asp-validation-summary="All"></div>
            </div>
        }

        <h3 class="form-section-title">Datos básicos</h3>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.Codigo">Código *</label>
                <input asp-for="Input.Codigo" class="form-input" placeholder="Ej: CAJA-01, BAC-001" required />
            </div>
            <div class="form-field">
                <label asp-for="Input.Nombre">Nombre *</label>
                <input asp-for="Input.Nombre" class="form-input" placeholder="Ej: Caja General, BAC Lempiras" required />
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.Tipo">Tipo *</label>
                <select asp-for="Input.Tipo" class="form-input" id="tipoSelect" required>
                    <option value="Caja">Caja</option>
                    <option value="Banco">Cuenta bancaria</option>
                </select>
            </div>
            <div class="form-field" id="subtipoField">
                <label asp-for="Input.Subtipo">Tipo de caja</label>
                <select asp-for="Input.Subtipo" class="form-input">
                    <option value="General">General</option>
                    <option value="Chica">Chica</option>
                    <option value="POS">POS</option>
                </select>
            </div>
        </div>

        <div class="form-row" id="bancoRow" style="display: none;">
            <div class="form-field">
                <label asp-for="Input.Banco">Banco</label>
                <input asp-for="Input.Banco" class="form-input" placeholder="Ej: BAC Credomatic" />
            </div>
            <div class="form-field">
                <label asp-for="Input.NumeroCuenta">Número de cuenta</label>
                <input asp-for="Input.NumeroCuenta" class="form-input" placeholder="Ej: 1234567890" />
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.MonedaId">Moneda *</label>
                <select asp-for="Input.MonedaId" class="form-input" required>
                    @foreach (var m in Model.Monedas)
                    {
                        <option value="@m.Id">@m.Codigo - @m.Nombre</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label asp-for="Input.SaldoInicial">Saldo inicial *</label>
                <input asp-for="Input.SaldoInicial" type="number" step="0.01" class="form-input" value="0" />
                <small class="form-help">El saldo actual arrancará con este valor</small>
            </div>
        </div>

        <div class="form-divider"></div>
        <h3 class="form-section-title">Información adicional (opcional)</h3>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.CuentaContable">Cuenta contable</label>
                <input asp-for="Input.CuentaContable" class="form-input" placeholder="Ej: 1101" />
            </div>
            <div class="form-field">
                <label asp-for="Input.Responsable">Responsable</label>
                <input asp-for="Input.Responsable" class="form-input" placeholder="Ej: María López" />
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.Descripcion">Descripción</label>
            <textarea asp-for="Input.Descripcion" class="form-input" rows="2"></textarea>
        </div>

        <div class="form-field">
            <label class="form-checkbox">
                <input asp-for="Input.Activa" type="checkbox" checked />
                <span>Cuenta activa</span>
            </label>
        </div>

        <div class="form-actions">
            <a asp-page="/Finanzas/Cuentas/Index" class="btn-secondary">Cancelar</a>
            <button type="submit" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                Crear cuenta
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var tipoSelect = document.getElementById('tipoSelect');
            var subtipoField = document.getElementById('subtipoField');
            var bancoRow = document.getElementById('bancoRow');

            function actualizar() {
                var esBanco = tipoSelect.value === 'Banco';
                subtipoField.style.display = esBanco ? 'none' : '';
                bancoRow.style.display = esBanco ? '' : 'none';
            }

            tipoSelect.addEventListener('change', actualizar);
            actualizar();
        })();
    </script>
}