@page
@model Kirkenta.Pages.Finanzas.Cuentas.IndexModel
@{
    ViewData["Title"] = "Cuentas financieras";
}

<div class="module-header">
    <div class="module-header-left">
        <h2>Cuentas financieras</h2>
        <p>Cajas, bancos y cuentas de la empresa</p>
    </div>
    <div class="module-header-right">
        @if (Model.PuedeCrear)
        {
            <a asp-page="/Finanzas/Cuentas/Create" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Nueva cuenta
            </a>
        }
        <a asp-page="/Finanzas/Index" class="btn-secondary">Volver a Finanzas</a>
    </div>
</div>

<div class="kpi-grid" style="margin-bottom: 20px;">
    <div class="kpi-card">
        <span class="kpi-label">En cajas</span>
        <span class="kpi-value">L. @Model.SaldoCajas.ToString("N2")</span>
        <span class="kpi-trend">@Model.Cuentas.Count(c => c.Tipo == "Caja") cajas</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">En bancos</span>
        <span class="kpi-value">L. @Model.SaldoBancos.ToString("N2")</span>
        <span class="kpi-trend">@Model.Cuentas.Count(c => c.Tipo == "Banco") cuentas</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Total</span>
        <span class="kpi-value" style="color: var(--color-primary);">L. @Model.SaldoTotal.ToString("N2")</span>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="module-alert module-alert-success">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="module-alert module-alert-error">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        @TempData["Error"]
    </div>
}

<div class="module-card">
    @if (Model.Cuentas.Count == 0)
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2"/>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
            </svg>
            <h3>No hay cuentas registradas</h3>
            <p>Crea tu primera caja o cuenta bancaria</p>
            <a asp-page="/Finanzas/Cuentas/Create" class="btn-primary">Crear cuenta</a>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="erp-table">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Banco / Nº</th>
                        <th>Responsable</th>
                        <th style="text-align: right;">Saldo</th>
                        <th>Estado</th>
                        <th style="width: 140px; text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Cuentas)
                    {
                        <tr>
                            <td><span style="font-family: monospace;">@c.Codigo</span></td>
                            <td><strong>@c.Nombre</strong></td>
                            <td>
                                @if (c.Tipo == "Banco")
                                {
                                    <span class="badge badge-info">🏦 Banco</span>
                                }
                                else if (c.Subtipo == "Chica")
                                {
                                    <span class="badge badge-warning">Caja chica</span>
                                }
                                else if (c.Subtipo == "POS")
                                {
                                    <span class="badge" style="background: #ec489920; color: #ec4899;">Caja POS</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">Caja</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(c.Banco))
                                {
                                    <span>@c.Banco</span>
                                }
                                @if (!string.IsNullOrEmpty(c.NumeroCuenta))
                                {
                                    <br /><span class="table-user-sub" style="font-family: monospace;">@c.NumeroCuenta</span>
                                }
                            </td>
                            <td>@(c.Responsable ?? "—")</td>
                            <td style="text-align: right;">
                                <strong style="color: @(c.SaldoActual >= 0 ? "var(--color-success)" : "var(--color-danger)");">
                                    L. @c.SaldoActual.ToString("N2")
                                </strong>
                            </td>
                            <td>
                                @if (c.Activa)
                                {
                                    <span class="badge badge-success">Activa</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Inactiva</span>
                                }
                            </td>
                            <td>
                                <div class="table-actions">
                                    @if (Model.PuedeEditar)
                                    {
                                        <a asp-page="/Finanzas/Cuentas/Edit" asp-route-id="@c.Id" class="btn-icon-action" title="Editar">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                            </svg>
                                        </a>
                                    }
                                    @if (Model.PuedeEliminar)
                                    {
                                        <a asp-page="/Finanzas/Cuentas/Delete" asp-route-id="@c.Id" class="btn-icon-action btn-icon-action-danger" title="Eliminar">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"/>
                                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                            </svg>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>