@page "{id:int}"
@model Kirkenta.Pages.Finanzas.PlanCuentas.EditModel
@{
    ViewData["Title"] = "Editar cuenta contable";
}

<div class="module-header">
    <div class="module-header-left">
        <a asp-page="/Finanzas/PlanCuentas/Index" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Volver a Plan de Cuentas
        </a>
        <h2>Editar cuenta: @Model.Input.Codigo</h2>
        <p>Modifica los datos de la cuenta contable</p>
    </div>
</div>

<div class="module-card form-card">
    <form method="post" class="erp-form">
        <input type="hidden" asp-for="Input.Id" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="module-alert module-alert-error">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <div asp-validation-summary="All"></div>
            </div>
        }

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Input.Codigo">Código contable *</label>
                <input asp-for="Input.Codigo" class="form-input" required />
                <small class="form-help">Debe ser único en todo el catálogo.</small>
            </div>
            <div class="form-field">
                <label asp-for="Input.Tipo">Tipo contable *</label>
                <select asp-for="Input.Tipo" class="form-input" required>
                    <option value="Activo">Activo</option>
                    <option value="Pasivo">Pasivo</option>
                    <option value="Patrimonio">Patrimonio</option>
                    <option value="Ingreso">Ingreso</option>
                    <option value="Costo">Costo</option>
                    <option value="Gasto">Gasto</option>
                </select>
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Input.Nombre">Nombre de la cuenta *</label>
            <input asp-for="Input.Nombre" class="form-input" required />
        </div>

        <div class="form-field">
            <label asp-for="Input.CodigoPadre">Cuenta padre</label>
            <select asp-for="Input.CodigoPadre" class="form-input">
                <option value="">— Cuenta de mayor (sin padre) —</option>
                @foreach (var c in Model.CuentasPadre)
                {
                    <option value="@c.Codigo">@c.Codigo - @c.Nombre</option>
                }
            </select>
        </div>

        <div class="form-field">
            <label class="form-checkbox">
                <input asp-for="Input.EsMovimiento" type="checkbox" />
                <span>Permite registrar movimientos directamente (cuenta hoja)</span>
            </label>
        </div>

        <div class="form-field">
            <label asp-for="Input.Descripcion">Descripción</label>
            <textarea asp-for="Input.Descripcion" class="form-input" rows="2"></textarea>
        </div>

        <div class="form-field">
            <label class="form-checkbox">
                <input asp-for="Input.Activa" type="checkbox" />
                <span>Cuenta activa</span>
            </label>
        </div>

        <div class="form-actions">
            <a asp-page="/Finanzas/PlanCuentas/Index" class="btn-secondary">Cancelar</a>
            <button type="submit" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                Guardar cambios
            </button>
        </div>
    </form>
</div>