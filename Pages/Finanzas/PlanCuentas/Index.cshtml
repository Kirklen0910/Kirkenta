@page
@model Kirkenta.Pages.Finanzas.PlanCuentas.IndexModel
@{
    ViewData["Title"] = "Plan de Cuentas";
}

<div class="module-header">
    <div class="module-header-left">
        <h2>Plan de Cuentas</h2>
        <p>Catálogo jerárquico de cuentas contables de la empresa</p>
    </div>
    <div class="module-header-right">
        @if (Model.PuedeCrear)
        {
            <a asp-page="/Finanzas/PlanCuentas/Create" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Nueva cuenta
            </a>
        }
        <a asp-page="/Finanzas/Index" class="btn-secondary">Volver a Finanzas</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="module-alert module-alert-success">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="module-alert module-alert-error">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        @TempData["Error"]
    </div>
}

<div class="kpi-grid" style="margin-bottom: 20px;">
    <div class="kpi-card">
        <span class="kpi-label">Total de cuentas</span>
        <span class="kpi-value">@Model.TotalCuentas</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Activas</span>
        <span class="kpi-value" style="color: var(--color-success);">@Model.TotalActivas</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Cuentas de movimiento</span>
        <span class="kpi-value">@Model.TotalMovimiento</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Cuentas de mayor</span>
        <span class="kpi-value">@Model.TotalSinPadre</span>
    </div>
</div>

<div class="module-card">
    <div class="module-toolbar">
        <div class="search-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" id="searchInput" placeholder="Buscar por código o nombre..." />
        </div>
        <div class="filter-group">
            <select id="filterTipo" class="filter-select">
                <option value="">Todos los tipos</option>
                <option value="Activo">Activo</option>
                <option value="Pasivo">Pasivo</option>
                <option value="Patrimonio">Patrimonio</option>
                <option value="Ingreso">Ingreso</option>
                <option value="Costo">Costo</option>
                <option value="Gasto">Gasto</option>
            </select>
            <select id="filterEstado" class="filter-select">
                <option value="">Todos</option>
                <option value="activo">Activas</option>
                <option value="inactivo">Inactivas</option>
            </select>
        </div>
    </div>

    @if (Model.Cuentas.Count == 0)
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 7V4h16v3M9 20h6M12 4v16"/>
            </svg>
            <h3>No hay cuentas registradas</h3>
            <p>Ejecuta el seeder al arrancar la app o crea una cuenta manualmente</p>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="erp-table" id="cuentasTable">
                <thead>
                    <tr>
                        <th style="width: 150px;">Código</th>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Naturaleza</th>
                        <th>Movimiento</th>
                        <th>Estado</th>
                        <th style="width: 120px; text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Cuentas)
                    {
                        var tipoColor = c.Tipo switch
                        {
                            "Activo" => "#3b82f6",
                            "Pasivo" => "#ef4444",
                            "Patrimonio" => "#8b5cf6",
                            "Ingreso" => "#10b981",
                            "Costo" => "#f97316",
                            "Gasto" => "#dc2626",
                            _ => "#6b7280"
                        };
                        <tr data-codigo="@c.Codigo.ToLower()"
                            data-nombre="@c.Nombre.ToLower()"
                            data-tipo="@c.Tipo"
                            data-estado="@(c.Activa ? "activo" : "inactivo")">
                            <td>
                                <span style="font-family: monospace; font-weight: 600;">@c.Codigo</span>
                            </td>
                            <td style="padding-left: @(20 * (c.Nivel - 1))px;">
                                @if (c.Nivel > 1)
                                {
                                    <span style="color: var(--color-muted);">└ </span>
                                }
                                <strong>@c.Nombre</strong>
                            </td>
                            <td>
                                <span class="badge" style="background: @(tipoColor)20; color: @tipoColor;">
                                    @c.Tipo
                                </span>
                            </td>
                            <td>
                                <span class="table-user-sub">@c.Naturaleza</span>
                            </td>
                            <td>
                                @if (c.EsMovimiento)
                                {
                                    <span class="badge badge-success">Sí</span>
                                }
                                else
                                {
                                    <span class="table-user-sub">—</span>
                                }
                            </td>
                            <td>
                                @if (c.Activa)
                                {
                                    <span class="badge badge-success">Activa</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Inactiva</span>
                                }
                            </td>
                            <td>
                                <div class="table-actions">
                                    @if (Model.PuedeEditar)
                                    {
                                        <a asp-page="/Finanzas/PlanCuentas/Edit" asp-route-id="@c.Id" class="btn-icon-action" title="Editar">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                            </svg>
                                        </a>
                                    }
                                    @if (Model.PuedeEliminar)
                                    {
                                        <a asp-page="/Finanzas/PlanCuentas/Delete" asp-route-id="@c.Id" class="btn-icon-action btn-icon-action-danger" title="Eliminar">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"/>
                                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                            </svg>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var searchInput = document.getElementById('searchInput');
            var filterTipo = document.getElementById('filterTipo');
            var filterEstado = document.getElementById('filterEstado');
            var table = document.getElementById('cuentasTable');
            if (!table) return;
            var rows = table.querySelectorAll('tbody tr');

            function filterRows() {
                var search = (searchInput?.value || '').toLowerCase().trim();
                var tipo = filterTipo?.value || '';
                var estado = filterEstado?.value || '';

                rows.forEach(function (row) {
                    var codigo = row.dataset.codigo || '';
                    var nombre = row.dataset.nombre || '';
                    var rowTipo = row.dataset.tipo || '';
                    var rowEstado = row.dataset.estado || '';

                    var matchSearch = !search || codigo.includes(search) || nombre.includes(search);
                    var matchTipo = !tipo || rowTipo === tipo;
                    var matchEstado = !estado || rowEstado === estado;

                    row.style.display = (matchSearch && matchTipo && matchEstado) ? '' : 'none';
                });
            }

            searchInput?.addEventListener('input', filterRows);
            filterTipo?.addEventListener('change', filterRows);
            filterEstado?.addEventListener('change', filterRows);
        })();
    </script>
}