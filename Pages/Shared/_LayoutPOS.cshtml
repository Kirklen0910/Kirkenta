<!DOCTYPE html>
<html lang="es" data-pref="@Kirkenta.Helpers.TemaHelper.Preferencia(Context)" data-uid="@Kirkenta.Helpers.TemaHelper.Uid(Context)" data-theme="@Kirkenta.Helpers.TemaHelper.Resuelto(Kirkenta.Helpers.TemaHelper.Preferencia(Context))" data-bs-theme="@Kirkenta.Helpers.TemaHelper.Resuelto(Kirkenta.Helpers.TemaHelper.Preferencia(Context))">
<head>
    <meta charset="utf-8" />
    <partial name="_TemaHead" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kirkenta POS</title>
    <link rel="icon" type="image/png" href="~/favicon.png?v=@DateTime.Now.Ticks" />
    <link rel="apple-touch-icon" href="~/favicon.png" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="shortcut icon" type="image/png" href="~/favicon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css?v=@DateTime.Now.Ticks" />
</head>
<body class="pos-body">
    @Html.AntiForgeryToken()
    <div class="pos-container">
        <header class="pos-header">
            <div class="pos-header-left">
                <a asp-page="/Index" class="pos-back-btn" title="Volver al sistema">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"/>
                        <polyline points="12 19 5 12 12 5"/>
                    </svg>
                </a>
                <div class="pos-brand">
                    <img src="~/images/logo.png" alt="Kirkenta" />
                    <div>
                        <h1>Punto de Venta</h1>
                        <p>@DateTime.Now.ToString("dddd, dd MMMM yyyy HH:mm")</p>
                    </div>
                </div>
            </div>
            <div class="pos-header-right">
                <button type="button" class="erp-theme-btn" id="themeToggle" title="Cambiar tema claro / oscuro" aria-label="Cambiar tema claro u oscuro">
                    <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                    <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                </button>
                <div class="pos-user">
                    <span class="pos-user-name">@User.Identity?.Name</span>
                    <span class="pos-user-role">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                </div>
            </div>
        </header>

        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>window.escHtml = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };</script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/kirkenta-offline.js" asp-append-version="true"></script>

    <partial name="_TemaScripts" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>