@model Kirkenta.Helpers.WhatsAppBtn
@if (!string.IsNullOrEmpty(Model.Url))
{
    <a href="@Model.Url" target="_blank" rel="noopener noreferrer" class="@(Model.Compacto ? "btn-icon-action btn-wa-icon" : "btn-secondary btn-whatsapp")" title="@Model.Titulo">
        <svg viewBox="0 0 24 24" fill="currentColor" class="btn-icon" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.1-.2.3-.8.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.4-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.4.1-.6l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5-.1-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-2.9-.4-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z"/></svg>
        @if (!Model.Compacto) { <span>@Model.Texto</span> }
    </a>
}
else
{
    <span class="@(Model.Compacto ? "btn-icon-action btn-wa-icon" : "btn-secondary btn-whatsapp") is-disabled" title="Sin un teléfono válido (usa el formato +504 9999-9999)" aria-disabled="true">
        <svg viewBox="0 0 24 24" fill="currentColor" class="btn-icon" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-2.9-.4-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z"/></svg>
        @if (!Model.Compacto) { <span>@Model.Texto</span> }
    </span>
}
