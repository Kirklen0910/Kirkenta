@model Kirkenta.Helpers.Finanzas.SaldoFavorInforme
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string L(decimal v) => "L. " + v.ToString("N2", inv);
}
@if (Model.Lineas.Count > 0)
{
    @* Solo en la vista "Todo" del informe *@
    <div data-kk-inf-todo>
        <div class="kk-inf-h">
            <h3>Saldo a favor de clientes</h3>
            <span>acreditado @L(Model.Acreditado) · aplicado @L(Model.Aplicado)</span>
        </div>
        <div class="kk-inf-box">
            <p class="kk-inf-nota" style="margin:8px 4px;">Solo referencia: este dinero no entra ni sale de caja y no está sumado arriba. Explica por qué una factura se cobró por menos.</p>
            <table class="kk-inf-table">
                <thead><tr><th>Fecha</th><th>Cliente</th><th>Movimiento</th><th>Venta</th><th>Factura</th><th class="num">Monto</th></tr></thead>
                <tbody>
                @foreach (var l in Model.Lineas.Take(300))
                {
                    <tr>
                        <td>@l.Fecha.ToString("dd/MM HH:mm")</td>
                        <td>@l.Cliente</td>
                        <td>@l.Tipo</td>
                        <td>@if (l.VentaId.HasValue) { <a asp-page="/Ventas/Details" asp-route-id="@l.VentaId">@l.Venta</a> } else { <span>—</span> }</td>
                        <td>@if (l.FacturaId.HasValue) { <a asp-page="/Facturas/Details" asp-route-id="@l.FacturaId">@l.Factura</a> } else { <span>—</span> }</td>
                        <td class="num">@(l.Monto < 0 ? "-" : "")@L(Math.Abs(l.Monto))</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
