    <script src="~/js/escaner-camara.js" asp-append-version="true"></script>
    <script src="~/js/kirkenta-offline.js" asp-append-version="true"></script>
    <script>
        // Menú lateral en celular/tablet: en pantallas angostas el menú vive fuera de la pantalla
        // y no hay mouse para abrirlo con hover, así que se abre con el botón ☰ de la barra superior.
        (function () {
            var menu = document.getElementById('erpSidebar');
            var btn = document.getElementById('erpMenuBtn');
            var fondo = document.getElementById('erpSidebarBackdrop');
            if (!menu || !btn || !fondo) return;
            function abrir(si) {
                menu.classList.toggle('is-open', si);
                fondo.hidden = !si;
                btn.setAttribute('aria-expanded', si ? 'true' : 'false');
                document.documentElement.classList.toggle('erp-menu-abierto', si);
            }
            btn.addEventListener('click', function () { abrir(!menu.classList.contains('is-open')); });
            fondo.addEventListener('click', function () { abrir(false); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && menu.classList.contains('is-open')) abrir(false); });
            // Al elegir una opción (un enlace, no el título de un submenú) se cierra
            menu.addEventListener('click', function (e) { if (e.target.closest('a[href]')) abrir(false); });
            window.addEventListener('pageshow', function () { abrir(false); });
        })();

        // Ctrl+K (o Cmd+K) lleva el cursor a la búsqueda global
        document.addEventListener('keydown', function (e) {
            if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
                var box = document.getElementById('globalSearchInput');
                if (box) { e.preventDefault(); box.focus(); box.select(); }
            }
        });
    </script>

    <script>
        (function () {
            var toggles = document.querySelectorAll('.erp-nav-toggle');
            toggles.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var targetId = btn.getAttribute('data-target');
                    var submenu = document.getElementById(targetId);
                    if (!submenu) return;

                    document.querySelectorAll('.erp-nav-toggle.is-expanded').forEach(function (other) {
                        if (other !== btn) {
                            other.classList.remove('is-expanded');
                            var otherId = other.getAttribute('data-target');
                            var otherSub = document.getElementById(otherId);
                            if (otherSub) otherSub.classList.remove('is-open');
                        }
                    });

                    btn.classList.toggle('is-expanded');
                    submenu.classList.toggle('is-open');
                });
            });
        })();
    </script>

    <script>
        // Tema claro / oscuro (cada usuario guarda el suyo) + avisos de éxito flotantes
        (function () {
            var html = document.documentElement;
            function sistemaOscuro() { return window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches; }
            function aplicar(pref, animar) {
                var oscuro = pref === 'oscuro' || (pref === 'sistema' && sistemaOscuro());
                if (animar) { html.classList.add('theme-anim'); setTimeout(function () { html.classList.remove('theme-anim'); }, 350); }
                html.setAttribute('data-pref', pref);
                html.setAttribute('data-theme', oscuro ? 'dark' : 'light');
                html.setAttribute('data-bs-theme', oscuro ? 'dark' : 'light');
                document.dispatchEvent(new CustomEvent('kk-tema', { detail: { pref: pref, oscuro: oscuro } }));
            }
            window.kkTema = {
                guardar: function (pref) {
                    var uid = html.getAttribute('data-uid') || '0';
                    var ex = '; path=/; max-age=31536000; SameSite=Lax';
                    document.cookie = 'kk_tema_u' + uid + '=' + pref + ex;
                    document.cookie = 'kk_tema_last=' + pref + ex;
                    aplicar(pref, true);
                },
                actual: function () { return html.getAttribute('data-pref') || 'claro'; }
            };
            // Los gráficos (Chart.js) toman sus colores al dibujarse: se recarga la página al cambiar de tema
            document.addEventListener('kk-tema', function () {
                if (window.Chart && Chart.instances && Object.keys(Chart.instances).length) setTimeout(function () { location.reload(); }, 300);
            });
            var btn = document.getElementById('themeToggle');
            if (btn) btn.addEventListener('click', function () {
                var oscuroAhora = html.getAttribute('data-theme') === 'dark';
                window.kkTema.guardar(oscuroAhora ? 'claro' : 'oscuro');
            });
            if (window.matchMedia) {
                var mq = matchMedia('(prefers-color-scheme: dark)');
                var onChange = function () { if (window.kkTema.actual() === 'sistema') aplicar('sistema', true); };
                if (mq.addEventListener) mq.addEventListener('change', onChange);
            }

            // Un mismo aviso no se muestra dos veces (lo pintan el diseño general y la página)
            var vistos = {};
            document.querySelectorAll('.module-alert').forEach(function (a) {
                var t = (a.textContent || '').replace(/\s+/g, ' ').trim();
                if (!t) return;
                var c = (a.className.match(/module-alert-(error|success|warning|info)/) || [''])[0];
                if (vistos[c + '|' + t]) a.remove(); else vistos[c + '|' + t] = true;
            });

            // Los avisos de éxito pasan a una notificación flotante que se quita sola
            var avisos = document.querySelectorAll('.module-alert-success');
            if (avisos.length) {
                var stack = document.createElement('div');
                stack.className = 'toast-stack';
                stack.setAttribute('role', 'status');
                document.body.appendChild(stack);
                avisos.forEach(function (a) {
                    stack.appendChild(a);
                    var quitar = function () { a.classList.add('toast-out'); setTimeout(function () { a.remove(); }, 300); };
                    a.addEventListener('click', quitar);
                    setTimeout(quitar, 6000);
                });
            }
        })();
    </script>

    @if (!esPendiente)
    {
        <partial name="_Asistente" />
        <script src="~/js/enlaces-documentos.js" asp-append-version="true" defer></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>