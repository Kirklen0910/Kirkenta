@page
@model Kirkenta.Pages.Catalogo.IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#4f46e5" />
    <meta name="robots" content="noindex" />
    <title>@(Model.Disponible ? Model.Titulo : Model.Negocio) · Catálogo</title>
    <link rel="icon" href="~/favicon.ico" />
    <style>
        :root { --bg: #f6f7fb; --card: #fff; --tx: #111827; --mut: #6b7280; --bd: #e5e7eb; --pri: #4f46e5; --pri2: #4338ca; --soft: #eef2ff; --ok: #059669; --wa: #16a34a; --err: #b91c1c; }
        @@media (prefers-color-scheme: dark) { :root { --bg: #0e1016; --card: #171a23; --tx: #e8eaf0; --mut: #9aa1b2; --bd: #262b38; --soft: #1f2340; --pri: #7c80f7; --pri2: #6366f1; } }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        body { margin: 0; background: var(--bg); color: var(--tx); font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; padding-bottom: calc(92px + env(safe-area-inset-bottom)); }
        .top { background: linear-gradient(135deg, #4f46e5, #6d28d9); color: #fff; padding: calc(22px + env(safe-area-inset-top)) 16px 60px; }
        .top-in { max-width: 1080px; margin: 0 auto; display: flex; align-items: center; gap: 14px; }
        .top img { width: 54px; height: 54px; border-radius: 14px; background: #fff; object-fit: contain; padding: 4px; }
        .top h1 { margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -.01em; }
        .top p { margin: 4px 0 0; opacity: .9; font-size: 14px; }
        .wrap { max-width: 1080px; margin: 0 auto; padding: 0 14px; }
        .search { margin-top: -30px; position: relative; }
        .search input { width: 100%; border: 1px solid var(--bd); background: var(--card); color: var(--tx); border-radius: 16px; padding: 16px 18px 16px 46px; font-size: 16px; box-shadow: 0 10px 26px rgba(0,0,0,.12); outline: none; }
        .search input:focus { border-color: var(--pri); }
        .search span { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); font-size: 18px; }
        .cats { display: flex; gap: 8px; overflow-x: auto; padding: 16px 2px 6px; scrollbar-width: none; }
        .cats::-webkit-scrollbar { display: none; }
        .cats button { flex: none; border: 1px solid var(--bd); background: var(--card); color: var(--tx); border-radius: 999px; padding: 8px 16px; font-size: 14px; font-weight: 600; cursor: pointer; }
        .cats button.on { background: var(--pri); border-color: var(--pri); color: #fff; }
        .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 12px; }
        @@media (min-width: 640px) { .grid { grid-template-columns: repeat(3, 1fr); } }
        @@media (min-width: 900px) { .grid { grid-template-columns: repeat(4, 1fr); gap: 16px; } }
        .p { background: var(--card); border: 1px solid var(--bd); border-radius: 18px; overflow: hidden; display: flex; flex-direction: column; }
        .p .ph { aspect-ratio: 4/3; background: var(--soft); display: grid; place-items: center; font-size: 34px; font-weight: 800; color: var(--pri); overflow: hidden; }
        .p .ph img { width: 100%; height: 100%; object-fit: cover; }
        .p .bd { padding: 12px; display: flex; flex-direction: column; gap: 4px; flex: 1; }
        .p h3 { margin: 0; font-size: 14.5px; font-weight: 700; line-height: 1.3; }
        .p .ds { font-size: 12px; color: var(--mut); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .p .pr { font-size: 18px; font-weight: 800; margin-top: auto; padding-top: 6px; }
        .p .st { font-size: 11.5px; color: var(--mut); }
        .add { border: 0; background: var(--pri); color: #fff; border-radius: 12px; padding: 10px; font-size: 14px; font-weight: 700; cursor: pointer; margin-top: 8px; }
        .add:active { background: var(--pri2); }
        .qty { display: flex; align-items: center; justify-content: space-between; margin-top: 8px; background: var(--soft); border-radius: 12px; padding: 3px; }
        .qty button { width: 38px; height: 36px; border: 0; background: var(--card); color: var(--pri); font-size: 20px; font-weight: 800; border-radius: 10px; cursor: pointer; }
        .qty b { font-size: 16px; }
        .vacio { text-align: center; color: var(--mut); padding: 60px 16px; }
        .vacio .ic { font-size: 46px; }
        .bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 10px 14px calc(10px + env(safe-area-inset-bottom)); z-index: 30; display: none; }
        .bar.on { display: block; }
        .bar button { width: 100%; max-width: 560px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; border: 0; background: var(--pri); color: #fff; border-radius: 16px; padding: 15px 20px; font-size: 16px; font-weight: 700; cursor: pointer; box-shadow: 0 10px 28px rgba(79,70,229,.45); }
        .bar .n { background: rgba(255,255,255,.22); border-radius: 999px; padding: 2px 10px; margin-right: 8px; font-size: 14px; }
        .ov { position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 40; display: none; align-items: flex-end; justify-content: center; }
        .ov.on { display: flex; }
        .sheet { width: 100%; max-width: 560px; max-height: 92vh; overflow: auto; background: var(--card); border-radius: 22px 22px 0 0; padding: 18px 18px calc(18px + env(safe-area-inset-bottom)); }
        @@media (min-width: 640px) { .ov { align-items: center; } .sheet { border-radius: 22px; } }
        .sheet h2 { margin: 0 0 4px; font-size: 20px; }
        .it { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 12px 0; border-top: 1px solid var(--bd); }
        .it .nm { font-weight: 600; font-size: 14.5px; }
        .it small { color: var(--mut); }
        .it .qty { margin: 0; min-width: 118px; }
        .tot { display: flex; justify-content: space-between; font-size: 20px; font-weight: 800; padding: 14px 0 4px; border-top: 2px solid var(--bd); }
        .f { margin-top: 12px; }
        .f label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 4px; color: var(--mut); }
        .f input, .f textarea { width: 100%; border: 1px solid var(--bd); background: var(--bg); color: var(--tx); border-radius: 12px; padding: 12px 14px; font-size: 16px; font-family: inherit; outline: none; }
        .f input:focus, .f textarea:focus { border-color: var(--pri); }
        .trampa { position: absolute; left: -5000px; height: 0; overflow: hidden; }
        .send { width: 100%; margin-top: 16px; border: 0; background: var(--wa); color: #fff; border-radius: 14px; padding: 15px; font-size: 16px; font-weight: 800; cursor: pointer; }
        .send:disabled { opacity: .6; }
        .seg { background: transparent; border: 0; color: var(--mut); width: 100%; margin-top: 8px; padding: 10px; font-size: 14px; cursor: pointer; }
        .err { color: var(--err); font-size: 14px; font-weight: 600; margin-top: 10px; display: none; }
        .ok { text-align: center; padding: 24px 6px; }
        .ok .ic { font-size: 54px; }
        .ok a { display: inline-block; margin-top: 14px; background: var(--wa); color: #fff; text-decoration: none; border-radius: 14px; padding: 14px 22px; font-weight: 800; }
        .pie { text-align: center; color: var(--mut); font-size: 12px; margin-top: 30px; }
    </style>
</head>
<body>
@if (!Model.Disponible)
{
    <div class="top"><div class="top-in"><div><h1>@Model.Negocio</h1></div></div></div>
    <div class="wrap">
        <div class="vacio" style="margin-top:-20px;background:var(--card);border:1px solid var(--bd);border-radius:18px">
            <div class="ic">🛍️</div>
            <h2>Catálogo no disponible</h2>
            <p>Por ahora este catálogo en línea no está activo. Contacta directamente al negocio.</p>
        </div>
    </div>
}
else
{
    <header class="top">
        <div class="top-in">
            @if (!string.IsNullOrEmpty(Model.Logo)) { <img src="@Model.Logo" alt="" onerror="this.style.display='none'" /> }
            <div>
                <h1>@Model.Titulo</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Mensaje)) { <p>@Model.Mensaje</p> }
            </div>
        </div>
    </header>

    <main class="wrap">
        <div class="search"><span>🔎</span><input type="search" id="q" placeholder="¿Qué estás buscando?" autocomplete="off" /></div>
        <div class="cats" id="cats"></div>
        <div class="grid" id="grid"></div>
        <div class="vacio" id="vacio" style="display:none"><div class="ic">🔍</div><p>No encontramos productos con esa búsqueda.</p></div>
        <div class="pie">Precios con ISV incluido · @Model.Negocio</div>
    </main>

    <div class="bar" id="bar"><button type="button" id="verCarrito"><span><span class="n" id="barN">0</span>Ver mi pedido</span><span id="barT">L. 0.00</span></button></div>

    <div class="ov" id="ov">
        <div class="sheet" id="sheet">
            <div id="paso1">
                <h2>Mi pedido</h2>
                <div id="items"></div>
                <div class="tot"><span>Total</span><span id="tot">L. 0.00</span></div>
                <div class="err" id="errMin"></div>

                <div class="f"><label for="nombre">Tu nombre *</label><input id="nombre" maxlength="120" autocomplete="name" /></div>
                <div class="f"><label for="tel">Tu teléfono *</label><input id="tel" type="tel" maxlength="30" autocomplete="tel" inputmode="tel" /></div>
                <div class="f"><label for="dir">Dirección de entrega (opcional)</label><input id="dir" maxlength="300" autocomplete="street-address" /></div>
                <div class="f"><label for="notas">Notas (opcional)</label><textarea id="notas" rows="2" maxlength="500"></textarea></div>
                <div class="trampa" aria-hidden="true"><label>No llenar<input id="web" tabindex="-1" autocomplete="off" /></label></div>
                @Html.AntiForgeryToken()
                <div class="err" id="err"></div>
                <button type="button" class="send" id="enviar">💬 Enviar pedido por WhatsApp</button>
                <button type="button" class="seg" id="seguir">Seguir comprando</button>
            </div>
            <div id="paso2" style="display:none">
                <div class="ok">
                    <div class="ic">✅</div>
                    <h2>¡Pedido <span id="okNum"></span> enviado!</h2>
                    <p style="color:var(--mut)">Quedó registrado. Si WhatsApp no se abrió solo, toca el botón para enviarlo al negocio.</p>
                    <a id="okWa" href="#" target="_blank" rel="noopener">💬 Abrir WhatsApp</a>
                    <button type="button" class="seg" id="nuevo">Hacer otro pedido</button>
                </div>
            </div>
        </div>
    </div>

    <div id="catData" hidden
         data-productos="@Model.ProductosJson"
         data-categorias="@Model.CategoriasJson"
         data-minimo="@Model.PedidoMinimo.ToString(System.Globalization.CultureInfo.InvariantCulture)"
         data-stock="@(Model.MostrarStock ? "true" : "false")"></div>
    <script src="~/js/catalogo.js" asp-append-version="true"></script>
}
</body>
</html>
