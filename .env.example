# Copia este archivo como ".env" y cambia TODOS los valores. Usa solo letras y números en las claves.
MYSQL_ROOT_PASSWORD=CambiaEstaClaveRoot123
MYSQL_PASSWORD=CambiaEstaClaveApp456

# Administrador inicial (solo se crea si la base está vacía). Si dejas ADMIN_CLAVE vacía, se genera una al azar
# y queda en el volumen de datos, archivo App_Data/primer-acceso.txt
ADMIN_USUARIO=admin
ADMIN_CLAVE=

PUERTO_HTTP=8080
# false si entras por http://, true si usas el perfil https
COOKIE_SOLO_HTTPS=false
# true si usas el perfil https (Caddy delante del sistema); false si entras directo por el puerto 8080
CONFIAR_PROXY=false

# Clave para CIFRAR los respaldos (letras y números, 16 o más). Vacía = respaldos sin cifrar.
# GUARDA ESTA CLAVE FUERA DEL SERVIDOR (papel, gestor de claves): si se pierde, los respaldos no se pueden restaurar.
CLAVE_RESPALDOS=

# Solo para el perfil https: la IP (o nombre) del servidor tal como la usan los otros equipos, ej. 192.168.1.10
HOST_HTTPS=localhost
